---
// Pagina brand: nome, simbolo, logotipo e colori, con asset scaricabili.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Logo from "@/components/assets/Logo.astro";
import LogoFooter from "@/components/assets/LogoFooter.astro";

const colors = [
  { name: "Nero Verbalist", hex: "#161B1D", swatch: "bg-accent-500", light: false },
  { name: "Bianco", hex: "#FFFFFF", swatch: "bg-white border border-base-200", light: true },
  { name: "Mist", hex: "#F1F3F3", swatch: "bg-base-100 border border-base-200", light: true },
  { name: "Grigio testo", hex: "#67787C", swatch: "bg-base-500", light: false },
];
---

<BaseLayout
  seo={{
    title: "Brand: logo, simbolo e colori di Verbalist",
    description:
      "Le linee guida del brand Verbalist: come scrivere il nome, quando usare simbolo e logotipo, i colori ufficiali e gli asset da scaricare.",
  }}
>
  <div class="pt-[72px]">
    <Frame n={1} flush tone="soft" class="pt-12 pb-14 lg:pt-20 lg:pb-20 lg:!px-14">
      <Head
        tag="Brand"
        title="Linee guida del brand"
        level="h1"
        text="Queste linee guida servono a rappresentare Verbalist in modo corretto e coerente, senza bisogno di accordi caso per caso. Se scrivi di noi, parti da qui."
      />
      <div class="flex mt-8">
        <Button isLink size="base" variant="accent" href="/brand/verbalist-brand.zip" download>
          Scarica gli asset (.zip)
        </Button>
      </div>
    </Frame>

    <Frame n={2} class="py-14 lg:py-20 lg:!px-14">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <Head tag="Nome" title="Una sola parola, con la V maiuscola" />
        <div>
          <p class="text-md leading-relaxed text-base-600">
            Verbalist si scrive come una sola parola, con la V maiuscola: mai
            "VerbaList", "verbalist" o "Verba List". I nomi delle funzionalità
            sono nomi propri e mantengono la maiuscola solo sulla prima parola:
            gli agenti di Verbalist, l'Editor, il Brief.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-base-500">
            Verbalist è un marchio registrato di NUR HOLDING S.r.l. (UIBM, reg.
            n. 2024000179085, classe 35).
          </p>
        </div>
      </div>
    </Frame>
    <Frame n={3} class="py-14 lg:py-20 lg:!px-14">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <Head tag="Simbolo" title="La V, nelle proporzioni originali" />
        <div>
          <p class="text-md leading-relaxed text-base-600">
            La V è l'elemento distintivo dell'identità di Verbalist. Usala nelle
            proporzioni originali, senza ruotarla, distorcerla o cambiarne il
            colore: nero su fondi chiari, bianco su fondi scuri.
          </p>
          <div class="grid grid-cols-1 mt-8 gap-3 sm:grid-cols-2">
            <div class="flex items-center justify-center p-10 border rounded-xl border-base-200 bg-base-100">
              <Logo class="h-12 text-accent-500" />
            </div>
            <div class="flex items-center justify-center p-10 rounded-xl bg-accent-500">
              <Logo class="h-12 text-white" />
            </div>
          </div>
          <div class="flex flex-wrap mt-4 gap-2">
            <Button isLink size="sm" variant="muted" href="/brand/verbalist-simbolo.svg" download>Simbolo nero (.svg)</Button>
            <Button isLink size="sm" variant="muted" href="/brand/verbalist-simbolo-bianco.svg" download>Simbolo bianco (.svg)</Button>
          </div>
        </div>
      </div>
    </Frame>
    <Frame n={4} class="py-14 lg:py-20 lg:!px-14">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <Head tag="Logotipo" title="La scelta predefinita, senza effetti" />
        <div>
          <p class="text-md leading-relaxed text-base-600">
            Quando lo spazio lo consente, il logotipo è la scelta predefinita.
            Anche qui valgono proporzioni originali e niente effetti: il logo non
            si ombreggia, non si inclina, non si colora.
          </p>
          <div class="grid grid-cols-1 mt-8 gap-3 sm:grid-cols-2">
            <div class="flex items-center justify-center p-10 border rounded-xl border-base-200 bg-base-100">
              <LogoFooter class="h-8 text-accent-500" />
            </div>
            <div class="flex items-center justify-center p-10 rounded-xl bg-accent-500">
              <LogoFooter class="h-8 text-white" />
            </div>
          </div>
          <div class="flex flex-wrap mt-4 gap-2">
            <Button isLink size="sm" variant="muted" href="/brand/verbalist-logo.svg" download>Logotipo nero (.svg)</Button>
            <Button isLink size="sm" variant="muted" href="/brand/verbalist-logo-bianco.svg" download>Logotipo bianco (.svg)</Button>
          </div>
        </div>
      </div>
    </Frame>
    <Frame n={5} class="py-14 lg:py-20 lg:!px-14">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <Head tag="Colori" title="Bianco e nero, con grigi freddi" />
        <div>
          <p class="text-md leading-relaxed text-base-600">
            L'identità visiva di Verbalist è in bianco e nero, con una scala di
            grigi freddi. Niente colori accesi: la sobrietà è parte del brand.
          </p>
          <div class="grid grid-cols-2 mt-8 gap-3 md:grid-cols-4">
            {
              colors.map((c) => (
                <div class="flex flex-col">
                  <div class={`h-20 rounded-xl ${c.swatch}`} />
                  <p class="mt-3 text-sm text-base-900">{c.name}</p>
                  <button
                    type="button"
                    data-hex={c.hex}
                    class="flex items-center font-mono text-xs tracking-wider cursor-pointer min-h-8 w-fit text-base-500 hover:text-base-900 copy-hex"
                    title={`Copia ${c.hex}`}
                  >
                    {c.hex}
                  </button>
                </div>
              ))
            }
          </div>
          <p class="mt-10 text-sm text-base-500">
            Domande sull'uso del brand o serve un formato che non trovi qui?
            <a href="/contatti/" class="border-b border-dashed text-base-900 border-base-400 hover:border-base-900">Scrivici.</a>
          </p>
        </div>
      </div>
    </Frame>
  </div>
</BaseLayout>

<script type="module">
  document.querySelectorAll(".copy-hex").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.hex);
        const prev = btn.textContent;
        btn.textContent = "Copiato";
        setTimeout(() => (btn.textContent = prev), 1200);
      } catch {}
    });
  });
</script>
