---
// Changelog a scroll, sul pattern Starlog: tutte le release in una pagina,
// versione e data sticky a sinistra, contenuto completo a destra.
import { getCollection, render } from "astro:content";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const releases = (await getCollection("changelog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// "verbalist-2-0-1" -> "2.0.1"
const versionOf = (id: string) =>
  id.replace(/^verbalist-/, "").replaceAll("-", ".");

const dateOf = (d: Date) =>
  d.toLocaleDateString("it-IT", {
    year: "numeric",
    month: "long",
    day: "2-digit",
  });
---

<BaseLayout
  seo={{
    title: "Changelog: cosa c'è di nuovo in Verbalist",
    description:
      "Segui i rilasci di Verbalist: nuove funzioni, migliorie e correzioni, release dopo release.",
  }}
>
  <section>
    <Wrapper variant="standard" class="pt-32 pb-4">
      <div class="max-w-xl text-balance mx-auto text-center">
        <Text
          tag="h1"
          variant="displayMD"
          class="font-serif font-medium tracking-tight text-base-950"
        >
          Cosa c'è di nuovo
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="max-w-xl mx-auto mt-4 text-base-500"
        >
          Release dopo release: nuove funzioni, migliorie e correzioni di
          Verbalist.
        </Text>
      </div>

      <ol class="flex flex-col mt-12">
        {
          releases.map(async (release) => {
            const { Content } = await render(release);
            return (
              <li
                class="flex flex-col py-12 gap-4 border-t border-base-200 md:flex-row md:gap-10"
                id={release.id}
              >
                <div class="md:w-40 shrink-0">
                  <div class="flex items-baseline gap-3 md:sticky md:top-24 md:block">
                    <a
                      href={`/changelog/${release.id}/`}
                      class="inline-block px-3 py-1 font-mono text-xs font-medium text-white rounded-full bg-accent-500 hover:bg-accent-600"
                    >
                      v{versionOf(release.id)}
                    </a>
                    <time
                      datetime={release.data.pubDate.toISOString()}
                      class="block text-xs tracking-wide uppercase text-base-500 md:mt-3"
                    >
                      {dateOf(release.data.pubDate)}
                    </time>
                  </div>
                </div>
                <div class="w-full max-w-2xl min-w-0">
                  <Text
                    tag="h2"
                    variant="displaySM"
                    class="font-serif font-medium tracking-tight text-base-900"
                  >
                    <a
                      href={`/changelog/${release.id}/`}
                      class="duration-300 transition-colors hover:text-base-500"
                    >
                      {release.data.page}
                    </a>
                  </Text>
                  {/* Novità/Modifiche come etichette small-caps (stile eyebrow
                      del pricing): non devono competere col titolo della release */}
                  <Wrapper
                    variant="prose"
                    class="mt-6 [&_h2]:font-sans [&_h2]:text-xs [&_h2]:font-medium [&_h2]:uppercase [&_h2]:tracking-wider [&_h2]:text-base-500 [&_h2]:mt-10 [&_h2]:mb-3"
                  >
                    <Content />
                  </Wrapper>
                </div>
              </li>
            );
          })
        }
      </ol>
    </Wrapper>
  </section>
</BaseLayout>
