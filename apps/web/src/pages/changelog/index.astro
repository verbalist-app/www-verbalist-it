---
// Changelog a scroll, sul pattern Starlog: tutte le release in una pagina,
// versione e data sticky a sinistra, contenuto completo a destra.
import { getCollection, render } from "astro:content";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const releases = (await getCollection("changelog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// "verbalist-2-0-1" -> "2.0.1"
const versionOf = (id: string) =>
  id.replace(/^verbalist-/, "").replaceAll("-", ".");

const dateOf = (d: Date) =>
  d.toLocaleDateString("it-IT", {
    year: "numeric",
    month: "long",
    day: "2-digit",
  });
---

<BaseLayout
  seo={{
    title: "Changelog: cosa c'è di nuovo in Verbalist",
    description:
      "Segui i rilasci di Verbalist: nuove funzioni, migliorie e correzioni, release dopo release.",
  }}
>
  <div class="pt-[72px]">
    <Frame n={1} flush tone="soft" class="pt-12 pb-14 lg:pt-20 lg:pb-16 lg:!px-14">
      <Head
        tag="Changelog"
        title="Cosa c'è di nuovo"
        level="h1"
        text="Release dopo release: nuove funzioni, migliorie e correzioni di Verbalist."
      />
    </Frame>
    <Frame n={2} class="pb-8 lg:!px-14">
      <ol class="flex flex-col">
        {
          releases.map(async (release) => {
            const { Content } = await render(release);
            return (
              <li
                class="flex flex-col py-12 gap-4 border-b border-dashed border-base-200 last:border-b-0 md:flex-row md:gap-10"
                id={release.id}
              >
                <div class="md:w-40 shrink-0">
                  <div class="flex items-baseline gap-3 md:sticky md:top-24 md:block">
                    <a
                      href={`/changelog/${release.id}/`}
                      class="inline-flex items-center min-h-8 px-2 font-mono text-xs tracking-wider text-white uppercase bg-accent-600 hover:bg-accent-700"
                    >
                      v{versionOf(release.id)}
                    </a>
                    <time
                      datetime={release.data.pubDate.toISOString()}
                      class="block font-mono text-xs tracking-wider uppercase text-base-500 md:mt-3"
                    >
                      {dateOf(release.data.pubDate)}
                    </time>
                  </div>
                </div>
                <div class="w-full max-w-2xl min-w-0">
                  <h2 class="text-2xl font-normal tracking-tight text-base-900 lg:text-headline">
                    <a href={`/changelog/${release.id}/`} class="duration-300 transition-colors hover:text-accent-600">
                      {release.data.page}
                    </a>
                  </h2>
                  <Wrapper variant="prose" class="mt-4 [&_h2]:font-mono [&_h2]:text-xs [&_h2]:font-normal [&_h2]:uppercase [&_h2]:tracking-wider [&_h2]:text-accent-600 [&_h2]:mt-8 [&_h2]:mb-3">
                    <Content />
                  </Wrapper>
                </div>
              </li>
            );
          })
        }
      </ol>
    </Frame>
  </div>
</BaseLayout>
