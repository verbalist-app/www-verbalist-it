---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import User from "@/components/fundations/icons/User.astro";
// Components
import CustomerCard4 from "@/components/customers/CustomerCard4.astro";
// Data
import { getAllCustomers } from "@/lib/data";
const allCustomers = await getAllCustomers();
---

<BaseLayout
  seo={{
    title: "Clienti e testimonianze",
    description:
      "Guarda come aziende come la tua usano Verbalist per i contenuti: i casi di manifattura, e-commerce e servizi, con i risultati.",
  }}
>
  <section>
    <Wrapper variant="standard" class="pt-32 pb-4">
      <div class="max-w-xl text-balance">
        <Text
          tag="h1"
          variant="displayMD"
          class="font-serif font-medium tracking-tight text-black"
        >
          Casi di successo
        </Text>
        <Text tag="p" variant="textBase" class="mt-4 text-base-500">
          Come le aziende usano Verbalist per i loro contenuti SEO e GEO, dai
          dati della SERP fino al CMS.
        </Text>
      </div>
    </Wrapper>
  </section>
  <section>
    <Wrapper variant="standard" class="py-4 border-t">
      <div class="flex flex-col gap-4">
        {allCustomers.map((post, i) => <CustomerCard4 post={post} index={i} />)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
