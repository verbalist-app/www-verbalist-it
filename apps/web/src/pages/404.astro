---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout seo={{ title: "Pagina non trovata", noindex: true }}>
  <section>
    <Wrapper
      variant="standard"
      class="flex flex-col items-center justify-center pt-32 pb-4 lg:h-svh bg-mist-50"
    >
      <div class="text-center text-balance">
        <Text
          tag="h1"
          variant="displayMD"
          class="font-serif font-medium tracking-tight text-black"
        >
          Questa pagina si è persa.
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="max-w-xl mx-auto mt-4 text-base-500"
        >
          Quello che cercavi non è qui: forse l'indirizzo è cambiato, o forse
          non è mai esistito. Riparti dalla home, o scrivici.
        </Text>
      </div>
      <div
        class="flex flex-wrap items-center justify-center w-full mt-10 gap-2"
      >
        <Button isLink size="sm" variant="accent" href="/"
          >Torna alla home</Button
        >
        <Button isLink size="sm" variant="muted" href="/contatti/"
          >Scrivici</Button
        >
      </div>
    </Wrapper>
  </section>
</BaseLayout>
