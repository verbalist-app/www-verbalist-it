---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import HelpCenterCard from "@/components/helpcenter/HelpCenterCard.astro";
// Sections
import Faq1 from "@/components/faqs/Faq1.astro";
// Data
import { getAllHelpcenter } from "@/lib/data";
const allEntries = await getAllHelpcenter();
---

<BaseLayout
  seo={{
    title: "Help center: impara a usare Verbalist",
    description:
      "Crea il primo documento, carica il contesto del brand, scegli i competitor, genera le immagini: tutte le guide, passo per passo.",
  }}
>
  <section>
    <Wrapper variant="standard" class="pt-32 pb-4">
      <div class="max-w-xl mx-auto text-center text-balance">
        <Text
          tag="h1"
          variant="displayMD"
          class="font-serif font-medium tracking-tight text-base-950"
        >
          Come possiamo aiutarti?
        </Text>
        <Text tag="p" variant="textBase" class="mt-4 text-base-500">
          Guide brevi su documenti, generazione e immagini: le risposte alle
          domande che riceviamo più spesso.
        </Text>
      </div>

      <div
        class="items-center mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2"
      >
        {allEntries.map((post) => <HelpCenterCard post={post} />)}
      </div>
    </Wrapper>
  </section>
  <Faq1 />
</BaseLayout>
