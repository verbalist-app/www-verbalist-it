---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
// Components
import HelpCenterCard from "@/components/helpcenter/HelpCenterCard.astro";
// Sections
import Faq1 from "@/components/faqs/Faq1.astro";
// Data
import { getAllHelpcenter } from "@/lib/data";
const allEntries = await getAllHelpcenter();
---

<BaseLayout
  seo={{
    title: "Help center: impara a usare Verbalist",
    description:
      "Crea il primo documento, carica il contesto del brand, scegli i competitor, genera le immagini: tutte le guide, passo per passo.",
  }}
>
  <div class="pt-[72px]">
    <Frame n={1} flush tone="soft" class="pt-12 pb-14 lg:pt-20 lg:pb-16 lg:!px-14">
      <Head
        tag="Help center"
        title="Come possiamo aiutarti?"
        level="h1"
        text="Guide brevi su documenti, generazione e immagini: le risposte alle domande che riceviamo più spesso."
      />
    </Frame>
    <Frame n={2} class="!px-0">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 md:[&>*:nth-child(2n+1)]:border-r md:[&>*]:border-dashed lg:[&>*:nth-child(2n+1)]:border-r-0 lg:[&>*:not(:nth-child(4n))]:border-r">
        {allEntries.map((post) => <HelpCenterCard post={post} />)}
        {/* Ottava cella: chiude la griglia 4×2 e apre la strada a chi non trova la risposta */}
        <article class="relative flex flex-col px-4 py-8 border-b border-dashed group border-base-200 bg-base-50 lg:px-8 lg:py-10">
          <span class="font-mono text-xs tracking-wider uppercase text-accent-600">Non trovi la risposta?</span>
          <h2 class="mt-8 text-lg font-normal leading-snug tracking-tight text-base-900">
            <a href="/contatti/" class="after:absolute after:inset-0 group-hover:text-accent-600">Scrivi al team</a>
          </h2>
          <p class="mt-2 text-md leading-relaxed text-base-600">Ti rispondiamo dal team che costruisce Verbalist.</p>
        </article>
      </div>
    </Frame>
  <Faq1 />
  </div>
</BaseLayout>
