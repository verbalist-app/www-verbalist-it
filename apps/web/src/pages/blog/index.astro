---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
// Component
import BlogCard from "@/components/blog/BlogCard.astro";
import BlogSearch from "@/components/blog/BlogSearch.astro";
// Sections
// Data
import { getAllPosts, getAllPostTags, slugifyTag } from "@/lib/data";
const allPosts = await getAllPosts();
const tags = await getAllPostTags();
---

<BaseLayout
  seo={{
    title: "Blog: novità e strategie su SEO, GEO e AI search",
    description:
      "Resta aggiornato su come cambiano Google e i motori AI: guide, analisi e strategie per farti trovare su Google e citare da ChatGPT e Perplexity.",
  }}
>
  <div class="pt-[72px]">
    <Frame n={1} flush tone="soft" class="pt-12 pb-10 lg:pt-20 lg:pb-14 lg:!px-14">
      <Head
        tag="Blog"
        title="Guide e approfondimenti su SEO e GEO"
        level="h1"
        text="Strategie pratiche per contenuti che si fanno trovare su Google e nelle risposte delle AI."
      />
      <div class="flex flex-wrap items-center mt-10 gap-2">
        <BlogSearch />
        <div class="flex items-center overflow-x-auto gap-2 scrollbar-hide">
          {
            tags.map((tag) => (
              <a
                href={`/categorie/${slugifyTag(tag)}/`}
                title={tag}
                data-gtm="blog-filter"
                class="flex items-center h-11 lg:h-9 px-4 text-sm capitalize bg-white border rounded-full shrink-0 border-base-200 text-base-700 hover:border-base-300 hover:text-accent-600"
              >
                {tag}
              </a>
            ))
          }
        </div>
      </div>
    </Frame>
    <Frame n={2} class="!px-0">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 md:[&>*:nth-child(2n+1)]:border-r md:[&>*]:border-dashed lg:[&>*:nth-child(2n+1)]:border-r-0 lg:[&>*:not(:nth-child(3n))]:border-r">
        {allPosts.map((post, i) => <BlogCard post={post} headingTag="h2" eager={i < 3} />)}
      </div>
    </Frame>
  </div>
</BaseLayout>
