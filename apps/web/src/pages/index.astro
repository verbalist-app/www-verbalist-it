---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
// Sections della home (grammatica "foglio tecnico": cornice, etichette mono,
// un solo accento). Brief di contenuto in .redesign/home-brief.md.
import Hero from "@/components/home/Hero.astro";
import Doors from "@/components/home/Doors.astro";
import Chain from "@/components/home/Chain.astro";
import Beyond from "@/components/home/Beyond.astro";
import Prints from "@/components/home/Prints.astro";
import Anatomy from "@/components/home/Anatomy.astro";
import Proofs from "@/components/home/Proofs.astro";
import Plans from "@/components/home/Plans.astro";
import Questions from "@/components/home/Questions.astro";
import Close from "@/components/home/Close.astro";

const appLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Verbalist",
  url: "https://www.verbalist.it",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  inLanguage: "it",
  description:
    "Verbalist legge i primi risultati di Google per una keyword e scrive contenuti ottimizzati SEO e GEO, pronti per il CMS: analisi competitor, scrittura nella lingua del mercato, export con metadati.",
  offers: [
    {
      "@type": "Offer",
      name: "Starter",
      price: "270",
      priceCurrency: "EUR",
      description: "30 contenuti, validi 12 mesi dall'acquisto",
    },
    {
      "@type": "Offer",
      name: "Pro",
      price: "500",
      priceCurrency: "EUR",
      description: "70 contenuti, validi 12 mesi dall'acquisto",
    },
  ],
  // A chi si rivolge: una voce per ogni pagina /soluzioni/.
  audience: [
    "Agenzie di digital marketing, web agency e consulenti SEO",
    "Grandi aziende e gruppi con più mercati o linee di prodotto",
    "Piccole e medie imprese",
    "E-commerce con catalogo ampio",
    "Aziende B2B e manifatturiere",
  ].map((audienceType) => ({ "@type": "BusinessAudience", audienceType })),
  publisher: { "@id": "https://www.verbalist.it/#organization" },
};
---

<BaseLayout
  seo={{
    title: "Contenuti SEO e GEO per agenzie e aziende",
    description:
      "Verbalist legge i primi risultati di Google per la tua keyword e scrive contenuti SEO e GEO nella lingua del mercato, pronti da esportare nel CMS.",
  }}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(appLd)}
  />
  <div class="pt-[72px]">
    <Hero />
    <Doors />
    <Chain />
    <Beyond />
    <Prints />
    <Anatomy />
    <Proofs />
    <Plans />
    <Questions />
    <Close />
  </div>
</BaseLayout>
