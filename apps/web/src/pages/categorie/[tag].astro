---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
// Components
import BlogCard from "@/components/blog/BlogCard.astro";
// Data
import { getAllPostTags, getPostsByTag, slugifyTag } from "@/lib/data";

export async function getStaticPaths() {
  const uniqueTags = await getAllPostTags();
  const paths = await Promise.all(
    uniqueTags.map(async (tag) => {
      const filteredPosts = await getPostsByTag(tag);
      return {
        params: { tag: slugifyTag(tag) },
        props: { posts: filteredPosts, label: tag },
      };
    })
  );
  return paths;
}
const { posts, label } = Astro.props;
// Cosa trova nella categoria chi arriva da una ricerca
const descriptions: Record<string, string> = {
  "AI & Automation":
    "Come funzionano AI Overview, AI Mode, ChatGPT e Perplexity, da dove prendono le fonti e cosa serve per farsi citare: GEO, AEO e agenti AI per la SEO.",
  Guide:
    "Guide pratiche per chi produce contenuti: piano editoriale dalla SERP, SEO copywriting, content refresh, schede prodotto e traffico AI in GA4.",
  SEO: "La SEO nell'era delle risposte AI: le differenze tra GEO e SEO, i dati strutturati che contano, l'E-E-A-T per i motori generativi e il file llms.txt.",
};
---

<BaseLayout
  seo={{
    title: `${label}: articoli e guide del blog`,
    description: descriptions[label] ?? `Tutti gli articoli del blog Verbalist sul tema ${label}.`,
  }}
>
  <div class="pt-[72px]">
    <Frame n={1} flush tone="soft" class="pt-12 pb-14 lg:pt-20 lg:pb-16 lg:!px-14">
      <Head tag="Blog" title={`Articoli su ${label}`} level="h1" />
      <p class="mt-8"><a href="/categorie/" class="text-sm text-base-900 border-b border-dashed border-base-400 hover:text-accent-600 hover:border-accent-500">Tutti gli argomenti</a></p>
    </Frame>
    <Frame n={2} class="!px-0">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 md:[&>*:nth-child(2n+1)]:border-r md:[&>*]:border-dashed lg:[&>*:nth-child(2n+1)]:border-r-0 lg:[&>*:not(:nth-child(3n))]:border-r">
        {posts.map((post) => <BlogCard post={post} headingTag="h2" />)}
      </div>
    </Frame>
  </div>
</BaseLayout>
