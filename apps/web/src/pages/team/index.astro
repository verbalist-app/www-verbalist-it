---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import TeamCard from "@/components/team/TeamCard.astro";
// Data
import { getAllTeamMembers } from "@/lib/data";
const allAuthors = await getAllTeamMembers();
---

<BaseLayout
  seo={{
    title: "Il team di Verbalist: SEO, GEO e prodotto",
    description: "Le persone che costruiscono Verbalist, dal prodotto al codice.",
  }}
>
  <section class="flex flex-col grow">
    <Wrapper variant="standard" class="pt-32 pb-12 grow">
      <div class="max-w-xl mx-auto text-center text-balance">
        <Text
          tag="h1"
          variant="displayMD"
          class="font-serif font-medium tracking-tight text-black"
        >
          Le persone dietro Verbalist
        </Text>
        <Text tag="p" variant="textBase" class="mt-4 text-base-500">
          Un piccolo team che costruisce Verbalist, dal prodotto al codice.
        </Text>
      </div>

      <div
        class="max-w-3xl mx-auto mt-16 grid grid-cols-2 gap-x-8 gap-y-12 lg:grid-cols-4"
      >
        {
          // Sorting authors alphabetically inline
          allAuthors
            .sort((a, b) => {
              const nameA = a.data.name.toLowerCase();
              const nameB = b.data.name.toLowerCase();
              return nameA < nameB ? -1 : nameA > nameB ? 1 : 0;
            })
            .map((post) => <TeamCard post={post} />)
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
