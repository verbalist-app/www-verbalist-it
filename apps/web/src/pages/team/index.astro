---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
// Components
import TeamCard from "@/components/team/TeamCard.astro";
// Data
import { getAllTeamMembers } from "@/lib/data";
const allAuthors = await getAllTeamMembers();
---

<BaseLayout
  seo={{
    title: "Il team di Verbalist: SEO, GEO e prodotto",
    description:
      "Chi costruisce Verbalist: il fondatore Rinaldo Zambello, il product owner Filippo Danesi e il team di sviluppo. Ruoli, biografie e profili di ciascuno.",
  }}
>
  <div class="pt-[72px]">
    <Frame n={1} flush tone="soft" class="pt-12 pb-14 lg:pt-20 lg:pb-16 lg:!px-14">
      <Head tag="Team" title="Le persone dietro Verbalist" level="h1" text="Un piccolo team che costruisce Verbalist, dal prodotto al codice." />
    </Frame>
    <Frame n={2} class="!px-0">
      <div class="grid grid-cols-2 lg:grid-cols-4 [&>*:nth-child(odd)]:border-r [&>*]:border-dashed lg:[&>*:nth-child(odd)]:border-r-0 lg:[&>*:not(:nth-child(4n))]:border-r">
        {
          allAuthors
            .sort((a, b) => a.data.name.toLowerCase().localeCompare(b.data.name.toLowerCase()))
            .map((post) => <TeamCard post={post} />)
        }
      </div>
    </Frame>
  </div>
</BaseLayout>
