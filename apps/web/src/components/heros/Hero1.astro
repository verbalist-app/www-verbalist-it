---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { HeroAppMockup } from "@/components/react/HeroMockup";
---

<section>
  <Wrapper variant="standard" class="pt-32 pb-4">
    <div class="text-center text-balance">
      <Text
        tag="h1"
        variant="displayMD"
        class="font-serif font-medium tracking-tight text-black lg:!text-[2.5rem] lg:!leading-[1.2]"
      >
        Crea contenuti per Google e per le AI partendo dai risultati di ricerca      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="max-w-xl mx-auto mt-4 text-base-500"
      >
        Verbalist legge i primi risultati di Google per la tua keyword, estrae ciò che funziona e scrive contenuti ottimizzati per SEO e GEO.
      </Text>
    </div>
    <div
      class="flex flex-wrap items-center justify-center w-full mt-10 just gap-2"
    >
      <Button
        isLink
        size="sm"
        variant="accent"
        href="https://app.verbalist.it/login?registration&code=PROVAGRATUITA26"
      >
        Prova gratis
      </Button>
      <Button isLink size="sm" variant="muted" href="/#funzionalita"
        >Come funziona</Button
      >
    </div>
    <div class="mt-8 min-h-[26rem] md:min-h-[36rem] lg:min-h-[42rem]">
      <HeroAppMockup client:only="react" />
    </div>
  </Wrapper>
</section>
