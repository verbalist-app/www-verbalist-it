---
// 01 · Keyword e contesto — brief: keyword/mercato/lingua/tono + PDF di contesto.
// Grande, esce dal bordo in basso (stile Feature4). side = lato illustrazione.
const { side = "right", variant = "panel" } = Astro.props;
const isCard = variant === "card";
const pad = side === "right" ? "pr-0" : "pl-0";
const bleed = side === "right" ? "-mr-1 rounded-tl-xl" : "-ml-1 rounded-tr-xl";
const panelClass = isCard
  ? "contents"
  : `relative p-8 pb-0 ${pad} h-full overflow-hidden bg-mist-100 bg-[url(/img/agent-brief.webp)] bg-cover bg-center rounded-xl group`;
const cardClass = isCard
  ? "w-full max-w-md p-5 mx-auto bg-white rounded-xl shadow-sm outline outline-mist-500/10"
  : `relative z-10 max-w-md p-5 mx-auto -mb-1 ${bleed} bg-white shadow-sm outline outline-mist-500/10`;

const fields = [
  { label: "Keyword", value: "scarpe running 2026" },
  { label: "Mercato", value: "Italia · IT" },
  { label: "Lingua", value: "Italiano" },
  { label: "Tipo", value: "Blog/Articolo" },
];
---

<div aria-hidden="true" class={panelClass}>
  {!isCard && <div class="absolute inset-0 bg-mist-100/25"></div>}
  <div class={cardClass}>
    <div class="flex items-center gap-3 pb-4 border-b border-mist-500/10">
      <div
        class="inline-flex p-2.5 rounded-lg bg-mist-100 duration-300 group-hover:-rotate-12 group-hover:-translate-y-1"
      >
        <svg
          class="size-5 text-base-900"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </div>
      <p class="text-sm font-medium text-base-900">Brief</p>
    </div>

    <dl class="grid grid-cols-2 pt-4 gap-y-5 gap-x-4">
      {
        fields.map((f) => (
          <div>
            <dt class="text-xs text-base-500">{f.label}</dt>
            <dd class="mt-1 text-sm font-medium text-base-900">{f.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="pt-4 mt-4 border-t border-mist-500/10">
      <div
        class="flex items-center gap-2 px-3 py-2 border border-dashed rounded-lg border-mist-500/30 bg-mist-50"
      >
        <svg
          class="size-4 shrink-0 text-base-500"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
          ></path>
          <path d="M14 2v6h6"></path>
        </svg>
        <span class="text-xs font-medium truncate text-base-900"
          >brief-prodotto.pdf</span
        >
        <svg
          class="ml-auto size-3.5 shrink-0 text-base-900"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      </div>
    </div>
  </div>
</div>
