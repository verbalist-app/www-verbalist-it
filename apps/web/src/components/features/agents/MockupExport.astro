---
// 04 · Esportazione — articolo pronto + metadati SEO reali (title/meta/slug) + copertina.
// Grande, esce dal bordo in basso (stile Feature4). Monocromo. side = lato illustrazione.
const { side = "right", variant = "panel" } = Astro.props;
const isCard = variant === "card";
const pad = side === "right" ? "pr-0" : "pl-0";
const bleed = side === "right" ? "-mr-1 rounded-tl-xl" : "-ml-1 rounded-tr-xl";
const panelClass = isCard
  ? "contents"
  : `relative p-8 pb-0 ${pad} h-full overflow-hidden bg-mist-100 bg-[url(/img/agent-export.webp)] bg-cover bg-center rounded-xl group`;
const cardClass = isCard
  ? "w-full max-w-md p-5 mx-auto bg-white rounded-xl shadow-sm outline outline-mist-500/10"
  : `relative z-10 max-w-md p-5 mx-auto -mb-1 ${bleed} bg-white shadow-sm outline outline-mist-500/10`;
---

<div aria-hidden="true" class={panelClass}>
  {!isCard && <div class="absolute inset-0 bg-mist-100/25"></div>}
  <div class={cardClass}>
    <div class="pb-3 border-b border-mist-500/10">
      <p class="text-sm font-semibold text-base-900">
        Migliori scarpe running 2026
      </p>
      <span class="text-xs text-base-500">1.850 parole · IT · Pro</span>
    </div>

    <dl class="pt-3 space-y-3">
      <div>
        <dt class="text-xs text-base-500">Title tag</dt>
        <dd class="mt-1 text-sm text-base-900">
          Migliori scarpe running 2026: guida completa
        </dd>
      </div>
      <div>
        <dt class="text-xs text-base-500">Meta description</dt>
        <dd class="mt-2 space-y-1.5">
          <div class="h-2 rounded-full w-full bg-mist-400/25"></div>
          <div class="h-2 rounded-full w-[68%] bg-mist-400/25"></div>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-base-500">Slug</dt>
        <dd class="mt-1 font-mono text-xs text-base-700">
          /migliori-scarpe-running-2026
        </dd>
      </div>
    </dl>

    <div
      class="flex items-center justify-between pt-3 mt-3 border-t border-mist-500/10"
    >
      <span class="inline-flex items-center gap-1.5 text-xs text-base-500">
        <svg
          class="size-3.5 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="18" height="18" x="3" y="3" rx="2"></rect>
          <circle cx="9" cy="9" r="2"></circle>
          <path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path>
        </svg>
        copertina
      </span>
      <span
        class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-full bg-base-900 text-white duration-300 group-hover:-translate-y-0.5"
      >
        <svg
          class="size-3 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="14" height="14" x="8" y="8" rx="2"></rect>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
        </svg>
        Copia
      </span>
    </div>
  </div>
</div>
