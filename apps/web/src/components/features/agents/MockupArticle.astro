---
// 03 · Generazione articolo — editor con scrittura in corso, heading + caret.
// Grande, esce dal bordo in basso (stile Feature4). side = lato illustrazione.
const { side = "right", variant = "panel" } = Astro.props;
const isCard = variant === "card";
const pad = side === "right" ? "pr-0" : "pl-0";
const bleed = side === "right" ? "-mr-1 rounded-tl-xl" : "-ml-1 rounded-tr-xl";
const panelClass = isCard
  ? "contents"
  : `relative p-8 pb-0 ${pad} h-full overflow-hidden bg-mist-100 bg-[url(/img/agent-article.webp)] bg-cover bg-center rounded-xl group`;
const cardClass = isCard
  ? "w-full max-w-md p-5 mx-auto bg-white rounded-xl shadow-sm outline outline-mist-500/10"
  : `relative z-10 max-w-md p-5 mx-auto -mb-1 ${bleed} bg-white shadow-sm outline outline-mist-500/10`;
---

<div aria-hidden="true" class={panelClass}>
  {!isCard && <div class="absolute inset-0 bg-mist-100/25"></div>}
  <div class={cardClass}>
    <div class="flex items-center justify-between pb-3 border-b border-mist-500/10">
      <span class="text-xs font-medium text-base-900">Editor</span>
      <span class="inline-flex items-center gap-1.5 text-xs text-base-500">
        <span class="rounded-full size-1.5 bg-base-900 animate-pulse"></span>
        scrittura in corso
      </span>
    </div>

    <div class="pt-4 space-y-3">
      <p class="text-base font-semibold text-base-900">
        Migliori scarpe running 2026
      </p>
      <p class="text-sm leading-relaxed text-base-700">
        Per scegliere le scarpe da running giuste servono tre fattori:
        ammortizzazione, peso e tipo di appoggio<span
          aria-hidden="true"
          class="ml-px inline-block h-[14px] w-[2px] translate-y-0.5 bg-base-900 align-middle animate-pulse"
        ></span>
      </p>
      <div class="space-y-2">
        <div class="h-2 rounded-full w-full bg-mist-400/25"></div>
        <div class="h-2 rounded-full w-[92%] bg-mist-400/25"></div>
        <div class="h-2 rounded-full w-[80%] bg-mist-400/25"></div>
      </div>
      <div class="h-2.5 w-1/3 rounded-full bg-mist-400/40"></div>
      <div class="space-y-2">
        <div class="h-2 rounded-full w-full bg-mist-400/25"></div>
        <div class="h-2 rounded-full w-[88%] bg-mist-400/25"></div>
        <div class="h-2 rounded-full w-[60%] bg-mist-400/25"></div>
      </div>
    </div>
  </div>
</div>
