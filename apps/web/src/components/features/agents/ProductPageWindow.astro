---
// Un documento di tipo "Pagina Prodotto" nell'app: la pagina del documento
// con la scheda prodotto generata. Il testo è reso con righe neutre e una
// tabella di caratteristiche a barre: mostra la forma dell'output, non un
// contenuto che non è stato generato davvero. Disegnata a 560 px, `zoom` dal
// contenitore. Solo immagine.
interface Props {
  title: string;
  keyword: string;
  class?: string;
}
const { title, keyword, class: className = "" } = Astro.props;
const bars = ["w-full", "w-11/12", "w-5/6", "w-full", "w-2/3"];
---

<div class={`w-[560px] overflow-hidden text-base-900 bg-white rounded-xl antialiased [zoom:var(--vb-zoom,1)] ${className}`}>
  <div class="flex items-center h-8 px-3 border-b gap-1.5 border-base-200">
    <span class="rounded-full size-2 bg-base-200"></span><span class="rounded-full size-2 bg-base-200"></span><span class="rounded-full size-2 bg-base-200"></span>
  </div>
  <div class="p-5 bg-base-50">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center h-6 px-2.5 text-[12px] font-medium text-white rounded-md bg-base-900">Completato</span>
      <span class="text-[13px] text-base-500">Pagina Prodotto</span>
      <span class="px-2 py-0.5 text-[12px] rounded-md bg-base-200 text-base-800">{keyword}</span>
    </div>
    <div class="mt-4 bg-white border rounded-lg border-base-200">
      <div class="flex items-center justify-between px-4 border-b h-11 border-base-200">
        <span class="text-[13px] font-medium">Versione A</span>
        <span class="inline-flex items-center h-7 px-3 text-[12px] border rounded-full gap-1.5 border-base-200">Usa questa versione<svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg></span>
      </div>
      <div class="grid grid-cols-[9rem_minmax(0,1fr)] gap-5 p-5">
        <span class="block h-36 rounded-md bg-base-100"></span>
        <div>
          <p class="text-lg font-medium leading-snug tracking-tight text-base-900">{title}</p>
          <div class="mt-3 space-y-2">
            {bars.slice(0, 4).map((w) => <span class={`block h-2 rounded bg-base-200 ${w}`} />)}
          </div>
          <div class="mt-4 overflow-hidden border rounded-md border-base-200">
            {["Ammortizzazione", "Drop", "Peso", "Uso"].map((k, i) => (
              <div class={`grid grid-cols-[6rem_minmax(0,1fr)] items-center px-3 py-1.5 text-[12px] gap-3 ${i > 0 ? "border-t border-base-200" : ""}`}>
                <span class="text-base-500">{k}</span>
                <span class={`block h-2 rounded bg-base-200 ${bars[i + 1]}`} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
