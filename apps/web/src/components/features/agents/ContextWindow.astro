---
// Il contesto del brand nel brief, com'è nel passo "Nuovo documento":
// località e lingua del mercato, testo di contesto e fino a 3 PDF (la nota
// sul limite è quella dell'app). Il testo è reso con righe neutre: non è
// un contenuto, è il posto dove lo metti. Disegnata a 520 px, `zoom` dal
// contenitore. Solo immagine.
interface Props {
  market: string;
  language: string;
  files: string[];
  class?: string;
}
const { market, language, files, class: className = "" } = Astro.props;
const lbl = "block text-[12px] text-base-700";
const field = "flex items-center h-9 px-3 mt-1.5 text-[13px] bg-white border rounded-lg border-base-200 text-base-800";
const chev = '<path d="M6 9l6 6 6-6"/>';
---

<div class={`w-[520px] overflow-hidden text-base-900 bg-white rounded-xl antialiased [zoom:var(--vb-zoom,1)] ${className}`}>
  <div class="flex items-center h-8 px-3 border-b gap-1.5 border-base-200">
    <span class="rounded-full size-2 bg-base-200"></span><span class="rounded-full size-2 bg-base-200"></span><span class="rounded-full size-2 bg-base-200"></span>
  </div>
  <div class="p-5 bg-base-50">
    <div class="grid grid-cols-2 gap-3">
      <div>
        <span class={lbl}>Località</span>
        <span class={`${field} justify-between`}>{market}<svg class="size-3.5 text-base-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={chev} /></span>
      </div>
      <div>
        <span class={lbl}>Lingua</span>
        <span class={`${field} justify-between`}>{language}<svg class="size-3.5 text-base-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={chev} /></span>
      </div>
    </div>
    <div class="mt-4">
      <span class={lbl}>Contesto <span class="text-base-500">(opzionale)</span> <span class="ml-1 px-1.5 py-0.5 text-2xs rounded bg-base-200 text-base-700">Consigliato</span></span>
      <div class="p-3 mt-1.5 bg-white border rounded-lg border-base-200 space-y-2">
        <span class="block h-2 rounded bg-base-200 w-11/12"></span>
        <span class="block h-2 rounded bg-base-200 w-full"></span>
        <span class="block h-2 rounded bg-base-200 w-4/6"></span>
      </div>
    </div>
    <div class="mt-4">
      <div class="flex flex-wrap items-center gap-2">
        {
          files.map((f) => (
            <span class="inline-flex items-center h-8 px-3 text-[13px] bg-white border rounded-lg gap-2 border-base-200 text-base-800">
              <svg class="size-4 text-base-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /></svg>
              {f}
              <svg class="size-3.5 text-base-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg>
            </span>
          ))
        }
        {
          files.length < 3 && (
            <span class="inline-flex items-center h-8 px-3 text-[13px] bg-white border border-dashed rounded-lg gap-2 border-base-300 text-base-700">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>Inserisci PDF
            </span>
          )
        }
      </div>
      <p class="mt-2 text-[12px] text-base-500">Puoi caricare fino a 3 file PDF, massimo 1MB ciascuno</p>
    </div>
  </div>
</div>
