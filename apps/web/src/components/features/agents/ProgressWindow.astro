---
// La pagina del documento mentre l'analisi è in corso, com'è nell'app:
// stato "In elaborazione", keyword, "Generazione in corso…" e la coda dei
// risultati che l'agente sta leggendo. I domini sono quelli dimostrativi di
// demo.ts. Disegnata a 520 px e ridotta con `zoom`. Solo immagine.
import { demoBrief, demoSerp } from "@/components/home/demo";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
const queue = demoSerp.map((r) => `https://${r.host}/${r.title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}/`);
---

<div class={`w-[520px] overflow-hidden text-base-900 bg-white rounded-xl antialiased [zoom:var(--vb-zoom,1)] ${className}`}>
  <div class="flex items-center h-8 px-3 border-b gap-1.5 border-base-200">
    <span class="rounded-full size-2 bg-base-200"></span><span class="rounded-full size-2 bg-base-200"></span><span class="rounded-full size-2 bg-base-200"></span>
  </div>
  <div class="p-5 bg-base-50">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center h-6 px-2.5 text-[12px] font-medium rounded-md bg-base-200 text-base-700">In elaborazione</span>
      <span class="text-[13px] text-base-500">Analisi dei primi 5 risultati · Google IT</span>
    </div>
    <p class="mt-4 text-xl font-normal leading-tight tracking-tight text-base-900">Nuovo documento</p>
    <p class="flex items-center mt-2 text-[13px] gap-2 text-base-600">
      {demoBrief.type}
      <span class="text-base-400">·</span>
      <span class="px-2 py-0.5 text-[12px] rounded-md bg-base-200 text-base-800">{demoBrief.keyword}</span>
    </p>
    <div class="p-4 mt-5 bg-white border rounded-lg border-base-200">
      <p class="flex items-center text-[13px] font-medium gap-2 text-base-900">
        <span class="rounded-full size-2 bg-base-900"></span>Generazione in corso...
      </p>
      <ol class="mt-3 space-y-1.5">
        {
          queue.map((url, i) => (
            <li class={`flex items-center gap-2 text-[12px] font-mono ${i < 3 ? "text-base-800" : "text-base-400"}`}>
              <span class="w-14 shrink-0 text-base-500">{i < 3 ? "Letto" : "In coda:"}</span>
              <span class="truncate">{url}</span>
              {i < 3 && (
                <svg class="ml-auto size-3 shrink-0 text-status-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</div>
