---
// Il passo "Nuovo documento" dell'app, ricostruito fedelmente e compilato con
// un brief d'esempio: tipo di contenuto, keyword principale, località, lingua,
// contesto (PDF) e progetto. Disegnato a 420 px e ridotto con `zoom`
// (variabile --vb-zoom) dal contenitore. Solo immagine.
interface Field {
  label: string;
  value: string;
}
interface Props {
  fields: Field[];
  file?: string;
  project?: string | null;
  class?: string;
}
const { fields, file, project = null, class: className = "" } = Astro.props;
const get = (name: string) => fields.find((f) => f.label.toLowerCase() === name)?.value ?? "";
const keyword = get("keyword");
const market = get("mercato").split("·")[0].trim();
const language = get("lingua");
const type = get("tipo");
const lbl = "block text-[12px] text-base-700";
const field = "flex items-center h-9 px-3 mt-1.5 text-[13px] bg-white border rounded-lg border-base-200 text-base-800";
const chev = '<path d="M6 9l6 6 6-6"/>';
---

<div class={`w-[420px] overflow-hidden text-base-900 bg-white rounded-xl antialiased [zoom:var(--vb-zoom,1)] ${className}`}>
  <div class="flex items-center h-8 px-3 border-b gap-1.5 border-base-200">
    <span class="rounded-full size-2 bg-base-200"></span><span class="rounded-full size-2 bg-base-200"></span><span class="rounded-full size-2 bg-base-200"></span>
  </div>
  <div class="p-5 bg-base-50">
    <div class="flex items-center justify-between">
      <p class="text-[13px] font-medium text-base-900">Nuovo documento</p>
      <p class="text-[12px] text-base-500">Passo 2 di 3</p>
    </div>
    <div class="flex items-center mt-3 gap-2">
      <span class="inline-flex items-center h-7 px-2.5 text-[12px] text-white rounded-md bg-base-900">{type}</span>
      <span class="inline-flex items-center h-7 px-2.5 text-[12px] rounded-md bg-base-200 text-base-800">Nuovo contenuto</span>
    </div>
    <div class="mt-4">
      <span class={lbl}>Keyword principale</span>
      <span class={field}>{keyword}</span>
    </div>
    <div class="grid grid-cols-2 mt-3 gap-3">
      <div>
        <span class={lbl}>Località</span>
        <span class={`${field} justify-between`}>{market}<svg class="size-3.5 text-base-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={chev} /></span>
      </div>
      <div>
        <span class={lbl}>Lingua</span>
        <span class={`${field} justify-between`}>{language}<svg class="size-3.5 text-base-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={chev} /></span>
      </div>
    </div>
    {
      file && (
        <div class="mt-3">
          <span class={lbl}>Contesto <span class="text-base-500">(opzionale)</span></span>
          <span class="flex items-center h-9 px-3 mt-1.5 text-[13px] bg-white border border-dashed rounded-lg gap-2 border-base-300 text-base-800">
            <svg class="size-4 text-base-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /></svg>
            <span class="truncate">{file}</span>
            <svg class="ml-auto size-3.5 text-base-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg>
          </span>
        </div>
      )
    }
    {
      project && (
        <div class="mt-3">
          <span class={lbl}>Progetto <span class="text-base-500">(opzionale)</span></span>
          <span class={`${field} justify-between`}>{project.replace(/^Progetto:\s*/i, "")}<svg class="size-3.5 text-base-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={chev} /></span>
        </div>
      )
    }
    <div class="flex justify-end mt-5">
      <span class="inline-flex items-center h-9 px-4 text-[13px] text-white rounded-full gap-2 bg-base-900">Continua<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
    </div>
  </div>
</div>
