---
// Sezione nella grammatica a carta avorio (dal 2026-10-17): niente riga
// in testa, niente sigla nel margine, niente punti d'angolo. Le sezioni si
// separano con l'aria (prop `rhythm`) e con il tono dei pannelli. Le prop
// `n` e `flush` restano nella firma perché i chiamanti le passano ancora.
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

interface Props {
  n?: number;
  id?: string;
  labelledby?: string;
  class?: string;
  tone?: "white" | "soft";
  flush?: boolean;
  /**
   * Ritmo verticale della sezione, in righe di corpo (token `--spacing-v*`):
   * `section` 2/4 righe sopra/sotto su mobile, 3/5 da lg; `open` solo sopra,
   * per le sezioni che finiscono con celle sul bordo (piani, griglie);
   * `close` per le chiusure, una riga in più sopra. Senza, il padding lo
   * passa chi chiama (hero, sezioni a celle).
   */
  rhythm?: "section" | "open" | "close";
}
const { id, labelledby, class: className = "", tone = "white", rhythm } = Astro.props;
const rhythms = {
  section: "pt-v2 pb-v4 lg:pt-v3 lg:pb-v5",
  open: "pt-v2 lg:pt-v3",
  close: "pt-v3 pb-v4 lg:pt-v4 lg:pb-v5",
};
const rhythmClass = rhythm ? rhythms[rhythm] : "";
---

<section id={id} aria-labelledby={labelledby} class="relative scroll-mt-[72px]">
  <Wrapper
    variant="standard"
    class={`relative ${tone === "soft" ? "bg-base-50 rounded-md" : ""} ${rhythmClass} ${className}`}
  >
    <slot />
  </Wrapper>
</section>
