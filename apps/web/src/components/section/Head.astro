---
// Testa di sezione: targhetta mono nell'accento, titolo a 52px in peso
// regolare (le parole in grigio e nell'accento arrivano dallo slot "title")
// e, a fianco, il testo di accompagnamento.
interface Props {
  tag?: string;
  id?: string;
  /** Titolo come stringa: l'ultima parola prende l'accento. In alternativa lo slot "title". */
  title?: string;
  /** Tag del titolo (h1 sulle pagine interne). */
  level?: "h1" | "h2";
  /** Testo di accompagnamento come stringa (in alternativa allo slot). */
  text?: string;
  class?: string;
}
const { tag, id, title, level: Level = "h2", text, class: className = "" } = Astro.props;
const hasAside = text || Astro.slots.has("default");
---

<div class={`grid items-end gap-8 ${hasAside ? "lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16" : ""} ${className}`}>
  <div>
    {
      tag && (
        <p class="flex items-center gap-1.5">
          <span class="px-1.5 py-0.5 font-mono text-xs tracking-wider text-white uppercase bg-accent-600">{tag}</span>
          <span aria-hidden="true" class="w-0.5 h-3 bg-accent-300" />
        </p>
      )
    }
    <Level
      id={id}
      class={`${tag ? "mt-6" : ""} text-4xl leading-[1.1] font-normal tracking-[-0.025em] text-base-900 text-balance lg:text-display lg:leading-[1.08]`}
    >
      {title ? title : <slot name="title" />}
    </Level>
  </div>
  {
    hasAside && (
      <div class="max-w-md pb-1 text-base leading-relaxed space-y-4 text-base-700">
        {text ? <p>{text}</p> : <slot />}
      </div>
    )
  }
</div>
