---
// Testa di sezione nella grammatica di cursor.com (dal 2026-10-17):
// etichetta in sans 14px grigia, titolo a 36/52px in peso regolare e, a
// fianco, il testo di accompagnamento. (Prima: targhetta mono bianca su nero.)
interface Props {
  tag?: string;
  id?: string;
  /** Titolo come stringa. In alternativa lo slot "title". */
  title?: string;
  /** Tag del titolo (h1 sulle pagine interne). */
  level?: "h1" | "h2";
  /** Testo di accompagnamento come stringa (in alternativa allo slot). */
  text?: string;
  class?: string;
}
const { tag, id, title, level: Level = "h2", text, class: className = "" } = Astro.props;
const hasAside = text || Astro.slots.has("default");
---

<div class={`grid items-end gap-8 ${hasAside ? "lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16" : ""} ${className}`}>
  <div>
    {tag && <p class="text-sm text-base-500">{tag}</p>}
    <Level
      id={id}
      class={`${tag ? "mt-4" : ""} text-4xl leading-[1.15] font-normal tracking-[-0.025em] text-base-900 text-balance lg:text-display lg:leading-[1.1]`}
    >
      {title ? title : <slot name="title" />}
    </Level>
  </div>
  {
    hasAside && (
      <div class="max-w-md pb-1 text-base leading-relaxed space-y-4 text-base-600">
        {text ? <p>{text}</p> : <slot />}
      </div>
    )
  }
</div>
