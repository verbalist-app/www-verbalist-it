---
import { getCollection } from "astro:content";
// Icons
import X from "@/components/fundations/icons/X.astro";
import Search from "@/components/fundations/icons/Search.astro";
const posts = await Promise.all(
  (await getCollection("posts")).map(async (post) => ({
    title: post.data.title,
    pubDate: post.data.pubDate,
    description: post.data.description,
    slug: post.id,
  }))
);
// I post viaggiano come JSON nella pagina; "<" escapato per non chiudere lo script
const postsJson = JSON.stringify(posts).replace(/</g, "\\u003c");
---

<div class="relative">
  <button
    type="button"
    id="searchButton"
    aria-label="Cerca negli articoli (⌘K)"
    class="flex items-center justify-center h-11 lg:h-9 px-3 bg-white border rounded-full border-base-200 text-base-700 hover:border-base-300 hover:text-accent-600 duration-300 group md:px-4 md:gap-2"
  >
    <Search size="base" />
    <kbd
      aria-hidden="true"
      class="hidden font-mono text-2xs leading-none text-base-500 md:inline"
      >⌘K</kbd
    >
  </button>
  <div
    id="searchModal"
    class="fixed inset-0 z-50 hidden overflow-y-auto"
    role="dialog"
    aria-modal="true"
  >
    <div class="min-h-screen px-4 text-center">
      <div
        class="fixed inset-0 bg-base-950/50 backdrop-blur transition-opacity"
        id="modalOverlay"
      >
      </div>
      <div
        class="relative inline-block w-full max-w-md mt-12 mb-8 text-left align-middle bg-white border border-base-200 lg:mt-48 rounded-xl transition-all transform"
      >
        <div class="p-4 pb-2">
          <div class="hidden">
            <button
              type="button"
              id="closeSearch"
              class="ml-auto cursor-pointer text-base-500 hover:text-base-500"
              aria-label="Close search"
            >
              <X size="base" />
            </button>
          </div>
          <input
            type="text"
            id="searchInput"
            placeholder="Cerca negli articoli..."
            class="block w-full px-4 py-2 text-base leading-tight lg:text-xs align-middle bg-white border border-transparent transition duration-300 ease-in-out focus:z-10 h-9 rounded-md text-base-500 ring-1 ring-base-200 placeholder-base-500 focus:border-accent-500 focus:ring-accent-100 focus:ring-2 focus:outline-none shadow-sm"
          />
          <div
            id="searchResults"
            class="flex flex-col w-full mt-2 overflow-y-auto bg-white max-h-200 rounded-xl scrollbar-hide focus:outline-none space-y-2 focus:ring-2 focus:ring-accent-500"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script is:inline type="application/json" id="blog-search-data" set:html={postsJson} />
<script>
  // Fuse.js arriva dal bundle (non più dal CDN): lo script è un modulo, gira
  // a DOM già pronto e solo nella pagina del blog.
  import Fuse from "fuse.js";

  const posts = JSON.parse(document.getElementById("blog-search-data")?.textContent || "[]");
  {
    // Get references to necessary DOM elements
    const searchButton = document.getElementById("searchButton") as HTMLButtonElement;
    const searchModal = document.getElementById("searchModal") as HTMLDivElement;
    const modalOverlay = document.getElementById("modalOverlay") as HTMLDivElement;
    const searchInput = document.getElementById("searchInput") as HTMLInputElement;
    const searchResults = document.getElementById("searchResults") as HTMLDivElement;
    const closeSearch = document.getElementById("closeSearch") as HTMLButtonElement;
    // Clear the search input field on page load to prevent old values from persisting
    searchInput.value = "";
    // Initialize Fuse.js for fuzzy searching
    const fuse = new Fuse(posts, {
      keys: ["title", "description", "content"], // Fields to search in
      threshold: 0.3, // Determines search sensitivity (lower = stricter match)
      includeMatches: true, // Includes matched text segments in results
    });
    // Function to open the search modal (chiamabile anche senza evento:
    // la usano il ⌘K globale di BaseLayout e l'arrivo con #cerca)
    function openSearch(e?: Event) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      searchModal.classList.remove("hidden"); // Show the modal
      document.body.style.overflow = "hidden"; // Prevent scrolling in the background
      setTimeout(() => searchInput.focus(), 100); // Delay focus to ensure input is ready
    }
    // Function to close the search modal
    function closeSearchModal(e?: Event) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      searchModal.classList.add("hidden"); // Hide the modal
      document.body.style.overflow = ""; // Restore scrolling functionality
      searchInput.value = ""; // Clear search input when modal is closed
      searchResults.innerHTML = ""; // Clear search results
    }
    // Function to display search results
    function renderResults(results: { item: { slug: string; title: string; description: string } }[]) {
      // If search input is empty, clear results
      if (!searchInput.value.trim()) {
        searchResults.innerHTML = "";
        return;
      }
      // If no results are found, display a message with escape routes
      // (categorie e help center) invece di un vicolo cieco.
      if (results.length === 0) {
        const safeTerm = searchInput.value
          .trim()
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
        searchResults.innerHTML = `
                <div class="px-4 py-4 text-sm">
                    <p class="text-base-600">Nessun risultato per &ldquo;${safeTerm}&rdquo;.</p>
                    <p class="mt-3 font-mono text-xs tracking-wider uppercase text-base-500">Prova da qui</p>
                    <div class="flex flex-wrap mt-2 gap-2">
                      <a href="/categorie/guide/" class="px-3 py-1.5 text-xs rounded-full border border-base-200 text-base-600 hover:text-accent-600">Guide</a>
                      <a href="/categorie/seo/" class="px-3 py-1.5 text-xs rounded-full border border-base-200 text-base-600 hover:text-accent-600">SEO</a>
                      <a href="/categorie/ai-automation/" class="px-3 py-1.5 text-xs rounded-full border border-base-200 text-base-600 hover:text-accent-600">AI &amp; Automation</a>
                      <a href="/help/" class="px-3 py-1.5 text-xs rounded-full border border-base-200 text-base-600 hover:text-accent-600">Help center</a>
                    </div>
                </div>
            `;
        return;
      }
      // Generate HTML for search results and display them
      searchResults.innerHTML = results
        .slice(0, 5) // Limit results to top 5 matches
        .map(
          (result) => `
                <a href="/blog/${result.item.slug}/"   class="block p-4 text-balance m-1  rounded-lg hover:bg-mist-100 focus:outline-none focus:ring-2 ring-inset focus:ring-accent-500 duration-300">   
                  <h3 class="font-medium text-base-800 text-sm">${result.item.title}</h3>   
                  <p class="mt-2 text-sm text-base-500 ">${result.item.description}</p> 
                </a>
            `
        )
        .join(""); // Convert array of HTML into a single string
    }
    // Evento GA4 `search` → dataLayer (consumato da GTM, consenso gestito
    // dal Consent Mode). Debounce: pusha solo quando l'utente smette di
    // digitare, con termine normalizzato e numero di risultati — serve a
    // capire cosa viene cercato e cosa non viene trovato (search_results=0).
    let searchTrackTimer: ReturnType<typeof setTimeout> | undefined;
    let lastTrackedTerm = "";
    function trackSearch(term: string, resultsCount: number) {
      clearTimeout(searchTrackTimer);
      if (term.length < 3 || term === lastTrackedTerm) return;
      searchTrackTimer = setTimeout(() => {
        lastTrackedTerm = term;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: "search",
          search_term: term,
          search_results: resultsCount,
        });
      }, 900);
    }
    // Attach event listeners for opening the search modal (both click and touch)
    searchButton.addEventListener("click", openSearch);
    searchButton.addEventListener("touchend", openSearch);
    // Attach event listeners for closing the search modal (both click and touch)
    closeSearch.addEventListener("click", closeSearchModal);
    closeSearch.addEventListener("touchend", closeSearchModal);
    // Close the modal when clicking outside the search box
    modalOverlay.addEventListener("click", closeSearchModal);
    modalOverlay.addEventListener("touchend", closeSearchModal);
    // Perform search when input changes
    searchInput.addEventListener("input", (e) => {
      const value = (e.target as HTMLInputElement).value; // Get the input value
      const results = value.trim() ? fuse.search(value) : []; // Perform search if input isn't empty
      renderResults(results); // Update the displayed results
      trackSearch(value.trim().toLowerCase(), results.length);
    });
    // Close the search modal when pressing the "Escape" key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !searchModal.classList.contains("hidden")) {
        closeSearchModal();
      }
    });
    // Apertura dall'esterno: ⌘K globale (BaseLayout) o arrivo con #cerca
    document.addEventListener("verbalist:open-search", () => openSearch());
    if (location.hash === "#cerca") {
      openSearch();
      history.replaceState(null, "", location.pathname);
    }
  }
</script>
