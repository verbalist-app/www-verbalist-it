---
// Cella di articolo: data e categoria in mono, titolo, descrizione. Niente
// copertina nell'elenco: le immagini astratte del blog restano nel post.
const headingTag = Astro.props.headingTag ?? "h3";
const Heading = headingTag;
const post = Astro.props.post;
const url = "/blog/" + post.slug + "/";
const title = post.data.title;
const description = post.data.description;
const tag = post.data.tags?.[0];
const pubDate = new Date(post.data.pubDate).toLocaleDateString("it-IT", {
  year: "numeric",
  month: "short",
  day: "2-digit",
});
---

<article class="relative flex flex-col px-4 py-8 border-b border-dashed group border-base-200 lg:px-8 lg:py-10 transition-colors duration-200 hover:bg-base-50">
  <p class="flex items-center justify-between font-mono text-xs tracking-wider uppercase gap-4 text-base-500">
    <time datetime={new Date(post.data.pubDate).toISOString()}>{pubDate}</time>
    {tag && <span class="text-accent-600">{tag}</span>}
  </p>
  <Heading class="mt-8 text-xl font-normal leading-snug tracking-tight text-base-900 text-balance">
    <a href={url} class="after:absolute after:inset-0 group-hover:text-accent-600">{title}</a>
  </Heading>
  <p class="mt-3 text-md leading-relaxed text-base-600 line-clamp-3">{description}</p>
  <p class="pt-6 mt-auto text-sm text-base-900" aria-hidden="true">Leggi →</p>
</article>
