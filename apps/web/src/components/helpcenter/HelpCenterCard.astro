---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";

// Icons
import User from "@/components/fundations/icons/User.astro";
import Shield from "@/components/fundations/icons/Shield.astro";
import Settings from "@/components/fundations/icons/Settings.astro";
import InfoCircle from "@/components/fundations/icons/InfoCircle.astro";
import CreditCard from "@/components/fundations/icons/CreditCard.astro";
import Search from "@/components/fundations/icons/Search.astro";
import Filters from "@/components/fundations/icons/Filters.astro";
import Stacked from "@/components/fundations/icons/Stacked.astro";
import Persist from "@/components/fundations/icons/Persist.astro";
import Plus from "@/components/fundations/icons/Plus.astro";
import List from "@/components/fundations/icons/List.astro";

// Content
const { page, description, url, iconId } = {
  url: "/help/" + Astro.props.post.slug + "/",
  page: Astro.props.post.data.page,
  description: Astro.props.post.data.description,
  iconId: Astro.props.post.data.iconId || "info-circle", // Default icon if not provided
};

// Map iconId values to actual icon components (una icona diversa per guida:
// vedi il frontmatter iconId dei singoli articoli in content/helpcenter)
const iconMap = {
  user: User,
  settings: Settings,
  shield: Shield,
  creditCard: CreditCard,
  search: Search,
  filters: Filters,
  stacked: Stacked,
  persist: Persist,
  plus: Plus,
  list: List,
};

// Select the correct icon component
const IconComponent = iconMap[iconId] || InfoCircle; // Default to InfoCircle if not found
---

<div
  class="relative flex flex-col h-full p-4 bg-mist-100 rounded-xl group hover:bg-white hover:shadow-sm duration-300 outline-transparent hover:outline hover:outline-mist-100"
>
  <a
    title={`Leggi la guida: ${page}`}
    aria-label={`Leggi la guida: ${page}`}
    class="absolute inset-0 z-10"
    href={url}></a>
  <div class="relative flex flex-col justify-between h-full gap-8">
    <div>
      <div
        class="inline-flex p-4 bg-white rounded-lg group-hover:bg-mist-100 duration-300 group-hover:-rotate-12 group-hover:-translate-y-2 w-fit"
      >
        <IconComponent size="sm" />
        <!-- Render dynamic icon here -->
      </div>
      <div>
        <Text tag="h2" variant="textSM" class="mt-12 font-medium text-base-900">
          {page}
        </Text>
        <Text tag="p" variant="textSM" class="mt-2 text-base-500"
          >{description}</Text
        >
      </div>
    </div>
  </div>
</div>
