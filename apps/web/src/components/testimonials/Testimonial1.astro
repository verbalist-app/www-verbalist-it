---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
// Quote reale dal -DEF (siteConfig.quoteSection): Jurny.
// L'attribuzione è aziendale (logo + risultato dal caso studio), non a una
// persona: nei sorgenti non esiste un nome dietro la quote — se arriva,
// sostituire il fatto numerico con nome e ruolo.
---

<section class="border-t border-base-200 border-dashed">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <article class="relative text-center group">
      <a
        href="/clienti/jurny/"
        title="Leggi il case study di Jurny"
        aria-label="Leggi il case study di Jurny"
        class="absolute inset-0 z-10"></a>

      <figure class="max-w-xl mx-auto text-balance">
        <blockquote>
          <Text
            tag="p"
            variant="displayMD"
            class="font-serif font-medium tracking-tight text-base-950"
          >
            “Per ogni keyword Verbalist analizza i competitor su Google. Il team
            usa quei dati per scrivere e i contenuti escono già nel tono del
            brand.”
          </Text>
        </blockquote>
        <figcaption class="flex flex-col items-center mt-10 gap-3">
          <img
            src="/img/logos/jurny.svg"
            alt=""
            class="w-auto h-5"
            loading="lazy"
          />
          <Text tag="p" variant="textSM" class="text-base-600">
            Jurny, hospitality software · 14 contenuti in inglese nei primi due
            mesi
          </Text>
        </figcaption>
        <Text
          tag="p"
          variant="textSM"
          class="flex items-center justify-center mt-6 text-base-500 gap-1"
          >Leggi il case study <ChevronRight
            class="inline-block size-4"
          /></Text
        >
      </figure>
    </article>
  </Wrapper>
</section>
