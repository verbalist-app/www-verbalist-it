---
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

// Loghi clienti Verbalist (SVG statici in /public/img/logos, resi neri = monocromo)
const logos = [
  { src: "/img/logos/rentokil.svg", alt: "Rentokil", width: 329, height: 150 },
  { src: "/img/logos/pompea.svg", alt: "Pompea", width: 300, height: 87 },
  { src: "/img/logos/meccanotecnica.svg", alt: "Meccanotecnica", width: 300, height: 94 },
  { src: "/img/logos/plastisac.svg", alt: "Plastisac", width: 300, height: 71 },
  { src: "/img/logos/sogese.svg", alt: "Sogese", width: 278, height: 150 },
  { src: "/img/logos/jurny.svg", alt: "Jurny", width: 300, height: 126 },
  { src: "/img/logos/turboden.svg", alt: "Turboden", width: 236, height: 73 },
  { src: "/img/logos/astori-ferramenta.svg", alt: "Astori Ferramenta", width: 300, height: 42 },
];
---

<section>
  <Wrapper variant="standard" class="relative overflow-hidden border-t border-dashed border-base-200">
    <p
      class="pt-8 font-mono text-xs font-medium tracking-wider text-center uppercase text-base-500"
    >
      Scelto da
    </p>
    <div
      class="relative flex items-center pt-6 pb-8 animate-marquee gap-12 lg:gap-24 whitespace-nowrap"
    >
      {
        [...logos, ...logos].map((logo) => (
          <img
            class="h-6 w-auto shrink-0 brightness-0"
            src={logo.src}
            alt={logo.alt}
            width={logo.width}
            height={logo.height}
            loading="lazy"
          />
        ))
      }
    </div>
    <div
      class="absolute inset-0 w-full bg-linear-45 from-white via-transparent to-white"
    >
    </div>
  </Wrapper>
</section>
