---
interface Props {
  variant?: "standard" | "prose"; // Define any variants you need
  class?: string; // Optional prop for additional classes
  id?: string; // Optional prop for additional classes
}
const { variant = "standard", class: extraClass = "" } = Astro.props;
// Map each variant to its specific classes
const variantClasses = {
  // Standard wrapper
  standard:
    "mx-auto  2xl:max-w-6xl 2xl:px-12 w-full  max-w-5xl border-x border-base-200 border-dashed px-4",

  // Prose styles
  prose:
    "prose text-base-700 prose-blockquote:border-l-accent-500 prose-blockquote:font-normal prose-blockquote:text-base-800 prose-a:text-base-900 prose-a:border-b prose-a:border-dashed prose-a:border-base-400 prose-a:no-underline prose-a:transition-colors prose-a:duration-200 prose-a:hover:text-accent-600 prose-a:hover:border-accent-500 prose-headings:font-normal prose-headings:tracking-tight prose-headings:text-base-900 prose-strong:font-medium prose-strong:text-base-900 prose-pre:border prose-pre:border-base-200 prose-pre:rounded-xl prose-li:marker:text-accent-500 prose-ul:list-disc prose-hr:border-dashed prose-hr:border-base-200 prose-img:rounded-xl prose-img:border prose-img:border-base-200 max-w-none w-full prose-pre:scrollbar-hide",
};
// Combine the classes for the specified variant with any extra classes
const classes = `${variantClasses[variant]} ${extraClass}`.trim();
---

<div class={classes}>
  <slot />
</div>
