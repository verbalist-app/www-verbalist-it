---
const {
  gap,
  size,
  variant,
  onlyIconSize,
  iconOnly = false,
  isLink = false,
  class: className,
  type = "button", // default button type
  ...rest
} = Astro.props;

const defaultClass = [
  "bg-black",
  "text-white",
  "focus:ring-black",
  "hover:bg-base-700",
];
// Pillola piena nell'accento: un filo di luce in alto e un'ombra corta la
// staccano dal foglio senza farne un bottone "lucido".
const accentClass = [
  "text-white",
  "bg-accent-500",
  "hover:bg-base-700",
  "focus:ring-base-900",
  "shadow-[inset_0_1px_0_rgb(255_255_255/0.22),0_1px_2px_rgb(0_0_0/0.14)]",
];
// Pillola bianca con filetto: l'azione secondaria.
const mutedClass = [
  "text-base-900",
  "bg-white",
  "border",
  "border-base-200",
  "hover:border-base-300",
  "hover:text-accent-600",
  "focus:ring-base-300",
  "shadow-[0_1px_2px_rgb(0_0_0/0.05)]",
];

const sizes = {
  xs: ["h-8", "px-4", "py-2", "text-xs"],
  sm: ["h-9", "px-4", "py-2", "text-sm"],
  base: ["h-10", "px-6", "py-3", "text-base"],
  md: ["h-11", "px-6", "py-3", "text-md"],
  lg: ["h-12", "px-6", "py-3", "text-lg"],
  xl: ["h-14", "px-6", "py-3", "text-base"],
};

// Icon-only sizes keep the button perfectly square
const iconSizes = {
  xs: ["size-8", "text-xs"],
  sm: ["size-9", "text-sm"],
  base: ["size-10", "text-base"],
  md: ["size-11", "text-md"],
  lg: ["size-12", "text-lg"],
  xl: ["size-14", "text-base"],
};

const gapMap = {
  xs: ["gap-2"],
  sm: ["gap-4"],
  base: ["gap-8"],
  md: ["gap-10"],
  lg: ["gap-12"],
};

const variantClass = {
  default: defaultClass,
  accent: accentClass,
  muted: mutedClass,
  none: [],
};

const additionalClasses = className ? className.split(" ") : [];

const sizeValue = iconOnly && onlyIconSize ? onlyIconSize : size;
const sizeClass = iconOnly
  ? iconSizes[sizeValue] || sizes[sizeValue] || []
  : sizes[sizeValue] || [];
const gapClass = !iconOnly && gap ? gapMap[gap] || [] : [];
// Su touch i bottoni piccoli estendono l'area cliccabile a ~44px
// (utility .tap-target in global.css, attiva solo con pointer: coarse).
const touchClass = ["xs", "sm", "base"].includes(sizeValue)
  ? ["relative", "tap-target"]
  : [];

const baseClass = [
  "flex",
  "transition",
  "text-center",
  "rounded-full",
  "items-center",
  "duration-300",
  "justify-center",
  "focus:ring-2",
  "focus:outline-none",
  "focus:ring-offset-2",
  ...(variantClass[variant] || []),
  ...sizeClass,
  ...gapClass,
  ...touchClass,
  ...additionalClasses,
];
---

{
  isLink ? (
    <a class:list={baseClass} {...rest}>
      {iconOnly ? (
        <slot name="icon" />
      ) : (
        <>
          <slot name="left-icon" />
          <slot />
          <slot name="right-icon" />
        </>
      )}
    </a>
  ) : (
    <button type={type} class:list={baseClass} {...rest}>
      {iconOnly ? (
        <slot name="icon" />
      ) : (
        <>
          <slot name="left-icon" />
          <slot />
          <slot name="right-icon" />
        </>
      )}
    </button>
  )
}
