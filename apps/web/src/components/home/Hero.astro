---
// Primo viewport, a sinistra: titolo a 32/36/44px in peso medio, con
// il motore per cui Verbalist scrive che cambia per un giro solo (ChatGPT,
// Gemini, Claude, Perplexity, Google, poi fermo: la sola animazione della
// sezione, ferma dall'inizio con prefers-reduced-motion, in pausa col mouse
// o col focus), il lede e le due pillole.
// Sotto, il prodotto in un pannello tinto a tutta larghezza con la V del
// brand in filigrana: la pagina del documento in app (AppWindow.astro) con la
// luce di un oggetto appoggiato e il brief come un messaggio. I marchi dei
// motori (public/img/engines/, forniti dal maintainer) restano dei rispettivi
// proprietari e sono gli unici colori della sezione.
import Button from "@/components/fundations/elements/Button.astro";
import Frame from "@/components/section/Frame.astro";
import Watermark from "@/components/assets/Watermark.astro";
import { TRIAL_HREF } from "@/lib/pricing";
import { demoBrief } from "./demo";
import AppWindow from "./AppWindow.astro";

// Dove va a finire il contenuto, nell'ordine in cui il titolo li mostra.
const engines = [
  { name: "ChatGPT", logo: "openai" },
  { name: "Gemini", logo: "gemini" },
  { name: "Claude", logo: "claude" },
  { name: "Perplexity", logo: "perplexity" },
  { name: "Google", logo: "google" },
];
const [first, ...others] = engines;
const label = "text-sm text-base-500";
---

<Frame n={1} labelledby="home-title" class="pt-12 pb-10 lg:pt-20 lg:pb-14 lg:!px-14">
  <div class="max-w-3xl">
    <h1
      id="home-title"
      class="text-[2rem] leading-[1.1] font-medium tracking-[-0.03em] text-base-900 text-balance sm:text-4xl lg:text-hero-md"
    >
      Prima legge Google.<br />
      Poi scrive
      <span class="whitespace-nowrap">per
      <span class="inline-flex items-baseline gap-[0.3em]" data-engines={JSON.stringify(engines)}>
        <img
          src={`/img/engines/${first.logo}.svg`}
          alt=""
          width="40"
          height="40"
          class="self-center size-[0.72em] vb-engine-icon"
          data-engine-icon
          decoding="async"
        />
        <span class="vb-engine-name" data-engine-name>{first.name}</span>
        <span class="sr-only">, {others.map((e) => e.name).join(", ")}</span>
      </span>.</span>
    </h1>
    <p class="max-w-xl mt-5 text-lg leading-snug text-base-600 lg:text-lede">
      Legge i primi cinque risultati per la tua keyword e scrive un
      contenuto nuovo, nella lingua del tuo mercato, pronto per il CMS.
    </p>
    <div class="flex flex-wrap items-center mt-8 gap-3">
      <Button isLink size="base" variant="accent" href={TRIAL_HREF}>Prova gratis</Button>
      <Button isLink size="base" variant="muted" href="/contatti/">Parla con noi</Button>
    </div>
    <p class="mt-4 text-sm text-base-500">
      30 giorni, 15 documenti, senza carta di credito.
    </p>
  </div>

  <!-- Il pannello di prodotto: la V in filigrana, la finestra dell'app intera
       (il pannello si adatta alla sua altezza: niente tagli), il brief in primo piano -->
  <div
    role="img"
    data-nosnippet
    aria-label={`Il brief con la keyword «${demoBrief.keyword}» e la pagina del documento in Verbalist con le due versioni generate, A e B.`}
    class="relative mt-12 overflow-hidden rounded-md bg-base-50 px-4 pt-6 pb-20 sm:px-8 sm:pt-8 sm:pb-24 lg:mt-16 lg:px-12 lg:pt-10 lg:pb-16 vb-stage [--vb-zoom:0.28] sm:[--vb-zoom:0.6] lg:[--vb-zoom:0.86]"
  >
    <Watermark class="-right-4 -top-10 h-[120%] sm:-right-8 sm:h-[140%]" />

    <div class="relative mx-auto overflow-hidden rounded-xl w-fit vb-window">
      <AppWindow sidebar={false} />
    </div>

    <!-- Il brief di partenza, come un messaggio -->
    <div class="absolute z-10 p-4 bg-panel bottom-4 left-4 w-[15.5rem] rounded-2xl rounded-bl-md vb-float sm:left-6 sm:w-72 lg:bottom-8 lg:left-8">
      <p class={label}>Brief</p>
      <p class="mt-2 text-sm leading-snug text-base-900">«{demoBrief.keyword}»</p>
      <p class="mt-2 text-xs text-base-500">{demoBrief.type} · {demoBrief.market} · {demoBrief.language}</p>
    </div>
  </div>
</Frame>

<style>
  /* La luce dell'oggetto: filo chiaro in alto, bordo sottile, ombra lunga. */
  .vb-window {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 0 0 1px rgb(38 37 30 / 0.08),
      0 2px 4px rgb(38 37 30 / 0.04),
      0 16px 32px -12px rgb(38 37 30 / 0.14),
      0 48px 96px -32px rgb(38 37 30 / 0.28);
  }
  .vb-float {
    box-shadow:
      0 0 0 1px rgb(38 37 30 / 0.06),
      0 1px 2px rgb(38 37 30 / 0.05),
      0 12px 24px -10px rgb(38 37 30 / 0.16),
      0 32px 56px -24px rgb(38 37 30 / 0.2);
  }
  /* Il cambio di motore: il nome scende di un filo e sfuma, poi risale col
     nuovo. Durate e curve dai token di movimento. */
  .vb-engine-name,
  .vb-engine-icon {
    transition:
      opacity var(--m-micro) var(--m-ease-out),
      transform var(--m-micro) var(--m-ease-out);
  }
  .is-leaving .vb-engine-name,
  .is-leaving .vb-engine-icon {
    opacity: 0;
    transform: translateY(0.18em);
  }
</style>

<script>
  // Un motore alla volta, ogni 2,6 s, per un giro solo: poi il titolo resta
  // fermo (WCAG 2.2.2: niente contenuto che si aggiorna da solo oltre il
  // primo giro). Fermo dall'inizio con prefers-reduced-motion; in pausa
  // quando la scheda non è visibile, col mouse sopra o col focus nella sezione.
  const host = document.querySelector<HTMLElement>("[data-engines]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (host && !reduce.matches) {
    const engines = JSON.parse(host.dataset.engines ?? "[]") as { name: string; logo: string }[];
    const name = host.querySelector<HTMLElement>("[data-engine-name]")!;
    const icon = host.querySelector<HTMLImageElement>("[data-engine-icon]")!;
    engines.forEach((e) => { const i = new Image(); i.src = `/img/engines/${e.logo}.svg`; });
    let n = 0;
    let steps = 0;
    let paused = false;
    const leave = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--m-micro")) || 150;
    const step = () => {
      if (paused || document.hidden) return;
      if (steps >= engines.length) { window.clearInterval(timer); return; }
      steps += 1;
      host.classList.add("is-leaving");
      window.setTimeout(() => {
        n = (n + 1) % engines.length;
        name.textContent = engines[n].name;
        icon.src = `/img/engines/${engines[n].logo}.svg`;
        host.classList.remove("is-leaving");
      }, leave);
    };
    const title = host.closest("h1")!;
    const section = title.closest("section") ?? title;
    title.addEventListener("mouseenter", () => (paused = true));
    title.addEventListener("mouseleave", () => (paused = false));
    section.addEventListener("focusin", () => (paused = true));
    section.addEventListener("focusout", () => (paused = false));
    const timer = window.setInterval(step, 2600);
  }
</script>
