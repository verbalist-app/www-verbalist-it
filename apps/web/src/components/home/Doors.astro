---
// Il doppio ingresso, subito sotto il primo viewport: l'agenzia per prima,
// poi le aziende con i loro quattro casi. Testi dalle pagine /soluzioni.
// Nella grammatica a carta avorio (dal 2026-10-17): due pannelli tinti
// affiancati, titolo e lede alla stessa misura, righe piene. Ogni pannello è
// cliccabile per intero; le righe dei casi restano link a sé.
import Logo from "@/components/assets/Logo.astro";
import { getAllSolutions } from "@/lib/data";
import Frame from "@/components/section/Frame.astro";

// Titolo della sezione (solo per la lettura assistita): diverso per pagina
const { title = "Da dove entri: agenzie o aziende" } = Astro.props;
const solutions = await getAllSolutions();
const agency = solutions.find((s) => s.data.audience === "agenzie");
const companies = solutions.filter((s) => s.data.audience !== "agenzie");
const corporate = companies.find((s) => s.data.audience === "corporate") ?? companies[0];
// Il prezzo per contenuto non si mostra in home (brief, §7.2).
const points = (agency?.data.doorPoints ?? []).filter((p) => !/costo per contenuto/i.test(p));
const label = "text-sm text-base-500";
const panel = "relative flex flex-col p-6 bg-panel rounded-md lg:p-10 group";
---

<Frame n={2} labelledby="doors-title" rhythm="open" class="lg:!px-14">
  <h2 id="doors-title" class="sr-only">{title}</h2>
  <div class="grid gap-3 lg:grid-cols-2">
    <div class={panel}>
      <p class={label}>Per le agenzie</p>
      <h3 class="mt-6 text-xl font-normal leading-snug tracking-tight text-base-900 lg:text-2xl">
        <a href={`/soluzioni/${agency?.id}/`} class="after:absolute after:inset-0">{agency?.data.doorTitle}</a>
      </h3>
      <p class="max-w-md mt-1 text-xl leading-snug tracking-tight text-base-600 text-pretty lg:text-2xl">{agency?.data.doorText}</p>
      <ul role="list" class="mt-8 text-sm text-base-800">
        {points.map((p) => (
          <li class="flex items-center py-3 border-t gap-3 border-base-200 last:border-b">
            <Logo aria-hidden="true" class="size-3 shrink-0 text-base-900" />{p}
          </li>
        ))}
      </ul>
      <p class="pt-6 mt-auto text-sm text-base-900 group-hover:opacity-75" aria-hidden="true">
        {agency?.data.doorLink} →
      </p>
    </div>
    <div class={panel}>
      <p class={label}>Per le aziende</p>
      <h3 class="mt-6 text-xl font-normal leading-snug tracking-tight text-base-900 lg:text-2xl">
        <a href={`/soluzioni/${corporate?.id}/`} class="after:absolute after:inset-0">Dalla PMI al gruppo con più mercati</a>
      </h3>
      <p class="max-w-md mt-1 text-xl leading-snug tracking-tight text-base-600 text-pretty lg:text-2xl">
        Il prodotto è lo stesso, cambia quello che ti serve intorno. Scegli il tuo caso.
      </p>
      <ul role="list" class="mt-8 text-sm">
        {companies.map((s) => (
          <li class="border-t border-base-200 last:border-b">
            <a href={`/soluzioni/${s.id}/`} class="relative z-10 flex items-baseline py-3 -mx-2 px-2 gap-4 transition-colors duration-200 rounded-md group/row min-h-11 hover:bg-base-100">
              <span class="text-base-900 whitespace-nowrap shrink-0">{s.data.name}</span>
              <span class="ml-auto text-right text-base-500">{s.data.doorTitle}</span>
              <span class="text-base-900" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="pt-6 mt-auto text-sm text-base-900 group-hover:opacity-75" aria-hidden="true">
        {corporate?.data.doorLink} →
      </p>
    </div>
  </div>
</Frame>
