---
// Anatomia di un contenuto GEO-ready: passaggi della versione B del documento
// generato in piattaforma (demo.ts), con i quattro punti che lo rendono
// citabile. Il testo non è ritoccato; i numeri rimandano alle note a fianco.
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
import { demoVersions } from "./demo";

const article = demoVersions[1];

const traits = [
  { title: "La risposta sta in apertura", text: "I motori generativi pescano dalle prime righe. Il pezzo apre con la risposta secca, il contesto arriva dopo." },
  { title: "I titoli sono domande reali", text: "I titoli ricalcano le People Also Ask di Google. Ogni sezione risponde a una domanda che la gente fa davvero." },
  { title: "Dati e confronti citabili", text: "Paragoni netti, in frasi che reggono da sole. Dove serve un dato, Verbalist lo segna con [SOURCE NEEDED] invece di inventarlo." },
  { title: "Le entità del settore", text: "Drop, tallone, avampiede: i termini che i modelli collegano al topic. Se mancano, il contenuto resta fuori dalle risposte." },
];
const mark = "px-1 -mx-0.5 rounded-sm bg-base-100 text-base-900 box-decoration-clone";
const ref = "ml-1 font-mono text-xs text-accent-600";
const label = "font-mono text-xs tracking-wider uppercase text-base-500";
const tag = "px-1 font-mono text-xs rounded-sm bg-base-100 text-base-600";
---

<Frame n={6} labelledby="anatomy-title" class="py-14 lg:py-20 lg:!px-14">
  <Head tag="GEO" id="anatomy-title">
    <Fragment slot="title">
      Le AI non leggono le pagine. Ne estraggono
      risposte.
    </Fragment>
    <p>GEO vuol dire scrivere perché quelle risposte citino te. Ogni contenuto di Verbalist nasce già con i pezzi che i motori generativi cercano.</p>
  </Head>

  <div class="grid mt-12 gap-10 lg:mt-16 lg:grid-cols-2 lg:gap-16 lg:items-center">
    <article aria-label="Estratto annotato della versione B, generata da Verbalist" class="p-6 bg-white border rounded-xl border-base-200 sm:p-8">
      <div data-nosnippet>
      <p class={label}>Estratto · {article.label}</p>
      <h3 class="mt-3 text-xl font-normal tracking-tight text-base-900">{article.h1}</h3>
      <p class="mt-4 text-sm leading-relaxed text-base-700">
        <mark class={mark} data-mark="1">Capire come scegliere le scarpe da running significa abbinare la scarpa al piede, al tipo di corsa e al terreno, non inseguire il modello più costoso o più pubblicizzato.</mark><sup class={ref}>1</sup>
      </p>
      <p class="mt-4 font-mono text-xs text-base-500" aria-hidden="true">[…]</p>
      <p class="mt-4 text-sm font-medium text-base-900">
        <mark class={mark} data-mark="2">Che cos’è il drop e come sceglierlo?</mark><sup class={ref}>2</sup>
      </p>
      <p class="mt-2 text-sm leading-relaxed text-base-700">
        Il <mark class={mark} data-mark="4">drop</mark> è la differenza di altezza tra <mark class={mark} data-mark="4">tallone</mark> e <mark class={mark} data-mark="4">avampiede</mark>.<sup class={ref}>4</sup>
        <mark class={mark} data-mark="3">Non coincide con l’altezza totale della scarpa: due modelli possono avere lo stesso drop ma quantità di materiale molto diverse.</mark><sup class={ref}>3</sup>
        Un cambio marcato può spostare il lavoro percepito tra polpaccio, caviglia, ginocchio e anca <span class={tag}>[SOURCE NEEDED]</span>.
      </p>
      </div>
    </article>
    <ol role="list">
      {
        traits.map((t, i) => (
          <li class="flex py-5 border-t border-dashed gap-5 border-base-200 last:border-b transition-colors duration-200 vb-note" data-note={i + 1} tabindex="0">
            <span class="font-mono text-xs leading-6 text-accent-600">{i + 1}</span>
            <div>
              <h3 class="text-base text-base-900">{t.title}</h3>
              <p class="mt-1 text-md leading-relaxed text-base-600">{t.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Frame>

<style>
  .vb-note { cursor: default; }
  .vb-note.is-on, .vb-note:hover, .vb-note:focus-visible { background: var(--color-base-50); }
  mark[data-mark].is-on { background: var(--color-base-200); box-shadow: 0 0 0 2px var(--color-base-200); }
  mark[data-mark] { transition: background-color 0.2s, box-shadow 0.2s; }
</style>

<script>
  // Nota ↔ passaggio: passare su una nota accende il punto dell'articolo che
  // la dimostra, e viceversa. È la relazione che rende leggibile la GEO.
  const notes = document.querySelectorAll<HTMLElement>("[data-note]");
  const marks = document.querySelectorAll<HTMLElement>("mark[data-mark]");
  const light = (n: string | null) => {
    notes.forEach((x) => x.classList.toggle("is-on", x.dataset.note === n));
    marks.forEach((m) => m.classList.toggle("is-on", m.dataset.mark === n));
  };
  notes.forEach((n) => {
    ["mouseenter", "focus"].forEach((ev) => n.addEventListener(ev, () => light(n.dataset.note!)));
    ["mouseleave", "blur"].forEach((ev) => n.addEventListener(ev, () => light(null)));
  });
  marks.forEach((m) => {
    m.addEventListener("mouseenter", () => light(m.dataset.mark!));
    m.addEventListener("mouseleave", () => light(null));
  });
</script>
