---
// Le capacità che la catena non racconta da sola. Testi allineati a help
// center e pagine agenti: niente claim nuovi.
import Frame from "@/components/section/Frame.astro";
import List from "@/components/fundations/icons/List.astro";
import Filters from "@/components/fundations/icons/Filters.astro";
import Stacked from "@/components/fundations/icons/Stacked.astro";

const items = [
  { Icon: List, title: "30+ lingue, scritte e non tradotte", text: "Il testo nasce nella lingua del mercato, analizzando i competitor locali: titoli e meta tag compresi." },
  { Icon: Filters, title: "Anche i contenuti che hai già", text: "Incolli un testo, un URL o un PDF e Verbalist lo rivede a confronto con le pagine che oggi ti stanno davanti." },
  { Icon: Stacked, title: "Due versioni, due modelli", text: "Ogni generazione produce due versioni del testo, scritte da due modelli diversi. Le vedi qui sotto, intere." },
];
---

<Frame n={4} id="funzionalita" labelledby="beyond-title" rhythm="open" class="lg:!px-14">
  <h2 id="beyond-title" class="sr-only">Intorno alla catena</h2>
  <div class="grid gap-3 md:grid-cols-3">
    {
      items.map(({ Icon, title, text }) => (
        <div class="p-6 bg-panel rounded-md lg:p-10">
          <Icon class="size-5 text-accent-600" aria-hidden="true" />
          <h3 class="mt-10 text-xl font-normal leading-snug text-base-900 text-balance">{title}</h3>
          <p class="mt-1 text-xl leading-snug text-base-600 text-pretty">{text}</p>
        </div>
      ))
    }
  </div>
</Frame>
