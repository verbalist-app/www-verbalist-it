---
// Prezzi: i tre piani dalla fonte unica (lib/pricing). In home non si mostra
// il prezzo per contenuto (brief, §7.2). Sotto ogni CTA la sua rassicurazione.
import Logo from "@/components/assets/Logo.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
import { pricingOptions } from "@/lib/pricing";

const plans = pricingOptions.map((p) => ({
  ...p,
  trial: p.button.href.includes("registration"),
  // voce del brand: niente anglicismi di servizio
  features: p.features.map((f) => f.replace("Onboarding white-glove", "Onboarding guidato")),
}));
// grammatica a carta avorio (dal 2026-10-17): tre card tinte, il piano
// consigliato un tono più scuro con la targhetta a pillola.
---

<Frame n={8} id="prezzi" labelledby="plans-title" rhythm="section" class="lg:!px-14">
  <Head tag="Prezzi" id="plans-title">
    <Fragment slot="title">
      Paghi una volta, per quanto
      produci.
    </Fragment>
    <p>Nessun abbonamento: scegli il volume di contenuti e li usi entro 12 mesi. Le funzionalità sono le stesse in ogni piano.</p>
  </Head>

  <div class="grid gap-3 mt-10 lg:mt-14 lg:grid-cols-3">
    {
      plans.map((plan) => (
        <article class={`flex flex-col p-6 rounded-md lg:p-10 ${plan.isPopular ? "bg-base-100" : "bg-panel"}`}>
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-normal text-base-900">{plan.title}</h3>
            {plan.isPopular && <span class="inline-flex items-center h-6 px-2.5 text-xs border rounded-full border-current text-base-900">Consigliato</span>}
          </div>
          <p class="mt-6 text-[2.75rem] leading-none font-normal tracking-[-0.03em] text-base-900 tabular-nums">
            {plan.price.startsWith("€") ? <>{plan.price.slice(1)}<span class="ml-1 text-2xl text-base-500">€</span></> : <span class="text-display-xs">{plan.price}</span>}
          </p>
          <p class="mt-2 text-sm text-base-500">{plan.period || "volume su misura"}</p>
          <p class="mt-4 text-md leading-relaxed text-base-600 min-h-10">{plan.description}</p>
          <ul role="list" class="mt-6 mb-10 text-sm text-base-800">
            {plan.features.map((f) => (
              <li class="flex items-start py-3 border-t gap-3 border-base-200 last:border-b">
                <Logo aria-hidden="true" class="size-2.5 shrink-0 text-base-900 mt-1.5" />{f}
              </li>
            ))}
          </ul>
          <div class="flex flex-col items-start mt-auto gap-3">
            {plan.trial ? (
              <>
                <Button isLink size="base" variant={plan.isPopular ? "accent" : "muted"} href={plan.button.href}>Prova gratis</Button>
                <p class="text-xs text-base-500">30 giorni, 15 documenti, senza carta di credito.</p>
              </>
            ) : (
              <>
                <Button isLink size="base" variant="muted" href="/contatti/">Parla con noi</Button>
                <p class="text-xs text-base-500">Volume, utenti e onboarding su misura.</p>
              </>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Frame>
