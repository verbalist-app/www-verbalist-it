---
// Chiusura nella grammatica di cursor.com (dal 2026-10-17): il titolo
// grande al centro, una sola pillola sotto, con la sua rassicurazione.
import Button from "@/components/fundations/elements/Button.astro";
import Frame from "@/components/section/Frame.astro";
import { TRIAL_HREF } from "@/lib/pricing";
---

<Frame n={10} labelledby="close-title" rhythm="close" class="lg:!px-14">
  <div class="flex flex-col items-center text-center">
    <h2 id="close-title" class="text-[2.75rem] leading-[1.06] font-normal tracking-[-0.03em] text-base-900 sm:text-hero-sm lg:text-hero">
      Provalo sui tuoi contenuti.
    </h2>
    <p class="max-w-md mt-6 text-lg leading-snug text-base-600">
      Tutte le funzionalità per 30 giorni, con 15 documenti inclusi e senza carta di credito.
    </p>
    <div class="flex mt-8">
      <Button isLink size="base" variant="accent" href={TRIAL_HREF}>Prova gratis</Button>
    </div>
  </div>
</Frame>
