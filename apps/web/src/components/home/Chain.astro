---
// La catena dei quattro agenti come griglia di celle: in alto il pezzo
// dell'app che sfuma, sotto numero, nome, riassunto e link all'agente. Su
// desktop una linea d'inchiostro corre sul bordo alto e accende una cella
// alla volta (in vista, in loop con pausa). Nomi, ruoli e testi dalla
// collection `agents`. Il pezzo dell'app è ChainFragment.
// Senza movimento: l'analisi resta accesa.
import { getCollection } from "astro:content";
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
import ChainFragment from "./ChainFragment.astro";

// Il pezzo di prodotto mostrato in ogni nodo, dal campo `mockup` dell'agente.
const fragment = { brief: "brief", serp: "serp", article: "write", "export": "export" } as const;

const agents = (await getCollection("agents")).sort((a, b) => a.data.n.localeCompare(b.data.n));
const facts = [
  "I primi 5 risultati di Google, o fino a 5 URL scelti da te",
  "Due versioni complete, scritte da due modelli",
  "HTML con title tag, meta description, slug e alt text",
];
---

<Frame n={3} id="agenti" labelledby="chain-title" class="py-14 lg:py-20 lg:!px-14">
  <Head tag="Quattro agenti" id="chain-title">
    <Fragment slot="title">
      Una catena di quattro agenti, non un
      prompt.
    </Fragment>
    <p>Ogni agente consegna il suo lavoro al successivo. Il tuo serve una volta sola, all'inizio: compili un brief, non scrivi un prompt.</p>
  </Head>

  <div class="relative p-4 mt-12 bg-white border rounded-xl border-base-200 sm:p-8 lg:mt-16 lg:p-10 vb-chain" data-chain>
    <span aria-hidden="true" class="absolute w-2 h-2 border-t border-l top-2 left-2 border-base-300"></span>
    <span aria-hidden="true" class="absolute w-2 h-2 border-t border-r top-2 right-2 border-base-300"></span>
    <span aria-hidden="true" class="absolute w-2 h-2 border-b border-l bottom-2 left-2 border-base-300"></span>
    <span aria-hidden="true" class="absolute w-2 h-2 border-b border-r bottom-2 right-2 border-base-300"></span>
    <div class="flex items-center justify-between mb-6 font-mono text-xs tracking-wider uppercase text-base-500">
      <span class="flex items-center gap-2"><span class="rounded-full size-1.5 bg-accent-500"></span>Un documento, quattro passaggi</span>
      <button type="button" class="inline-flex items-center h-8 gap-1.5 hover:text-base-900" data-chain-toggle aria-pressed="false">
        <svg viewBox="0 0 12 12" class="size-2.5" fill="currentColor" aria-hidden="true"><path data-icon-pause d="M2 1h3v10H2zM7 1h3v10H7z"></path><path data-icon-play class="hidden" d="M2.5 1l8 5-8 5z"></path></svg>
        <span data-chain-label>Ferma</span>
      </button>
    </div>
    <ol role="list" class="relative grid overflow-hidden border rounded-xl border-base-200 sm:grid-cols-2 lg:grid-cols-4 vb-cells">
      <span aria-hidden="true" class="absolute inset-x-0 top-0 z-10 hidden h-px bg-base-900 lg:block vb-ink" data-m-ink></span>
      {
        agents.map((agent, i) => (
          <li class="relative flex flex-col vb-node" data-node={i}>
            <span aria-hidden="true" class="absolute inset-0 opacity-0 pointer-events-none bg-base-50" data-m-on></span>
            <span aria-hidden="true" data-nosnippet class="relative block overflow-hidden h-36 lg:h-44 [--vb-zoom:0.56] lg:[--vb-zoom:0.6] vb-peek">
              <span class="absolute block top-5 left-5 lg:top-6 lg:left-6 vb-peek-card">
                <ChainFragment step={fragment[agent.data.mockup as keyof typeof fragment] ?? "brief"} />
              </span>
            </span>
            <span class="relative flex flex-col px-5 pt-2 pb-6 lg:px-6 grow">
              <span class="font-mono text-xs tracking-wider text-base-500">{agent.data.n} <span aria-hidden="true" class="inline-block opacity-0 text-status-success" data-m-tick>✓</span></span>
              <span class="mt-2 text-base leading-snug text-base-900">{agent.data.name}</span>
              <span class="mt-1 mb-5 text-[15px] leading-relaxed text-base-600">{agent.data.summary}</span>
              <a href={`/agenti/${agent.id}/`} class="self-start inline-flex items-center h-8 mt-auto text-sm transition-colors duration-200 rounded-full px-3.5 whitespace-nowrap bg-base-100 text-base-900 hover:bg-base-200">
                Vedi l'agente<span class="sr-only">: {agent.data.name}</span>
              </a>
            </span>
          </li>
        ))
      }
    </ol>
    <ul role="list" class="grid pt-6 mt-8 text-xs border-t border-dashed gap-3 border-base-200 text-base-600 sm:grid-cols-3">
      {facts.map((f) => (
        <li class="flex items-start gap-2"><span class="mt-1.5 rounded-full size-1.5 bg-accent-500 shrink-0"></span>{f}</li>
      ))}
    </ul>
  </div>
</Frame>

<script>
  // La catena al lavoro, un solo movimento: la linea d'inchiostro corre sul
  // bordo alto delle celle e accende un nodo alla volta; il nodo finito prende
  // la spunta accanto al numero.
  // Solo da lg in su, in loop mentre è in vista, con Ferma/Riprendi.
  // Sotto lg e con prefers-reduced-motion: stato statico (analisi accesa).
  import { animate } from "motion";
  import { D, E, exit, reduced } from "@/lib/motion";

  type Seg = [Element | Element[], Record<string, unknown>, Record<string, unknown>];
  const chain = document.querySelector<HTMLElement>("[data-chain]");

  if (chain) {
    const $ = <T extends Element = HTMLElement>(root: ParentNode, sel: string) => root.querySelector<T>(sel)!;
    const $$ = <T extends Element = HTMLElement>(root: ParentNode, sel: string) => Array.from(root.querySelectorAll<T>(sel));
    const nodes = $$(chain, "[data-node]");
    const ink = $(chain, "[data-m-ink]");
    const upTo = (i: number) => `inset(0 ${100 - ((i + 1) / 4) * 100}% 0 0)`;
    const toggle = $<HTMLButtonElement>(chain, "[data-chain-toggle]");
    const desktop = window.matchMedia("(min-width: 1024px)");
    const HOLD = 1.2; // quanto resta acceso un nodo prima della spunta
    const WIRE = 0.55; // la linea da una cella alla successiva

    const still = () => {
      nodes.forEach((n, i) => { n.classList.toggle("is-on", i === 1); n.classList.toggle("is-past", i < 1); });
    };

    const loop = () => {
      const seq: Seg[] = [];
      const on = nodes.map((n) => $$(n, "[data-m-on]"));
      const ticks = nodes.map((n) => $(n, "[data-m-tick]"));
      seq.push([ink, { clipPath: "inset(0 100% 0 0)" }, { duration: 0.001, at: 0 }]);
      seq.push([on.flat(), { opacity: 0 }, { duration: 0.001, at: 0 }]);
      seq.push([ticks, { opacity: 0, scale: 0.6 }, { duration: 0.001, at: 0 }]);
      let t = 0.3;
      nodes.forEach((_, i) => {
        seq.push([on[i], { opacity: 1 }, { duration: D.base, ease: E.in, at: t }]);
        seq.push([ink, { clipPath: upTo(i) }, { duration: WIRE, ease: E.move, at: t }]);
        t += D.base + HOLD;
        seq.push([ticks[i], { opacity: 1, scale: 1 }, { duration: D.micro, ease: E.in, at: t }]);
        t += D.micro;
        if (i < nodes.length - 1) {
          seq.push([on[i], { opacity: 0 }, { duration: exit(D.base), ease: E.out, at: t }]);
          t += D.micro;
        }
      });
      t += 2; // le quattro spunte restano visibili, poi si riparte
      const o = { duration: exit(D.base), ease: E.out, at: t };
      seq.push([on[nodes.length - 1], { opacity: 0 }, o]);
      seq.push([ticks, { opacity: 0 }, o]);
      seq.push([ink, { clipPath: "inset(0 100% 0 0)" }, o]);
      return animate(seq as never, { repeat: Infinity });
    };

    let controls: ReturnType<typeof animate> | null = null;
    let io: IntersectionObserver | null = null;
    let userPaused = false, inView = false;

    const setLabel = () => {
      toggle.setAttribute("aria-pressed", String(userPaused));
      $(toggle, "[data-chain-label]").textContent = userPaused ? "Riprendi" : "Ferma";
      $(toggle, "[data-icon-pause]").classList.toggle("hidden", userPaused);
      $(toggle, "[data-icon-play]").classList.toggle("hidden", !userPaused);
    };

    const setup = () => {
      controls?.cancel(); controls = null;
      io?.disconnect(); io = null;
      if (reduced() || !desktop.matches) {
        toggle.hidden = true;
        still();
        return;
      }
      toggle.hidden = false;
      nodes.forEach((n) => n.classList.remove("is-on", "is-past"));
      controls = loop();
      controls.pause(); controls.time = 0;
      io = new IntersectionObserver(([e]) => {
        inView = e.isIntersecting;
        if (inView && !userPaused && !document.hidden) controls?.play();
        else controls?.pause();
      }, { threshold: 0.4 });
      io.observe(chain);
    };

    toggle.addEventListener("click", () => {
      userPaused = !userPaused;
      setLabel();
      if (userPaused) controls?.pause();
      else if (inView && !document.hidden) controls?.play();
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) controls?.pause();
      else if (inView && !userPaused) controls?.play();
    });
    desktop.addEventListener("change", setup);
    setup();
  }
</script>
<style>
  /* Righe tra le celle: verticali da sm, orizzontali sotto */
  .vb-cells > li + li { border-top: 1px solid var(--color-base-200); }
  @media (min-width: 40rem) {
    .vb-cells > li + li { border-top: 0; }
    .vb-cells > li:nth-of-type(odd) { border-right: 1px solid var(--color-base-200); }
    .vb-cells > li:nth-of-type(n + 3) { border-top: 1px solid var(--color-base-200); }
  }
  @media (min-width: 64rem) {
    .vb-cells > li:nth-of-type(n) { border-top: 0; border-right: 1px solid var(--color-base-200); }
    .vb-cells > li:last-of-type { border-right: 0; }
  }
  /* Linea d'inchiostro sul bordo alto: rivelata da clip-path */
  .vb-ink { clip-path: inset(0 100% 0 0); }
  /* Stato statico (prefers-reduced-motion, mobile): analisi accesa, keyword fatta */
  .vb-node.is-on { background: var(--color-base-50); }
  .vb-node.is-past [data-m-tick] { opacity: 1; }
  [data-chain-toggle]:focus-visible { outline: 2px solid var(--color-base-900); outline-offset: 2px; border-radius: 999px; }
</style>
