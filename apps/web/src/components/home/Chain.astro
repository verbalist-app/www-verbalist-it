---
// I quattro agenti come quattro card (composizione del blocco "Feature" di
// Craft): la testa di sezione, poi una riga di card con icona, numero, nome,
// riassunto e "Vedi l'agente →", tutta la card cliccabile. Nomi, riassunti e
// icone dalla collection `agents`. Statico: la catena animata con le finestre
// dell'app è stata ritirata il 2026-10-11 (i pezzi di prodotto restano in
// ChainFragment.astro per le pagine soluzione).
import { getCollection } from "astro:content";
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
import Search from "@/components/fundations/icons/Search.astro";
import Analytics from "@/components/fundations/icons/Analytics.astro";
import Brain from "@/components/fundations/icons/Brain.astro";
import Stacked from "@/components/fundations/icons/Stacked.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";

const icons = { search: Search, analytics: Analytics, brain: Brain, stacked: Stacked } as const;
const agents = (await getCollection("agents")).sort((a, b) => a.data.n.localeCompare(b.data.n));
---

<Frame n={3} id="agenti" labelledby="chain-title" class="py-14 lg:py-20 lg:!px-14">
  <Head tag="Quattro agenti" id="chain-title">
    <Fragment slot="title">
      Una catena di quattro agenti, non un
      prompt.
    </Fragment>
    <p>Ogni agente consegna il suo lavoro al successivo. Il tuo serve una volta sola, all'inizio: compili un brief, non scrivi un prompt.</p>
  </Head>
  <ol role="list" class="grid gap-4 mt-12 sm:grid-cols-2 lg:grid-cols-4 lg:mt-16">
    {
      agents.map((agent) => {
        const Icon = icons[agent.data.icon as keyof typeof icons] ?? Search;
        return (
          <li class="relative flex flex-col justify-between p-6 bg-white border rounded-xl gap-8 group border-base-200 transition-colors duration-200 hover:border-base-400">
            <div class="grid gap-4">
              <Icon size="md" class="text-base-900" />
              <h3 class="text-xl leading-snug text-base-900">
                <span class="block mb-1 font-mono text-xs tracking-wider text-base-500">{agent.data.n}</span>
                <a href={`/agenti/${agent.id}/`} class="after:absolute after:inset-0">{agent.data.name}</a>
              </h3>
              <p class="text-md leading-relaxed text-base-600">{agent.data.summary}</p>
            </div>
            <p class="flex items-center text-sm text-base-900 gap-1" aria-hidden="true">
              Vedi l'agente<ChevronRight size="sm" class="duration-300 ease-out text-accent-500 group-hover:translate-x-1" />
            </p>
          </li>
        );
      })
    }
  </ol>
</Frame>
