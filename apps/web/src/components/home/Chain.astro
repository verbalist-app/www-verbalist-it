---
// La catena dei quattro agenti come schema: quattro scatole collegate da
// connettori tratteggiati lungo cui scorre la corrente; la scatola attiva
// segue la corrente (in vista, in loop con pausa). Nomi, ruoli e testi dalla
// collection `agents`. In fondo a ogni nodo, un pezzo dell'app (ChainFragment).
// Senza movimento: l'analisi resta accesa.
import { getCollection } from "astro:content";
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
import ChainFragment from "./ChainFragment.astro";

// Il pezzo di prodotto mostrato in ogni nodo, dal campo `mockup` dell'agente.
const fragment = { brief: "brief", serp: "serp", article: "write", "export": "export" } as const;

const agents = (await getCollection("agents")).sort((a, b) => a.data.n.localeCompare(b.data.n));
const facts = [
  "I primi 5 risultati di Google, o fino a 5 URL scelti da te",
  "Due versioni complete, scritte da due modelli",
  "HTML con title tag, meta description, slug e alt text",
];
const io = ["Keyword + contesto", "Mappa degli argomenti", "Testo A e B", "HTML per il CMS"];
---

<Frame n={3} id="agenti" labelledby="chain-title" class="py-14 lg:py-20 lg:!px-14">
  <Head tag="Quattro agenti" id="chain-title">
    <Fragment slot="title">
      Una catena di quattro agenti, non un
      prompt.
    </Fragment>
    <p>Ogni agente consegna il suo lavoro al successivo. Il tuo serve una volta sola, all'inizio: compili un brief, non scrivi un prompt.</p>
  </Head>

  <div class="relative p-4 mt-12 bg-white border rounded-xl border-base-200 sm:p-8 lg:mt-16 lg:p-10 vb-chain" data-chain>
    <span aria-hidden="true" class="absolute w-2 h-2 border-t border-l top-2 left-2 border-base-300"></span>
    <span aria-hidden="true" class="absolute w-2 h-2 border-t border-r top-2 right-2 border-base-300"></span>
    <span aria-hidden="true" class="absolute w-2 h-2 border-b border-l bottom-2 left-2 border-base-300"></span>
    <span aria-hidden="true" class="absolute w-2 h-2 border-b border-r bottom-2 right-2 border-base-300"></span>
    <div class="flex items-center justify-between mb-6 font-mono text-xs tracking-wider uppercase text-base-500">
      <span class="flex items-center gap-2"><span class="rounded-full size-1.5 bg-accent-500"></span>Un documento, quattro passaggi</span>
      <button type="button" class="inline-flex items-center h-8 gap-1.5 hover:text-base-900" data-chain-toggle aria-pressed="false">
        <svg viewBox="0 0 12 12" class="size-2.5" fill="currentColor" aria-hidden="true"><path data-icon-pause d="M2 1h3v10H2zM7 1h3v10H7z"></path><path data-icon-play class="hidden" d="M2.5 1l8 5-8 5z"></path></svg>
        <span data-chain-label>Ferma</span>
      </button>
    </div>
    <ol role="list" class="grid gap-3 lg:grid-cols-4 lg:gap-0">
      {
        agents.map((agent, i) => (
          <li class="relative flex lg:items-stretch">
            <a
              href={`/agenti/${agent.id}/`}
              data-node={i}
              class="flex flex-col w-full overflow-hidden bg-white border rounded-2xl border-base-200 vb-node transition-[border-color,background-color,box-shadow] duration-300 hover:border-accent-400"
            >
              <span class="flex flex-col p-5 pb-0 grow">
                <span class="font-mono text-xs tracking-wider uppercase text-base-500 vb-node-label">
                  {agent.data.n} · {agent.data.role}
                </span>
                <span class="mt-3 text-base leading-snug text-base-900 vb-node-title">{agent.data.name}</span>
                <span class="mt-2 text-xs leading-relaxed text-base-600">{agent.data.summary}</span>
                <span class="pt-3 mt-auto font-mono text-xs border-t border-dashed border-base-200 text-base-500">→ {io[i]}</span>
              </span>
              <span aria-hidden="true" data-nosnippet class="relative block h-28 mt-4 overflow-hidden vb-fragment [--vb-zoom:0.56] lg:h-40 lg:[--vb-zoom:0.66]">
                <span class="absolute block top-3 left-5 vb-fragment-card">
                  <ChainFragment step={fragment[agent.data.mockup as keyof typeof fragment] ?? "brief"} />
                </span>
              </span>
            </a>
            {i < agents.length - 1 && (
              <span aria-hidden="true" class="items-center hidden w-8 shrink-0 lg:flex">
                <svg viewBox="0 0 32 8" class="w-full h-2 overflow-visible" fill="none">
                  <path d="M0 4H30" class="vb-wire" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" />
                  <path d="M27 1l3 3-3 3" class="vb-wire-tip" stroke="currentColor" stroke-width="1" />
                </svg>
              </span>
            )}
          </li>
        ))
      }
    </ol>
    <ul role="list" class="grid pt-6 mt-8 text-xs border-t border-dashed gap-3 border-base-200 text-base-600 sm:grid-cols-3">
      {facts.map((f) => (
        <li class="flex items-start gap-2"><span class="mt-1.5 rounded-full size-1.5 bg-accent-500 shrink-0"></span>{f}</li>
      ))}
    </ul>
  </div>
</Frame>

<style>
  .vb-chain { --wire: var(--color-base-300); }
  .vb-wire, .vb-wire-tip { color: var(--wire); transition: color 0.4s; }
  .vb-node.is-on { border-color: var(--color-base-900); background: var(--color-base-50); box-shadow: 0 0 0 3px var(--color-base-100); }
  .vb-node.is-on .vb-node-label, .vb-node.is-on .vb-node-title { color: var(--color-base-900); }
  .vb-node.is-past { border-color: var(--color-base-300); }
  .vb-node.is-past .vb-node-label::before { content: "✓ "; color: var(--color-status-success); }
  /* Il pezzo di prodotto esce dal nodo in basso e a destra, dissolvendosi. */
  .vb-fragment {
    background: radial-gradient(90% 90% at 60% 110%, var(--color-wash-warm) 0, transparent 70%);
  }
  .vb-fragment-card { box-shadow: 0 0 0 1px rgb(22 27 29 / 0.06), 0 1px 2px rgb(22 27 29 / 0.05), 0 16px 32px -14px rgb(22 27 29 / 0.22); border-radius: 0.75rem; }
  .vb-chain.is-live .vb-wire.is-on { animation: vb-flow 0.6s linear infinite; }
  .vb-chain.is-live .vb-wire.is-on, .vb-chain.is-live .vb-wire-tip.is-on { color: var(--color-accent-500); }
  @keyframes vb-flow { to { stroke-dashoffset: -6; } }
  @media (prefers-reduced-motion: reduce) {
    .vb-chain .vb-wire { animation: none !important; }
  }
</style>

<script>
  // La corrente attraversa la catena: nodo acceso → scintilla sul connettore →
  // nodo successivo. In loop finché è in vista, con pausa.
  const chain = document.querySelector<HTMLElement>("[data-chain]");
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (chain) {
    const nodes = Array.from(chain.querySelectorAll<HTMLElement>("[data-node]"));
    const wires = Array.from(chain.querySelectorAll<SVGElement>(".vb-wire"));
    const tips = Array.from(chain.querySelectorAll<SVGElement>(".vb-wire-tip"));
    const toggle = chain.querySelector<HTMLButtonElement>("[data-chain-toggle]");
    const still = () => {
      nodes.forEach((n, i) => { n.classList.toggle("is-on", i === 1); n.classList.toggle("is-past", i < 1); });
      wires.forEach((w) => w.classList.remove("is-on")); tips.forEach((t) => t.classList.remove("is-on"));
    };
    if (calm.matches) { still(); toggle?.remove(); }
    else {
      let run = 0, paused = false, visible = false;
      const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
      const alive = (id: number) => id === run && !paused && visible;
      const play = async () => {
        const id = ++run;
        chain.classList.add("is-live");
        while (alive(id)) {
          for (let i = 0; i < nodes.length; i++) {
            if (!alive(id)) return;
            nodes.forEach((n, k) => { n.classList.toggle("is-on", k === i); n.classList.toggle("is-past", k < i); });
            wires.forEach((w, k) => w.classList.toggle("is-on", k === i - 1));
            tips.forEach((t, k) => t.classList.toggle("is-on", k === i - 1));
            await wait(i === 1 ? 2200 : 1500);
          }
          if (!alive(id)) return;
          await wait(1600);
        }
      };
      const stop = () => { run++; chain.classList.remove("is-live"); still(); };
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible && !paused) play(); else stop(); }, { threshold: 0.35 }).observe(chain);
      document.addEventListener("visibilitychange", () => { if (document.hidden) stop(); else if (visible && !paused) play(); });
      toggle?.addEventListener("click", () => {
        paused = !paused;
        toggle.setAttribute("aria-pressed", String(paused));
        toggle.querySelector("[data-chain-label]")!.textContent = paused ? "Riprendi" : "Ferma";
        toggle.querySelector("[data-icon-pause]")!.classList.toggle("hidden", paused);
        toggle.querySelector("[data-icon-play]")!.classList.toggle("hidden", !paused);
        if (paused) stop(); else play();
      });
      still();
    }
  }
</script>
