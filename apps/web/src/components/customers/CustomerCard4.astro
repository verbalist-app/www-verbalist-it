---
// Cella di caso studio nell'indice /clienti: logo e settore in testa, poi il
// numero del caso (frontmatter `figure`) come titolo e il link in fondo. Con
// `featured` la cella sta a tutta larghezza: numero a sinistra, la riga
// `partnership` e il link a destra. Senza `figure` il titolo è il primo
// risultato con un numero.
import { svgSize } from "@/lib/svgSize";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import type { Customer } from "@/lib/data";

interface Props {
  post: Customer;
  index?: number;
  featured?: boolean;
  class?: string;
}
const { post, index = 0, featured = false, class: className = "" } = Astro.props;
const { customer, results, figure, sector, partnership } = post.data;
const logo = post.data.logo.url as string;
const url = `/clienti/${post.slug}/`;
const fact = results.find((r) => /\d|trentina|ventina/.test(r)) ?? results[0];
const link = "pt-6 text-sm text-base-900 after:absolute after:inset-0 group-hover:text-accent-600";
---

<article
  class:list={[
    "relative px-4 py-8 group transition-colors duration-200 hover:bg-base-50",
    featured ? "lg:grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-x-16 lg:px-14 lg:py-14" : "flex flex-col lg:px-8 lg:py-10",
    className,
  ]}
>
  <div class:list={["flex items-center justify-between gap-4", featured && "lg:col-span-2"]}>
    <img src={logo} alt="" {...svgSize(logo, 20)} loading={index < 3 ? "eager" : "lazy"} class="object-contain object-left w-auto h-5 max-w-28 grayscale opacity-70" />
    {sector && <p class="font-mono text-xs tracking-wider uppercase text-base-500">{sector}</p>}
  </div>
  <h2 class="mt-10 text-base-900 text-balance">
    {
      figure ? (
        <>
          <span class:list={["block leading-none tracking-[-0.025em]", featured ? "text-display lg:text-hero" : "text-display-xs lg:text-display"]}>{figure.value}</span>
          <span class="block max-w-xs mt-3 text-md font-normal leading-relaxed text-base-600">{figure.label}</span>
        </>
      ) : (
        <span class="text-2xl tracking-tight">{fact}</span>
      )
    }
  </h2>
  <div class:list={["flex flex-col", featured ? "lg:mt-10 lg:self-end" : "mt-auto"]}>
    {featured && partnership && <p class="max-w-md text-md leading-relaxed text-base-600 max-lg:hidden">{partnership}</p>}
    <p class={featured ? "lg:pt-6" : ""}>
      <a href={url} class={link}>
        Leggi il caso {customer}{"\u00a0"}<ChevronRight size="sm" class="inline-block align-[-3px] duration-300 ease-out text-accent-500 group-hover:translate-x-1" />
      </a>
    </p>
  </div>
</article>
