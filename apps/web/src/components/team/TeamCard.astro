---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
const { url, name, image, role } = {
  url: "/team/" + Astro.props.post.slug + "/",
  name: Astro.props.post.data.name,
  role: Astro.props.post.data.role,
  image: Astro.props.post.data.image.url,
};
---

<div class="relative flex flex-col items-center text-center gap-4 group">
  <a
    href={url}
    title={`Vedi il profilo di ${name}`}
    aria-label={`Vedi il profilo di ${name}`}
    class="absolute inset-0 z-10"></a>

  <Image
    width="800"
    height="800"
    src={image}
    alt={name}
    loading="eager"
    class="object-cover size-28 rounded-xl bg-mist-100"
  />

  <div>
    <Text
      tag="h2"
      variant="textBase"
      class="font-medium text-base-900 transition-colors duration-300 group-hover:text-accent-500"
    >
      {name}
    </Text>
    <Text tag="p" variant="textXS" class="text-base-500">
      {role}
    </Text>
  </div>
</div>
