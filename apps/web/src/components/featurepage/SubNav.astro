---
// Sotto-navigazione delle pagine "feature" (agenti, soluzioni), sul modello
// delle feature page di Profound: una riga sotto la nav principale con le
// pagine sorelle sempre in vista e quella corrente evidenziata.
// items: [{ href, label, n? }] · current: href della pagina corrente.
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

interface Item {
  href: string;
  label: string;
  n?: string;
}
interface Props {
  label: string; // aria-label della nav
  home: { href: string; label: string }; // voce di testa: la sezione
  items: Item[];
  current: string;
}
const { label, home, items, current } = Astro.props;
---

<div class="pt-[4.5rem] md:pt-[4.0625rem] border-b border-dashed border-base-200">
  <Wrapper variant="standard" class="py-0">
    <nav
      aria-label={label}
      class="flex items-center -mx-4 overflow-x-auto scrollbar-hide 2xl:-mx-12"
    >
      <a
        href={home.href}
        class="px-4 py-3.5 font-mono text-xs font-medium tracking-wider uppercase shrink-0 text-base-500 transition-colors duration-200 hover:text-base-950 2xl:pl-12"
      >
        {home.label}
      </a>
      {
        items.map((item) => {
          const active = item.href === current;
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex items-baseline gap-2 px-4 py-3.5 text-sm shrink-0 border-l border-dashed border-base-200 transition-colors duration-200",
                active
                  ? "font-medium text-base-950"
                  : "text-base-500 hover:text-base-950",
              ]}
            >
              {item.n && (
                <span
                  class:list={[
                    "font-mono text-xs",
                    active ? "text-base-600" : "text-base-400",
                  ]}
                >
                  {item.n}
                </span>
              )}
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </Wrapper>
</div>
