---
// Sotto-navigazione delle pagine "feature" (agenti, soluzioni): una riga sotto
// la nav principale con le pagine sorelle sempre in vista, voci a pillola e
// quella corrente piena.
// items: [{ href, label, n? }] · current: href della pagina corrente.
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

interface Item {
  href: string;
  label: string;
  n?: string;
}
interface Props {
  label: string; // aria-label della nav
  home: { href: string; label: string }; // voce di testa: la sezione
  items: Item[];
  current: string;
}
const { label, home, items, current } = Astro.props;
---

<div class="pt-[72px] border-b border-dashed border-base-200">
  <Wrapper variant="standard" class="relative py-0 after:absolute after:inset-y-0 after:right-0 after:w-10 after:bg-gradient-to-l after:from-white after:to-transparent after:pointer-events-none lg:after:hidden">
    <nav
      aria-label={label}
      class="flex items-center h-14 lg:h-12 -mx-4 overflow-x-auto gap-1 scrollbar-hide 2xl:-mx-12"
    >
      <a
        href={home.href}
        class="flex items-center h-full px-4 mr-1 font-mono text-xs tracking-wider uppercase border-r border-dashed shrink-0 text-base-500 border-base-200 hover:text-accent-600 2xl:pl-12"
      >
        {home.label}
      </a>
      {
        items.map((item) => {
          const active = item.href === current;
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex items-center gap-2 h-10 lg:h-8 px-3 text-sm rounded-full shrink-0 transition-colors duration-200",
                active ? "text-white bg-accent-500" : "text-base-600 hover:text-base-950 hover:bg-base-100",
              ]}
            >
              {item.n && (
                <span class:list={["font-mono text-xs", active ? "text-white/80" : "text-base-500"]}>{item.n}</span>
              )}
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </Wrapper>
</div>
