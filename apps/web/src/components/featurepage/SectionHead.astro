---
// Testa di sezione delle pagine "feature": alias di section/Head con la
// stessa firma di prima (eyebrow, title, text, tag). Le azioni nello slot.
import Head from "@/components/section/Head.astro";

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  tag?: "h1" | "h2";
  id?: string;
  class?: string;
}
const { eyebrow, title, text, tag = "h2", id, class: className = "" } = Astro.props;
---

<div class={className}>
  <Head tag={eyebrow} id={id} title={title} level={tag} text={text} />
  {
    Astro.slots.has("default") && (
      <div class="flex flex-wrap items-center mt-8 gap-3">
        <slot />
      </div>
    )
  }
</div>
