---
// Testa di sezione delle pagine "feature": etichetta mono, titolo grande
// allineato a sinistra (displayLG, 48px su desktop), una riga di testo e,
// nello slot, le azioni. È il blocco che dà il ritmo alla pagina: tutto il
// resto (griglie, finestre, liste) gli sta sotto.
import Text from "@/components/fundations/elements/Text.astro";

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  tag?: "h1" | "h2";
  id?: string;
  class?: string;
}
const {
  eyebrow,
  title,
  text,
  tag = "h2",
  id,
  class: className = "",
} = Astro.props;
---

<div class={`max-w-3xl ${className}`}>
  {
    eyebrow && (
      <p class="font-mono text-xs font-medium tracking-wider uppercase text-base-500">
        {eyebrow}
      </p>
    )
  }
  <Text
    tag={tag}
    id={id}
    variant="displayLG"
    class={`font-serif font-medium tracking-tight text-balance text-base-950 ${eyebrow ? "mt-4" : ""}`}
  >
    {title}
  </Text>
  {
    text && (
      <Text tag="p" variant="textBase" class="max-w-2xl mt-4 text-base-600">
        {text}
      </Text>
    )
  }
  {
    Astro.slots.has("default") && (
      <div class="flex flex-wrap items-center mt-8 gap-2">
        <slot />
      </div>
    )
  }
</div>
