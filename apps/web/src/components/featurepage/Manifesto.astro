---
// Hero delle pagine "feature" (agenti, soluzioni): targhetta, titolo, testo
// e azioni a sinistra. A destra:
//  - pagine agente (`run`): la catena al lavoro, con il pannello di questo
//    agente in corso e gli altri fermi; i passi numerati scendono sotto il testo;
//  - pagine soluzione: i passi numerati in un pannello.
// `image` resta nella firma per compatibilità ma è ignorata: niente immagini
// decorative.
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
import Run from "@/components/run/Run.astro";

interface Props {
  eyebrow?: string;
  headline: string;
  text: string;
  stepsLead?: string;
  steps?: string[];
  image?: string;
  run?: "brief" | "serp" | "write" | "export";
}
const { eyebrow, headline, text, stepsLead = "", steps = [], run } = Astro.props;
const title = headline.trim().replace(/[.!?…:]$/, "");
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const split = run || steps.length > 0;
---

<Frame n={1} flush tone="soft" class="pt-10 pb-12 lg:pt-16 lg:pb-16 lg:!px-14">
  <div class={`grid gap-10 ${split ? "lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16 lg:items-center" : ""}`}>
    <div class="min-w-0">
      <Head tag={eyebrow} title={title} level="h1" />
      <p class="max-w-lg mt-6 text-lg font-light leading-snug text-base-600 lg:text-lede">{text}</p>
      {
        run && steps.length > 0 && (
          <ol role="list" class="max-w-lg mt-8 text-md text-base-800" aria-label={stepsLead || undefined}>
            {steps.map((step, i) => (
              <li class="flex items-start py-3 border-t border-dashed gap-4 border-base-200 last:border-b">
                <span class="font-mono text-xs leading-6 text-base-500">0{i + 1}</span>
                <span>{stepsLead ? `${stepsLead} ${step}` : cap(step)}</span>
              </li>
            ))}
          </ol>
        )
      }
      <div class="flex flex-wrap items-center mt-8 gap-3">
        <slot />
      </div>
    </div>
    {run && <Run focus={run} />}
    {
      !run && steps.length > 0 && (
        <ol role="list" class="p-2 bg-white border rounded-xl border-base-200" aria-label={stepsLead || undefined}>
          {stepsLead && <li class="px-4 pt-3 pb-1 font-mono text-xs tracking-wider uppercase text-base-500" aria-hidden="true">{stepsLead}</li>}
          {steps.map((step, i) => (
            <li class="flex items-start px-4 py-3.5 gap-4 border-t border-dashed border-base-200 first-of-type:border-t-0">
              <span class="font-mono text-xs leading-6 text-accent-600">0{i + 1}</span>
              <span class="text-md leading-relaxed text-base-800">{cap(step)}</span>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</Frame>
