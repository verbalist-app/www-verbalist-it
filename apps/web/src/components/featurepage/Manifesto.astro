---
// Hero-manifesto delle pagine "feature", sul modello delle feature page di
// Profound: niente titolo e sottotitolo impilati, ma un'unica dichiarazione
// in serif grande. Il titolo (h1) è sempre acceso; il resto del testo e i
// passi numerati si accendono parola per parola mentre si scorre, con il
// blocco fermo al centro dello schermo (sticky) finché non è tutto letto.
//
// Progressive enhancement: senza JS, o con prefers-reduced-motion, il testo
// è tutto acceso e il blocco scorre normalmente. Si anima solo l'opacity.
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

interface Props {
  eyebrow?: string;
  headline: string;
  text: string;
  stepsLead?: string; // es. "In tre mosse:"
  steps?: string[];
  image?: string; // immagine pittorica dietro il testo
}
const {
  eyebrow,
  headline,
  text,
  stepsLead = "",
  steps = [],
  image,
} = Astro.props;

const words = (s: string) => s.split(/\s+/).filter(Boolean);

// Il titolo apre la dichiarazione: se non chiude già con un segno, prende il punto.
const title = /[.!?…:]$/.test(headline.trim()) ? headline.trim() : headline.trim() + ".";

// Passi numerati: la punteggiatura si attacca all'ultima parola del passo
// (virgola tra i passi, punto in fondo), mai dopo uno spazio.
const leadWords = steps.length > 0 ? words(stepsLead) : [];
const stepTokens = steps.map((step, i) => {
  const ws = words(step);
  ws[ws.length - 1] += i < steps.length - 1 ? "," : ".";
  return { n: i + 1, first: ws[0], rest: ws.slice(1) };
});
---

<section data-manifesto class="relative">
  <Wrapper variant="standard" class="py-0">
  <div data-manifesto-track class="relative">
    <div
      data-manifesto-pin
      class="relative flex items-center justify-center overflow-hidden"
    >
      {
        image && (
          <div
            aria-hidden="true"
            class="absolute top-1/2 left-1/2 w-[min(92vw,44rem)] aspect-square -translate-x-1/2 -translate-y-1/2 rounded-full bg-cover bg-center opacity-45 manifesto-orb"
            style={`background-image: url('${image}')`}
          />
        )
      }
      <div
        class="relative w-full max-w-3xl px-6 py-20 mx-auto text-center text-balance lg:py-28"
      >
        {
          eyebrow && (
            <p class="mb-8 font-mono text-xs font-medium tracking-wider uppercase text-base-500">
              {eyebrow}
            </p>
          )
        }
        <div
          class="font-serif text-2xl font-medium leading-[1.3] tracking-tight text-base-950 lg:text-3xl lg:leading-[1.3]"
        >
          <h1 class="inline">{title}</h1>{" "}
          <p class="inline">
            {words(text).map((w) => <><span data-w>{w}</span>{" "}</>)}
          </p>
          {
            stepTokens.length > 0 && (
              <p class="mt-8">
                {leadWords.map((w) => <><span data-w>{w}</span>{" "}</>)}
                {stepTokens.map((step) => (
                  <>
                    <span data-w class="whitespace-nowrap"><span class="inline-flex items-center justify-center mr-2 size-7 align-[0.12em] font-mono text-xs font-medium rounded-full border border-base-400 text-base-800">{step.n}</span>{step.first}</span>{" "}
                    {step.rest.map((w) => <><span data-w>{w}</span>{" "}</>)}
                  </>
                ))}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </div>
  </Wrapper>
</section>
<script is:inline>
  // Subito, prima del primo paint: evita il lampo "tutto acceso → spento".
  (function () {
    var root = document.currentScript.previousElementSibling;
    var still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (root && !still) root.classList.add("is-live");
  })();
</script>

<style>
  /* L'orb sfuma nel bianco della pagina: niente bordo, solo l'immagine. */
  .manifesto-orb {
    -webkit-mask-image: radial-gradient(closest-side, #000 35%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 35%, transparent 100%);
  }
  /* Stato "vivo": lo attiva lo script solo se il movimento è consentito. */
  [data-manifesto].is-live [data-w] {
    opacity: 0.16;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-manifesto].is-live [data-w].is-lit {
    opacity: 1;
  }
  [data-manifesto].is-live.is-pinned [data-manifesto-track] {
    height: 190vh;
  }
  [data-manifesto].is-live.is-pinned [data-manifesto-pin] {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    padding-top: 4.5rem; /* la nav fissa copre la testa dello schermo */
  }
</style>

<script>
  // Accende le parole in base allo scroll. Se il blocco sta nello schermo lo
  // si tiene fermo (pin) per la durata della lettura; se è più alto dello
  // schermo (telefoni piccoli, zoom) niente pin: le parole si accendono
  // mentre il blocco attraversa la finestra.
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-manifesto]").forEach((root) => {
    if (reduce.matches || !root.classList.contains("is-live")) return;
    const track = root.querySelector<HTMLElement>("[data-manifesto-track]");
    const pin = root.querySelector<HTMLElement>("[data-manifesto-pin]");
    const words = Array.from(root.querySelectorAll<HTMLElement>("[data-w]"));
    if (!track || !pin || words.length === 0) return;

    const measure = () => {
      // Altezza naturale del contenuto: si misura senza pin.
      root.classList.remove("is-pinned");
      const fits = pin.scrollHeight <= window.innerHeight;
      root.classList.toggle("is-pinned", fits);
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = track.getBoundingClientRect();
      const vh = window.innerHeight;
      let p: number;
      if (root.classList.contains("is-pinned")) {
        // Da quando il blocco si ferma in alto a quando il track finisce.
        p = -rect.top / Math.max(1, rect.height - vh);
      } else {
        // Dal centro dello schermo fino a quando il blocco esce in alto.
        p = (vh * 0.55 - rect.top) / Math.max(1, rect.height * 0.9);
      }
      // Si chiude un po' prima della fine: l'ultima parte dello scroll
      // lascia il testo tutto acceso, fermo, prima di passare oltre.
      p = Math.min(1, Math.max(0, p / 0.8));
      const lit = Math.round(p * words.length);
      words.forEach((w, i) => w.classList.toggle("is-lit", i < lit));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    measure();
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => {
      measure();
      update();
    });
    reduce.addEventListener("change", () => {
      if (!reduce.matches) return;
      root.classList.remove("is-live", "is-pinned");
      window.removeEventListener("scroll", onScroll);
    });
  });
</script>
