---
// La catena al lavoro: i pannelli degli agenti che eseguono il flusso
// (keyword digitata, cinque risultati letti, due versioni scritte, export
// compilato), in loop con pausa. È l'unica animazione dell'hero.
//  - senza prop: tutti e quattro i pannelli, in sequenza (home);
//  - `focus`: tutti e quattro, ma lavora solo quello dell'agente indicato; i
//    precedenti sono già completati, i successivi in attesa (pagine agente).
// Senza JS o con prefers-reduced-motion resta lo stato finale.
// Dati in components/home/demo.ts: keyword, versioni, title e slug vengono da
// un documento vero; i cinque risultati e le lacune sono dimostrativi.
import { demoBrief, demoDocument, demoGaps, demoSerp, demoVersions } from "@/components/home/demo";

type Step = "brief" | "serp" | "write" | "export";
interface Props {
  focus?: Step;
  only?: Step[];
  class?: string;
}
const { focus, only, class: className = "" } = Astro.props;
const show = (s: Step) => !only || only.includes(s);

const [a, b] = demoVersions;
const label = "font-mono text-xs tracking-wider uppercase text-base-500";
const panel = "relative px-4 py-3 bg-white border rounded-xl border-base-200 vb-panel @container";
const wordsA = a.words;
const wordsB = b.words;
---

<div
  class={`flex flex-col min-w-0 gap-2 vb-run ${className}`}
  data-run
  data-focus={focus}
  data-state="done"
  role="group"
  aria-label={`Dimostrazione della catena di Verbalist sulla keyword «${demoBrief.keyword}»: brief, analisi dei primi cinque risultati, due versioni scritte, export per il CMS. Dati di esempio.`}
>
  <!-- 01 · Brief -->
  {show("brief") && (
  <div class={panel} data-step="brief">
    <div class="flex items-center justify-between">
      <p class={`${label} flex items-center gap-2`}>
        <span class="rounded-full size-1.5 vb-dot"></span>Keyword
      </p>
      <p class={`${label} vb-fade`} data-after="brief">{demoBrief.type} · {demoBrief.market}</p>
    </div>
    <p class="flex items-center h-9 px-4 mt-3 font-mono text-[13px] border rounded-full border-base-200 text-base-800 bg-base-50">
      <span class="mr-2 text-base-500">/</span>
      <span class="truncate min-h-[1.25em]" data-type={demoBrief.keyword} title={demoBrief.keyword}>{demoBrief.keyword}</span>
      <span class="vb-caret" aria-hidden="true"></span>
    </p>
  </div>
  )}

  <!-- 02 · Analisi: i cinque risultati letti uno alla volta, poi le lacune -->
  {show("serp") && (
  <div class={panel} data-step="serp">
    <div class="flex items-center justify-between">
      <p class={`${label} flex items-center gap-2`}>
        <span class="rounded-full size-1.5 vb-dot"></span>Analisi
      </p>
      <p class={label}><span data-count class="text-status-success">5</span> di 5 letti · Google IT</p>
    </div>
    <ol class="mt-3 text-xs" role="list">
      {
        demoSerp.map((r) => (
          <li class="grid grid-cols-[1rem_minmax(0,1fr)_auto] items-baseline py-1 border-t border-dashed gap-x-3 border-base-200 first:border-t-0 vb-row" data-row>
            <span class="font-mono text-base-500">{r.pos}</span>
            <span class="truncate text-base-900">{r.title}</span>
            <span class="font-mono text-base-500 tabular-nums">{r.topics} arg.</span>
          </li>
        ))
      }
    </ol>
    <p class="flex flex-wrap items-center pt-2 mt-1 text-xs border-t border-dashed gap-1.5 border-base-200 vb-fade @sm:flex-nowrap" data-after="serp">
      <span class={`${label} mr-1 !text-accent-600 whitespace-nowrap`}>{demoGaps.length} lacune</span>
      {demoGaps.map((g) => <span class="px-2 py-0.5 border rounded-full border-base-200 text-base-800 whitespace-nowrap">{g}</span>)}
    </p>
  </div>
  )}

  <!-- 03 · Scrittura: due versioni, due modelli -->
  {show("write") && (
  <div class={panel} data-step="write">
    <div class="flex items-center justify-between">
      <p class={`${label} flex items-center gap-2`}>
        <span class="rounded-full size-1.5 vb-dot"></span>Scrittura
      </p>
      <p class={label}>Due modelli</p>
    </div>
    <div class="grid grid-cols-1 mt-2 gap-2 @sm:grid-cols-2">
      <div class="px-3 py-2 border rounded-lg border-base-900 bg-base-50">
        <p class="flex items-baseline justify-between text-xs">
          <span class="text-base-900">Versione A</span>
          <span class="font-mono text-base-900 tabular-nums"><span data-words={wordsA}>{wordsA}</span> parole</span>
        </p>
        <p class="mt-1 text-[13px] leading-snug text-base-900 truncate min-h-[1.3em]" data-type={a.h1}>{a.h1}</p>
      </div>
      <div class="px-3 py-2 border rounded-lg border-base-200">
        <p class="flex items-baseline justify-between text-xs">
          <span class="text-base-700">Versione B</span>
          <span class="font-mono text-base-500 tabular-nums"><span data-words={wordsB}>{wordsB}</span> parole</span>
        </p>
        <p class="mt-1 text-[13px] leading-snug text-base-900 truncate min-h-[1.3em]" data-type={b.h1}>{b.h1}</p>
      </div>
    </div>
  </div>
  )}

  <!-- 04 · Export: pronto per il CMS, con un'azione vera -->
  {show("export") && (
  <div class={panel} data-step="export">
    <div class="flex items-center justify-between">
      <p class={`${label} flex items-center gap-2`}>
        <span class="rounded-full size-1.5 vb-dot"></span>Export
      </p>
      <p class={label}>HTML per il CMS</p>
    </div>
    <dl class="grid grid-cols-[auto_minmax(0,1fr)] items-center mt-2 text-xs gap-x-3 gap-y-0.5">
      <dt class={label}>Title</dt><dd class="truncate text-base-800 min-h-[1.25em]" data-type={demoDocument.titleTag}>{demoDocument.titleTag}</dd>
      <dt class={label}>Slug</dt>
      <dd class="flex items-center min-w-0 gap-2">
        <span class="font-mono truncate text-accent-600 min-h-[1.25em]" data-type={demoDocument.slug}>{demoDocument.slug}</span>
        <button type="button" class="inline-flex items-center h-8 px-2.5 ml-auto text-xs bg-white border rounded-full shrink-0 gap-1.5 border-base-200 text-base-900 hover:border-base-300" data-copy={demoDocument.slug} aria-label="Copia lo slug">
          <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect><path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"></path></svg>
          <span data-copy-label>Copia</span>
        </button>
      </dd>
    </dl>
  </div>
  )}

  <div class="flex items-center justify-between px-1">
    <p class={label}>Esempio dimostrativo</p>
    <button type="button" class="inline-flex items-center h-8 font-mono text-xs gap-1.5 text-base-500 hover:text-base-900" data-run-toggle aria-pressed="false">
      <svg viewBox="0 0 12 12" class="size-2.5" fill="currentColor" aria-hidden="true"><path data-icon-pause d="M2 1h3v10H2zM7 1h3v10H7z"></path><path data-icon-play class="hidden" d="M2.5 1l8 5-8 5z"></path></svg>
      <span data-run-label>Ferma</span>
    </button>
  </div>
</div>

<style>
  /* Stato dei pannelli: in attesa (grigio), in corso (bordo nero), completato
     (punto verde, lo stesso dell'app). */
  .vb-dot { background: var(--color-base-300); transition: background-color 0.3s; }
  [data-step].is-active .vb-dot { background: var(--color-accent-500); }
  [data-step].is-done .vb-dot { background: var(--color-status-success); }
  .vb-panel { transition: border-color 0.4s, box-shadow 0.4s, opacity 0.4s; }
  [data-step].is-active { border-color: var(--color-base-900); box-shadow: 0 0 0 3px var(--color-base-100); }
  [data-step].is-aside { opacity: 0.55; }
  .vb-caret { display: none; width: 1px; height: 1em; margin-left: 2px; background: var(--color-accent-600); }
  [data-step].is-active .vb-caret { display: inline-block; }
  .vb-run.is-live .vb-row { opacity: 0; transform: translateY(4px); transition: opacity 0.3s, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
  .vb-run.is-live .vb-row.is-in { opacity: 1; transform: none; }
  .vb-run.is-live .vb-fade { opacity: 0; transition: opacity 0.4s; }
  .vb-run.is-live .vb-fade.is-in { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .vb-run .vb-row, .vb-run .vb-fade { opacity: 1 !important; transform: none !important; }
  }
</style>

<script>
  // Un solo copione per passo: righe una alla volta, testi digitati, parole
  // che salgono, poi il dettaglio finale. Con `focus` lavora un passo solo.
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-run]").forEach((root) => {
    // Copia dello slug: un'azione vera anche nella dimostrazione.
    root.querySelector<HTMLButtonElement>("[data-copy]")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const label = btn.querySelector("[data-copy-label]")!;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || "");
        label.textContent = "Copiato";
      } catch {
        label.textContent = "Non copiato";
      }
      setTimeout(() => (label.textContent = "Copia"), 1600);
    });

    const steps = Array.from(root.querySelectorAll<HTMLElement>("[data-step]"));
    const focus = root.dataset.focus || "";
    const at = steps.findIndex((s) => s.dataset.step === focus);
    const playable = at >= 0 ? [steps[at]] : steps;
    const toggle = root.querySelector<HTMLButtonElement>("[data-run-toggle]");
    const all = <T extends Element>(el: Element, sel: string) => Array.from(el.querySelectorAll<T>(sel));

    const empty = (s: HTMLElement) => {
      s.classList.remove("is-active", "is-done");
      all<HTMLElement>(s, "[data-row]").forEach((r) => r.classList.remove("is-in"));
      all<HTMLElement>(s, "[data-after]").forEach((f) => f.classList.remove("is-in"));
      all<HTMLElement>(s, "[data-type]").forEach((t) => (t.textContent = ""));
      all<HTMLElement>(s, "[data-words]").forEach((w) => (w.textContent = "0"));
      all<HTMLElement>(s, "[data-count]").forEach((c) => (c.textContent = "0"));
    };
    const fill = (s: HTMLElement) => {
      s.classList.remove("is-active");
      s.classList.add("is-done");
      const rows = all<HTMLElement>(s, "[data-row]");
      rows.forEach((r) => r.classList.add("is-in"));
      all<HTMLElement>(s, "[data-after]").forEach((f) => f.classList.add("is-in"));
      all<HTMLElement>(s, "[data-type]").forEach((t) => (t.textContent = t.dataset.type || ""));
      all<HTMLElement>(s, "[data-words]").forEach((w) => (w.textContent = w.dataset.words || ""));
      all<HTMLElement>(s, "[data-count]").forEach((c) => (c.textContent = String(rows.length)));
    };

    // Pagine agente: i passi prima sono completati, quelli dopo in attesa.
    // Senza movimento restano tutti compilati: conta solo quale è in primo piano.
    if (at >= 0) {
      steps.forEach((s, i) => {
        if (i === at) return;
        s.classList.add("is-aside");
        if (i < at || calm.matches) fill(s);
        else {
          root.classList.add("is-live");
          empty(s);
        }
      });
    }
    if (calm.matches) {
      toggle?.remove();
      return;
    }

    let run = 0; // id del ciclo corrente: un ciclo vecchio si ferma da solo
    let paused = false;
    let visible = true;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const alive = (id: number) => id === run && !paused && visible;

    const type = async (id: number, el: HTMLElement, ms: number) => {
      const text = el.dataset.type || "";
      for (let i = 1; i <= text.length; i++) {
        if (!alive(id)) return;
        el.textContent = text.slice(0, i);
        await wait(ms);
      }
    };
    const countUp = async (id: number, el: HTMLElement, ms: number) => {
      const target = +(el.dataset.words || 0);
      const t0 = performance.now();
      while (alive(id)) {
        const k = Math.min(1, (performance.now() - t0) / ms);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - k, 3))));
        if (k >= 1) return;
        await wait(40);
      }
    };
    const playStep = async (id: number, s: HTMLElement) => {
      s.classList.add("is-active");
      const rows = all<HTMLElement>(s, "[data-row]");
      const count = s.querySelector<HTMLElement>("[data-count]");
      for (let i = 0; i < rows.length; i++) {
        await wait(420);
        if (!alive(id)) return;
        rows[i].classList.add("is-in");
        if (count) count.textContent = String(i + 1);
      }
      const typed = all<HTMLElement>(s, "[data-type]");
      const words = all<HTMLElement>(s, "[data-words]");
      if (words.length) {
        // due versioni scritte insieme: titoli e parole in parallelo
        await Promise.all([...typed.map((t) => type(id, t, 30)), ...words.map((w) => countUp(id, w, 2400))]);
      } else {
        for (const t of typed) await type(id, t, typed.length > 1 ? 22 : 34);
      }
      if (!alive(id)) return;
      await wait(500);
      s.classList.remove("is-active");
      s.classList.add("is-done");
      all<HTMLElement>(s, "[data-after]").forEach((f) => f.classList.add("is-in"));
    };

    const finish = () => {
      if (at < 0) root.classList.remove("is-live");
      playable.forEach(fill);
      root.dataset.state = "done";
    };
    const play = async () => {
      const id = ++run;
      root.classList.add("is-live");
      root.dataset.state = "running";
      playable.forEach(empty);
      await wait(600);
      for (const s of playable) {
        if (!alive(id)) return;
        await playStep(id, s);
      }
      if (!alive(id)) return;
      root.dataset.state = "done";
      await wait(5000);
      if (alive(id)) play();
    };

    // Parte solo quando è in vista; fuori schermo si ferma sullo stato finale.
    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        if (visible && !paused && root.dataset.state !== "running") play();
        if (!visible) finish();
      },
      { threshold: 0.3 }
    ).observe(root);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) finish();
    });

    toggle?.addEventListener("click", () => {
      paused = !paused;
      toggle.setAttribute("aria-pressed", String(paused));
      toggle.querySelector("[data-run-label]")!.textContent = paused ? "Riprendi" : "Ferma";
      toggle.querySelector("[data-icon-pause]")!.classList.toggle("hidden", paused);
      toggle.querySelector("[data-icon-play]")!.classList.toggle("hidden", !paused);
      if (paused) finish();
      else play();
    });
  });
</script>
