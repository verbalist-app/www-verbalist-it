---
// Fundations
import Logo from "@/components/assets/Logo.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const navigationLinks = [
  {
    title: "Funzionalità",
    href: "/#funzionalita",
    activePaths: [],
  },
  {
    title: "Agenti",
    href: "/#agenti",
    activePaths: ["/agenti"],
  },
  {
    title: "Prezzi",
    href: "/#prezzi",
    activePaths: [],
  },
  {
    title: "Clienti",
    href: "/clienti/",
    activePaths: ["/clienti"],
  },
  {
    title: "Blog",
    href: "/blog/",
    activePaths: ["/blog", "/categorie"],
  },
];

// Stato attivo: la voce si accende sulle sezioni reali (Blog copre anche le
// categorie, Agenti le pagine di dettaglio). Le ancore della home restano
// neutre. La pillola desktop riposa sulla voce attiva (vedi script sotto).
const path = Astro.url.pathname;
const isActive = (link) =>
  link.activePaths.some((base) => path === base || path.startsWith(base + "/"));
---

<div
  id="nav-wrapper"
  class="fixed inset-x-0 top-0 z-50 w-full mx-auto bg-white border-b border-dashed border-base-200"
>
  <div
    id="nav-blur"
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-white/80 backdrop-blur-lg opacity-0 transition-opacity duration-300"
  >
  </div>
  <Wrapper id="second-wrapper" variant="standard" class="py-4">
    <div
      id="navigation-wrapper"
      class="relative flex flex-col md:items-center md:justify-between md:flex-row"
    >
      <div class="flex flex-row items-center justify-between">
        <a href="/">
          <span class="sr-only">Vai alla home</span>
          <Logo class="h-6 text-base-800" />
        </a>
        <button
          id="menu-toggle"
          class="inline-flex items-center justify-center p-2 text-base-600 hover:text-base-800 focus:outline-none focus:text-base-500 md:hidden"
        >
          <svg
            class="size-6"
            stroke="currentColor"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              id="menu-icon"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
            <path
              id="close-icon"
              class="hidden"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div
        id="nav-desktop-links"
        class="absolute hidden lg:flex left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 items-center"
      >
        <span
          id="nav-pill"
          aria-hidden="true"
          class="absolute top-1/2 h-8 -translate-y-1/2 rounded-full bg-mist-100 opacity-0 pointer-events-none transition-[left,width,opacity] duration-300 ease-out"
        ></span>
        {
          navigationLinks.map((link) => (
            <a
              href={link.href}
              data-active={isActive(link) ? "1" : undefined}
              aria-current={isActive(link) ? "page" : undefined}
              class={`relative flex items-center h-8 px-3 text-sm duration-300 transition-colors hover:text-base-800 ${
                isActive(link)
                  ? "font-medium text-base-950"
                  : "font-normal text-base-500"
              }`}
            >
              {link.title}
            </a>
          ))
        }
      </div>
      <nav
        id="navigation-menu"
        class="fixed inset-x-0 top-[72px] bottom-0 flex flex-col justify-between pt-2 pb-8 bg-white opacity-0 pointer-events-none md:bg-none md:bg-transparent lg:p-0 md:p-0 transform transition-all duration-300 ease-in-out -translate-y-4 md:relative md:inset-auto md:opacity-100 md:pointer-events-auto md:translate-y-0"
      >
        <div
          class="relative flex flex-col items-start justify-start w-full h-full px-6 list-none md:ml-auto gap-10 md:px-0 md:flex-row md:items-center md:justify-center md:text-left md:gap-4"
        >
          <div
            class="flex flex-col w-full gap-1 md:w-auto md:gap-4 md:flex-row lg:hidden"
          >
            {
              navigationLinks.map((link) => (
                <a
                  href={link.href}
                  aria-current={isActive(link) ? "page" : undefined}
                  class={`py-2.5 text-lg md:py-0 md:text-sm hover:text-base-500 md:hover:text-base-600 ${
                    isActive(link)
                      ? "font-medium text-base-950 md:text-base-950"
                      : "text-base-800 md:text-base-500"
                  }`}
                >
                  {link.title}
                </a>
              ))
            }
            <div class="flex flex-col pt-4 mt-4 border-t border-base-200 md:hidden">
              <a
                href="/help/"
                class="py-2 text-base text-base-500 hover:text-base-800"
              >
                Help center
              </a>
              <a
                href="/contatti/"
                class="py-2 text-base text-base-500 hover:text-base-800"
              >
                Contatti
              </a>
            </div>
          </div>
          <div class="flex flex-col w-full mt-auto gap-3 md:hidden">
            <Button
              isLink
              size="base"
              variant="muted"
              class="w-full"
              href="https://app.verbalist.it/login"
            >
              Accedi
            </Button>
            <Button
              isLink
              size="base"
              variant="accent"
              class="w-full"
              href="https://app.verbalist.it/login?registration&code=PROVAGRATUITA26"
            >
              Prova gratis
            </Button>
          </div>
          <div class="hidden md:flex flex-wrap items-center gap-2">
            <Button
              isLink
              size="xs"
              variant="muted"
              href="https://app.verbalist.it/login"
            >
              Accedi
            </Button>
            <Button
              isLink
              size="xs"
              variant="accent"
              href="https://app.verbalist.it/login?registration&code=PROVAGRATUITA26"
            >
              Prova gratis
            </Button>
          </div>
        </div>
      </nav>
    </div>
  </Wrapper>
</div>
<script type="module">
  document.addEventListener("DOMContentLoaded", () => {
    const menuToggle = document.getElementById("menu-toggle");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");
    const navigationMenu = document.getElementById("navigation-menu");
    // Toggle mobile menu
    function toggleMenu(open) {
      navigationMenu.classList.toggle("opacity-100", open);
      navigationMenu.classList.toggle("translate-y-0", open);
      navigationMenu.classList.toggle("pointer-events-auto", open);
      navigationMenu.classList.toggle("opacity-0", !open);
      navigationMenu.classList.toggle("-translate-y-4", !open);
      navigationMenu.classList.toggle("pointer-events-none", !open);
      menuIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
      document.body.classList.toggle("overflow-hidden", open);
    }
    // Event Listeners
    let menuOpen = false;
    menuToggle.addEventListener("click", () => {
      menuOpen = !menuOpen;
      toggleMenu(menuOpen);
    });

    // Chiudi il menu quando si clicca una voce (utile per le ancore in pagina)
    navigationMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (menuOpen) {
          menuOpen = false;
          toggleMenu(false);
        }
      });
    });

    // Barra viva allo scroll: traslucida con blur oltre i 50px
    const headerEl = document.getElementById("nav-wrapper");
    const blurEl = document.getElementById("nav-blur");
    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const active = window.scrollY > 50;
          headerEl.classList.toggle("bg-transparent", active);
          headerEl.classList.toggle("bg-white", !active);
          blurEl.classList.toggle("opacity-100", active);
          ticking = false;
        });
      },
      { passive: true }
    );

    // Pillola che scivola dietro le voci desktop. Se una voce è attiva
    // (data-active), la pillola riposa lì e ci torna a fine hover: fa da
    // indicatore di sezione corrente oltre che da feedback di hover.
    const linksWrap = document.getElementById("nav-desktop-links");
    const pill = document.getElementById("nav-pill");
    if (linksWrap && pill) {
      const activeLink = linksWrap.querySelector('a[data-active="1"]');
      const moveTo = (el, instant = false) => {
        const wasHidden = pill.dataset.on !== "1";
        if (wasHidden || instant) pill.style.transitionProperty = "opacity";
        pill.style.left = el.offsetLeft + "px";
        pill.style.width = el.offsetWidth + "px";
        if (wasHidden || instant) {
          void pill.offsetWidth;
          pill.style.transitionProperty = "";
        }
        pill.style.opacity = "1";
        pill.dataset.on = "1";
      };
      const rest = () => {
        if (activeLink) {
          moveTo(activeLink);
        } else {
          pill.style.opacity = "0";
          pill.dataset.on = "";
        }
      };
      if (activeLink) moveTo(activeLink, true);
      linksWrap.querySelectorAll("a").forEach((a) => {
        a.addEventListener("mouseenter", () => moveTo(a));
        a.addEventListener("focus", () => moveTo(a));
      });
      linksWrap.addEventListener("mouseleave", rest);
      linksWrap.addEventListener("focusout", (e) => {
        if (!linksWrap.contains(e.relatedTarget)) rest();
      });
    }
  });
</script>
