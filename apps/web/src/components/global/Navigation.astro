---
// Fundations
import LogoFooter from "@/components/assets/LogoFooter.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const TRIAL = "https://app.verbalist.it/login?registration&code=PROVAGRATUITA26";
const LOGIN = "https://app.verbalist.it/login";

const navigationLinks = [
  { title: "Agenti", href: "/#agenti", activePaths: ["/agenti"] },
  { title: "Soluzioni", href: "/soluzioni/", activePaths: ["/soluzioni"] },
  { title: "Prezzi", href: "/#prezzi", activePaths: [] },
  { title: "Clienti", href: "/clienti/", activePaths: ["/clienti"] },
  { title: "Blog", href: "/blog/", activePaths: ["/blog", "/categorie"] },
  { title: "Contatti", href: "/contatti/", activePaths: ["/contatti"] },
];

// Stato attivo: la voce si accende sulle sezioni reali (Blog copre anche le
// categorie, Agenti le pagine di dettaglio). Le ancore della home restano
// neutre.
const path = Astro.url.pathname;
const isActive = (link) =>
  link.activePaths.some((base) => path === base || path.startsWith(base + "/"));
---

<header
  id="nav-wrapper"
  class="fixed inset-x-0 top-0 z-50 bg-white/95 border-b border-dashed border-base-200 backdrop-blur-sm"
>
  <Wrapper variant="standard" class="h-[72px] flex items-center gap-6">
    <a href="/" class="flex items-center h-11 shrink-0 text-base-900">
      <span class="sr-only">Verbalist, vai alla home</span>
      <LogoFooter class="w-auto h-5" aria-hidden="true" />
    </a>
    <nav
      aria-label="Principale"
      class="items-center hidden pl-6 border-l gap-1 border-base-200 lg:flex"
    >
      {
        navigationLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link) ? "page" : undefined}
            class={`flex items-center h-9 px-3 text-sm rounded-full transition-colors duration-200 hover:text-base-950 hover:bg-base-100 ${
              isActive(link) ? "text-base-950 bg-base-100" : "text-base-600"
            }`}
          >
            {link.title}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center ml-auto gap-2">
      <a
        href={LOGIN}
        class="items-center hidden px-3 text-sm h-9 text-base-600 hover:text-base-950 lg:flex"
      >
        Accedi
      </a>

      <Button isLink size="sm" variant="accent" href={TRIAL}>Prova gratis</Button>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="navigation-menu"
        aria-label="Apri il menu"
        class="inline-flex items-center justify-center -mr-2 size-11 text-base-700 hover:text-base-950 lg:hidden"
      >
        <svg
          class="size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path id="menu-icon" d="M4 8h16M4 16h16"></path>
          <path id="close-icon" class="hidden" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </Wrapper>
</header>
<!-- Fuori dall'header: il suo backdrop-blur renderebbe l'header il riferimento
     dei figli fixed, e il pannello resterebbe alto quanto la barra. -->
  <nav
    id="navigation-menu"
    aria-label="Menu"
    hidden
    class="fixed z-50 inset-x-0 bottom-0 top-[72px] flex-col px-4 pt-2 pb-8 overflow-y-auto bg-white [&:not([hidden])]:flex lg:!hidden"
  >
    {
      navigationLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link) ? "page" : undefined}
          class={`flex items-center min-h-13 text-xl border-b border-dashed border-base-200 ${
            isActive(link) ? "text-accent-600" : "text-base-900"
          }`}
        >
          {link.title}
        </a>
      ))
    }
    <a
      href="/help/"
      class="flex items-center text-xl border-b border-dashed min-h-13 border-base-200 text-base-900"
    >
      Help center
    </a>
    <div class="flex flex-col pt-8 mt-auto gap-3">
      <Button isLink size="lg" variant="muted" class="w-full" href={LOGIN}>Accedi</Button>
      <Button isLink size="lg" variant="accent" class="w-full" href={TRIAL}>Prova gratis</Button>
    </div>
  </nav>

<script>
  // Il menu chiuso è `hidden`: fuori dal focus e dall'albero di accessibilità.
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("navigation-menu");
  if (toggle && menu) {
    const set = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Chiudi il menu" : "Apri il menu");
      document.getElementById("menu-icon")?.classList.toggle("hidden", open);
      document.getElementById("close-icon")?.classList.toggle("hidden", !open);
      document.body.classList.toggle("overflow-hidden", open);
    };
    toggle.addEventListener("click", () => set(menu.hidden));
    // Chiudi sul click di una voce (ancore in pagina) e con Esc.
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hidden) {
        set(false);
        toggle.focus();
      }
    });
    window.matchMedia("(min-width: 64rem)").addEventListener("change", (e) => e.matches && set(false));
  }
</script>
