---
// Chiusura delle pagine interne: titolo con la parola nell'accento, testo e
// pillole. Sta sul fondo `base-50`, come la chiusura della home.
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
import Button from "@/components/fundations/elements/Button.astro";

const {
  title,
  text,
  primaryText = "Prova gratis",
  primaryHref = "https://app.verbalist.it/login?registration&code=PROVAGRATUITA26",
  secondaryText = null,
  secondaryHref = null,
  compact = false,
} = Astro.props;
---

<Frame tone="soft" class={compact ? "py-12 lg:py-14 lg:!px-14" : "py-14 lg:py-20 lg:!px-14"}>
  <Head title={title} />
  <p class="max-w-md mt-6 text-lg font-light leading-snug text-base-600">{text}</p>
  <div class="flex flex-wrap items-center mt-8 gap-3">
    <Button isLink size="base" variant="accent" href={primaryHref}>{primaryText}</Button>
    {
      secondaryText && secondaryHref && (
        <Button isLink size="base" variant="muted" href={secondaryHref}>{secondaryText}</Button>
      )
    }
  </div>
  {
    /registration/.test(primaryHref) && (
      <p class="mt-4 text-sm text-base-500">30 giorni, 15 documenti, senza carta di credito.</p>
    )
  }
</Frame>
