---
// CTA editoriale di chiusura (dal Cta2 del template, rebrand):
// aria sopra, titolo serif a sinistra, azione in basso a destra.
// Niente pannello: il peso lo fa lo spazio bianco.
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";

const {
  title,
  text,
  primaryText = "Prova gratis 30 giorni",
  primaryHref = "https://app.verbalist.it/login?registration&code=PROVAGRATUITA26",
  secondaryText = null,
  secondaryHref = null,
} = Astro.props;
---

<section class="border-t border-base-200">
  <Wrapper variant="standard" class="pt-12 pb-4 bg-mist-100">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:items-end lg:pt-36">
      <div class="lg:col-span-2">
        <Text
          tag="h2"
          variant="displaySM"
          class="font-serif font-medium text-base-900 lg:text-balance"
        >
          {title}
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="mt-2 text-base-500 lg:text-balance"
        >
          {text}
        </Text>
      </div>
      <div class="flex flex-wrap items-center gap-2 lg:ml-auto lg:justify-end">
        <Button isLink size="sm" variant="accent" href={primaryHref}>
          {primaryText}
        </Button>
        {
          secondaryText && secondaryHref && (
            <Button isLink size="sm" variant="muted" href={secondaryHref}>
              {secondaryText}
            </Button>
          )
        }
      </div>
    </div>
  </Wrapper>
</section>
