---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import Check from "@/components/fundations/icons/Check.astro";
// Mockup degli agenti (variante "card": solo la scheda, senza pannello)
import MockupBrief from "@/components/features/agents/MockupBrief.astro";
import MockupSerp from "@/components/features/agents/MockupSerp.astro";
import MockupArticle from "@/components/features/agents/MockupArticle.astro";
import MockupExport from "@/components/features/agents/MockupExport.astro";
import MockupWindow from "@/components/features/agents/MockupWindow.astro";
import MockupOutcome from "@/components/features/agents/MockupOutcome.astro";
import Cta2 from "@/components/ctas/Cta2.astro";

// prev/next: agente precedente e successivo ({ id, n, name } | null).
const { frontmatter, all = [], prev = null, next = null } = Astro.props;

// Pannello dipinto + finestra app, come in home (chiave = frontmatter.mockup)
const mockups: Record<string, any> = {
  brief: MockupBrief,
  serp: MockupSerp,
  article: MockupArticle,
  "export": MockupExport,
};
const Mockup = mockups[frontmatter.mockup] ?? MockupBrief;

const heroImages: Record<string, string> = {
  brief: "/img/agent-brief.webp",
  serp: "/img/agent-serp.webp",
  article: "/img/agent-article.webp",
  "export": "/img/agent-export.webp",
};
const heroImage = heroImages[frontmatter.mockup] ?? heroImages.brief;

const appUrls: Record<string, string> = {
  brief: "app.verbalist.it/nuovo",
  serp: "app.verbalist.it/analisi",
  article: "app.verbalist.it/editor",
  "export": "app.verbalist.it/esporta",
};
const appUrl = appUrls[frontmatter.mockup] ?? appUrls.brief;
---

<BaseLayout
  seo={{
    title: frontmatter.seoTitle,
    description: frontmatter.seoDescription ?? frontmatter.lede,
  }}
>
  <section>
    <Wrapper variant="standard" class="pt-24 pb-0">
      <nav
        aria-label="Gli agenti della catena"
        class="flex items-center pb-4 overflow-x-auto font-mono text-xs font-medium tracking-wider uppercase gap-6 border-b border-dashed border-base-200"
      >
        {
          all.map((a: { id: string; n: string; name: string }) => (
            <a
              href={`/agenti/${a.id}/`}
              aria-current={a.n === frontmatter.n ? "page" : undefined}
              class={`whitespace-nowrap py-1 transition-colors duration-200 ${
                a.n === frontmatter.n
                  ? "text-accent-500 border-b border-accent-500"
                  : "text-base-500 hover:text-base-800"
              }`}
            >
              {a.n} · {a.name}
            </a>
          ))
        }
      </nav>
    </Wrapper>
    <Wrapper variant="standard" class="pt-12 pb-4">
      <div class="max-w-2xl mx-auto text-center text-balance">
        <Text
          tag="h1"
          variant="displayMD"
          class="font-serif font-medium tracking-tight text-base-950"
        >
          {frontmatter.headline}
        </Text>
        <Text
          tag="p"
          variant="textXL"
          class="mt-6 font-serif tracking-tight text-base-600 lg:!text-[1.45rem] lg:!leading-[1.5]"
        >
          {frontmatter.lede}
        </Text>
        {
          frontmatter.steps && (
            <p class="mt-6 text-base leading-loose text-base-600">
              {frontmatter.steps.map((step: string, i: number) => (
                <span class="whitespace-nowrap">
                  <span class="inline-flex items-center justify-center mx-1.5 size-5 align-[0.05em] font-mono text-[10px] rounded-full border border-base-300 text-base-600">
                    {i + 1}
                  </span>
                  {step + (i < frontmatter.steps.length - 1 ? "," : ".")}
                </span>
              ))}
            </p>
          )
        }
      </div>
      <div
        class="relative p-5 mt-8 overflow-hidden rounded-xl bg-mist-100 bg-cover bg-center sm:p-10 md:p-14"
        style={`background-image: url('${heroImage}')`}
      >
        <div class="absolute inset-0 bg-mist-100/25" aria-hidden="true"></div>
        <MockupWindow url={appUrl}>
          <Mockup variant="card" />
        </MockupWindow>
      </div>
    </Wrapper>
  </section>

  {
    Astro.slots.has("default") && (
      <section>
        <Wrapper variant="standard" class="py-12 border-t border-dashed border-base-200">
          <div class="items-start grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-16">
            <div class="max-w-xl">
              <Wrapper
                variant="prose"
                class="[&_h2]:font-mono [&_h2]:text-xs [&_h2]:font-medium [&_h2]:uppercase [&_h2]:tracking-wider [&_h2]:text-base-500 [&_h2]:mt-10 [&_h2]:mb-4"
              >
                <slot />
              </Wrapper>
            </div>
            <div class="p-6 rounded-xl bg-mist-100 sm:p-10 lg:sticky lg:top-24">
              <MockupOutcome variant={frontmatter.mockup} />
            </div>
          </div>
        </Wrapper>
      </section>
    )
  }

  <section>
    <Wrapper variant="standard" class="py-12 border-t border-dashed border-base-200">
      <div class="max-w-2xl mx-auto">
        {
          frontmatter.intro && (
            <Text tag="p" variant="textBase" class="mb-8 text-base-600">
              {frontmatter.intro}
            </Text>
          )
        }
        <dl class="grid grid-cols-1 pt-8 border-t border-dashed gap-8 border-base-200 md:grid-cols-2 md:gap-0">
          <div class="flex flex-col gap-3 md:pr-8">
            <dt>
              <Text
                tag="h2"
                variant="textXS"
                class="font-mono font-medium tracking-wider uppercase text-base-500"
              >
                Cosa riceve
              </Text>
            </dt>
            {
              frontmatter.input.map((item: string) => (
                <dd class="flex items-start gap-2">
                  <Check size="sm" class="mt-1 text-accent-500 shrink-0" />
                  <Text tag="p" variant="textBase" class="text-base-600">
                    {item}
                  </Text>
                </dd>
              ))
            }
          </div>
          <div class="flex flex-col gap-3 md:pl-8 md:border-l md:border-dashed md:border-base-200">
            <dt>
              <Text
                tag="h2"
                variant="textXS"
                class="font-mono font-medium tracking-wider uppercase text-base-500"
              >
                Cosa consegna
              </Text>
            </dt>
            {
              frontmatter.output.map((item: string) => (
                <dd class="flex items-start gap-2">
                  <Check size="sm" class="mt-1 text-accent-500 shrink-0" />
                  <Text tag="p" variant="textBase" class="text-base-600">
                    {item}
                  </Text>
                </dd>
              ))
            }
          </div>
        </dl>

        {
          frontmatter.note && (
            <div class="pl-4 mt-10 border-l-2 border-base-200">
              <Text
                tag="h3"
                variant="textXS"
                class="font-mono font-medium tracking-wider uppercase text-accent-600"
              >
                {frontmatter.note.label}
              </Text>
              <Text tag="p" variant="textBase" class="mt-2 text-base-600">
                {frontmatter.note.text}
              </Text>
            </div>
          )
        }

        <nav
          aria-label="Agente precedente e successivo"
          class="pt-8 mt-12 border-t border-dashed border-base-200"
        >
          {
            next ? (
              <a
                href={"/agenti/" + next.id + "/"}
                rel="next"
                class="flex flex-col p-6 -mx-6 rounded-xl gap-2 group hover:bg-mist-100 transition-colors duration-300"
              >
                <span class="font-mono text-xs font-medium tracking-wider uppercase text-base-500">
                  Prossimo · Agente {next.n}
                </span>
                <span class="font-serif text-xl font-medium tracking-tight text-base-950 group-hover:text-accent-500 transition-colors duration-300">
                  {next.name}
                </span>
                <span class="text-sm text-base-500">{next.summary}</span>
              </a>
            ) : (
              <a
                href="/#agenti"
                class="flex flex-col p-6 -mx-6 rounded-xl gap-2 group hover:bg-mist-100 transition-colors duration-300"
              >
                <span class="font-mono text-xs font-medium tracking-wider uppercase text-base-500">
                  Fine della catena
                </span>
                <span class="font-serif text-xl font-medium tracking-tight text-base-950 group-hover:text-accent-500 transition-colors duration-300">
                  Rivedi i quattro agenti
                </span>
                <span class="text-sm text-base-500">
                  Dalla keyword all'articolo pronto per il CMS, in un'unica
                  corsa.
                </span>
              </a>
            )
          }
          {
            prev && (
              <a
                href={"/agenti/" + prev.id + "/"}
                rel="prev"
                class="inline-flex items-center mt-6 font-mono text-xs font-medium tracking-wider uppercase gap-1 text-base-500 hover:text-accent-500 group"
              >
                <ChevronRight
                  size="sm"
                  class="rotate-180 duration-300 group-hover:-translate-x-1"
                />
                {prev.n} · {prev.name}
              </a>
            )
          }
        </nav>

      </div>
    </Wrapper>
  </section>
  <Cta2
    compact
    title="Prova l'intera catena di agenti"
    text="Parti da una keyword: brief, analisi della SERP, articolo ed esportazione in un'unica corsa. Gratis per 30 giorni."
    secondaryText="Parla con noi"
    secondaryHref="/contatti/"
  />
</BaseLayout>
