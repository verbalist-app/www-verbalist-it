---
// Pagina agente sul pattern "feature page" di Profound, tradotto nel sistema
// chiaro di Verbalist: sotto-nav della catena, manifesto che si accende allo
// scroll, blocco prodotto con titolo grande e finestra app, poi celle della
// griglia tratteggiata al posto delle colonne centrate.
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
// Blocchi condivisi delle pagine feature
import SubNav from "@/components/featurepage/SubNav.astro";
import Manifesto from "@/components/featurepage/Manifesto.astro";
import SectionHead from "@/components/featurepage/SectionHead.astro";
// Illustrazioni di prodotto: una finestra dell'app per agente, dentro la card
import ProductCard from "@/components/featurepage/ProductCard.astro";
import BriefWindow from "@/components/features/agents/BriefWindow.astro";
import ProgressWindow from "@/components/features/agents/ProgressWindow.astro";
import ExportWindow from "@/components/features/agents/ExportWindow.astro";
import AppWindow from "@/components/home/AppWindow.astro";
import { demoBrief } from "@/components/home/demo";
import Cta2 from "@/components/ctas/Cta2.astro";
import Frame from "@/components/section/Frame.astro";

// slug: id della pagina; all: i quattro agenti ({ id, n, name }) per la
// sotto-nav; prev/next: agente precedente e successivo, con la sintesi.
const { frontmatter, slug, all = [], prev = null, next = null } = Astro.props;

// La finestra dell'app mostrata nell'hero (chiave = frontmatter.mockup): il
// passo della procedura che questo agente compie.
const mockup = (frontmatter.mockup as string) ?? "brief";
const fragmentStep = ({ brief: "brief", serp: "serp", article: "write", "export": "export" } as const)[
  mockup as "brief" | "serp" | "article" | "export"
] ?? "brief";
const briefFields = [
  { label: "Keyword", value: demoBrief.keyword },
  { label: "Mercato", value: `${demoBrief.market} · IT` },
  { label: "Lingua", value: demoBrief.language.charAt(0).toUpperCase() + demoBrief.language.slice(1) },
  { label: "Tipo", value: demoBrief.type },
];
// Il passo della catena che lavora nell'hero di questa pagina. (La chiave è
// tra virgolette: il compilatore Astro tratta la parola nuda come keyword.)
const runStep = { brief: "brief", serp: "serp", article: "write", "export": "export" }[
  frontmatter.mockup as string
] as "brief" | "serp" | "write" | undefined;


const TRIAL_URL =
  "https://app.verbalist.it/login?registration&code=PROVAGRATUITA26";

const ioCells = [
  { eyebrow: "In ingresso", title: "Cosa riceve", items: frontmatter.input },
  { eyebrow: "In uscita", title: "Cosa consegna", items: frontmatter.output },
];
---

<BaseLayout
  seo={{
    title: frontmatter.seoTitle,
    description: frontmatter.seoDescription ?? frontmatter.lede,
  }}
>
  <SubNav
    label="Gli agenti della catena"
    home={{ href: "/#agenti", label: "Agenti" }}
    items={all.map((a: { id: string; n: string; name: string }) => ({
      href: `/agenti/${a.id}/`,
      label: a.name,
      n: a.n,
    }))}
    current={`/agenti/${slug}/`}
  />

  <Manifesto
    eyebrow={`Agente ${frontmatter.n} · ${frontmatter.role}`}
    headline={frontmatter.headline}
    text={frontmatter.lede}
    stepsLead={frontmatter.stepsLead}
    steps={frontmatter.steps}
  >
    <Fragment slot="card">
      <div class={`absolute overflow-hidden rounded-xl vb-window top-8 sm:top-10 lg:top-12 ${mockup === "article" ? "left-[34%]" : "left-[40%]"}`}>
        {mockup === "brief" && <BriefWindow fields={briefFields} file="brand-guidelines.pdf" />}
        {mockup === "serp" && <ProgressWindow />}
        {mockup === "article" && <AppWindow sidebar={false} />}
        {mockup === "export" && <ExportWindow />}
      </div>
    </Fragment>
  </Manifesto>

  <!-- Il prodotto: titolo grande, azioni, finestra app -->
  <Frame n={2} class="pt-14 pb-14 lg:pt-20 lg:pb-20 lg:!px-14">
      <SectionHead
        eyebrow={`Agente ${frontmatter.n} di 04`}
        title={frontmatter.pitch ?? frontmatter.name}
        text={frontmatter.intro}
      >
        <Button isLink size="base" variant="accent" href={TRIAL_URL}>
          Prova gratis
        </Button>
        <Button isLink size="base" variant="muted" href="/contatti/">
          Parla con noi
        </Button>
      </SectionHead>
      <ProductCard
        tone="sera"
        label="La pagina del documento in Verbalist, con la barra laterale dell'app: progetti, documenti, impostazioni e le due versioni generate."
        class="mt-10 h-[20rem] sm:h-[26rem] lg:h-[30rem] [--vb-zoom:0.5] sm:[--vb-zoom:0.7] lg:[--vb-zoom:0.82]"
      >
        <div class="absolute overflow-hidden rounded-xl vb-window top-8 left-6 sm:top-10 sm:left-10 lg:top-12 lg:left-14">
          <AppWindow />
        </div>
      </ProductCard>
  </Frame>

  <!-- Ingresso e uscita: due celle della griglia -->
  <Frame n={3} class="!px-0">
      <div class="grid grid-cols-1 px-4 md:grid-cols-2 lg:px-14">
        {
          ioCells.map((cell, i) => (
            <div
              class:list={[
                "py-8 lg:py-12",
                i === 0
                  ? "md:pr-10 md:border-r md:border-dashed md:border-base-200 max-md:border-b max-md:border-dashed max-md:border-base-200"
                  : "md:pl-10",
              ]}
            >
              <p class="font-mono text-xs tracking-wider uppercase text-accent-600">
                {cell.eyebrow}
              </p>
              <h2 class="mt-4 text-2xl font-normal tracking-tight text-base-900">
                {cell.title}
              </h2>
              <ul role="list" class="mt-6 text-md text-base-800">
                {cell.items.map((item: string) => (
                  <li class="flex items-start py-3.5 border-t border-dashed gap-3 border-base-200 last:border-b">
                    <span class="mt-2 rounded-full size-1.5 bg-accent-500 shrink-0" />{item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
  </Frame>

  <!-- Come funziona: prosa con link interni + l'output della fase -->
  {
    Astro.slots.has("default") && (
      <Frame n={4} class="py-12 lg:py-16 lg:!px-14">
        <Wrapper
          variant="prose"
          class="max-w-xl [&_h2]:font-normal [&_h2]:tracking-[-0.025em] [&_h2]:text-base-900 [&_h2]:text-3xl lg:[&_h2]:text-[2.75rem] lg:[&_h2]:leading-[1.1] [&_h2]:mt-0 [&_h2]:mb-8"
        >
          <slot />
        </Wrapper>
      </Frame>
    )
  }

  <!-- Nota: una cella a due colonne, domanda a sinistra e risposta a destra -->
  {
    frontmatter.note && (
      <Frame n={5} class="!px-0">
          <div class="grid grid-cols-1 px-4 md:grid-cols-2 lg:px-14">
            <div class="pt-10 md:py-14 md:pr-10 md:border-r md:border-dashed md:border-base-200">
              <p class="font-mono text-xs tracking-wider uppercase text-accent-600">
                Da sapere
              </p>
              <h2 class="mt-4 text-2xl font-normal tracking-tight text-base-900">
                {frontmatter.note.label}
              </h2>
            </div>
            <div class="pt-4 pb-10 md:py-14 md:pl-10">
              <p class="max-w-md text-base leading-relaxed text-base-600">
                {frontmatter.note.text}
              </p>
            </div>
          </div>
      </Frame>
    )
  }

  <!-- La catena: precedente e successivo come celle -->
  <Frame n={6} class="!px-0">
      <nav
        aria-label="Agente precedente e successivo"
        class="grid grid-cols-1 px-4 md:grid-cols-2 lg:px-14"
      >
        <a
          href={prev ? "/agenti/" + prev.id + "/" : "/#agenti"}
          rel={prev ? "prev" : undefined}
          class="flex flex-col py-10 gap-2 group md:pr-10 md:border-r md:border-dashed md:border-base-200 max-md:border-b max-md:border-dashed max-md:border-base-200"
        >
          <span class="flex items-center font-mono text-xs tracking-wider uppercase gap-1 text-accent-600">
            <ChevronRight
              size="sm"
              class="rotate-180 duration-300 group-hover:-translate-x-1"
            />
            {prev ? "Agente " + prev.n : "La catena"}
          </span>
          <span class="text-xl font-normal tracking-tight md:text-2xl text-base-900 transition-colors duration-200 group-hover:text-accent-600">
            {prev ? prev.name : "Tutti gli agenti"}
          </span>
          <span class="max-w-sm text-sm text-base-500">
            {
              prev
                ? prev.summary
                : "Dalla keyword all'articolo pronto per il CMS, in un'unica corsa."
            }
          </span>
        </a>
        <a
          href={next ? "/agenti/" + next.id + "/" : "/#agenti"}
          rel={next ? "next" : undefined}
          class="flex flex-col py-10 gap-2 group md:pl-10 md:items-end md:text-right"
        >
          <span class="flex items-center font-mono text-xs tracking-wider uppercase gap-1 text-accent-600">
            {next ? "Agente " + next.n : "La catena"}
            <ChevronRight
              size="sm"
              class="duration-300 group-hover:translate-x-1"
            />
          </span>
          <span class="text-xl font-normal tracking-tight md:text-2xl text-base-900 transition-colors duration-200 group-hover:text-accent-600">
            {next ? next.name : "Tutti gli agenti"}
          </span>
          <span class="max-w-sm text-sm text-base-500">
            {
              next
                ? next.summary
                : "Dalla keyword all'articolo pronto per il CMS, in un'unica corsa."
            }
          </span>
        </a>
      </nav>
  </Frame>

  <Cta2
    compact
    title="Prova l'intera catena di agenti"
    text="Parti da una keyword: brief, analisi della SERP, articolo ed esportazione in un'unica corsa. Gratis per 30 giorni."
    secondaryText="Parla con noi"
    secondaryHref="/contatti/"
  />
</BaseLayout>
