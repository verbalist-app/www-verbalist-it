---
// Pagina agente sul pattern "feature page" di Profound, tradotto nel sistema
// chiaro di Verbalist: sotto-nav della catena, manifesto che si accende allo
// scroll, blocco prodotto con titolo grande e finestra app, poi celle della
// griglia tratteggiata al posto delle colonne centrate.
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
// Blocchi condivisi delle pagine feature
import SubNav from "@/components/featurepage/SubNav.astro";
import Manifesto from "@/components/featurepage/Manifesto.astro";
import SectionHead from "@/components/featurepage/SectionHead.astro";
// Mockup degli agenti (variante "card": solo la scheda, senza pannello)
import MockupBrief from "@/components/features/agents/MockupBrief.astro";
import MockupSerp from "@/components/features/agents/MockupSerp.astro";
import MockupArticle from "@/components/features/agents/MockupArticle.astro";
import MockupExport from "@/components/features/agents/MockupExport.astro";
import MockupWindow from "@/components/features/agents/MockupWindow.astro";
import MockupOutcome from "@/components/features/agents/MockupOutcome.astro";
import Cta2 from "@/components/ctas/Cta2.astro";

// slug: id della pagina; all: i quattro agenti ({ id, n, name }) per la
// sotto-nav; prev/next: agente precedente e successivo, con la sintesi.
const { frontmatter, slug, all = [], prev = null, next = null } = Astro.props;

// Pannello dipinto + finestra app, come in home (chiave = frontmatter.mockup)
const mockups: Record<string, any> = {
  brief: MockupBrief,
  serp: MockupSerp,
  article: MockupArticle,
  "export": MockupExport,
};
const Mockup = mockups[frontmatter.mockup] ?? MockupBrief;

const heroImages: Record<string, string> = {
  brief: "/img/agent-brief.webp",
  serp: "/img/agent-serp.webp",
  article: "/img/agent-article.webp",
  "export": "/img/agent-export.webp",
};
const heroImage = heroImages[frontmatter.mockup] ?? heroImages.brief;

const appUrls: Record<string, string> = {
  brief: "app.verbalist.it/nuovo",
  serp: "app.verbalist.it/analisi",
  article: "app.verbalist.it/editor",
  "export": "app.verbalist.it/esporta",
};
const appUrl = appUrls[frontmatter.mockup] ?? appUrls.brief;

const TRIAL_URL =
  "https://app.verbalist.it/login?registration&code=PROVAGRATUITA26";

const ioCells = [
  { eyebrow: "In ingresso", title: "Cosa riceve", items: frontmatter.input },
  { eyebrow: "In uscita", title: "Cosa consegna", items: frontmatter.output },
];
---

<BaseLayout
  seo={{
    title: frontmatter.seoTitle,
    description: frontmatter.seoDescription ?? frontmatter.lede,
  }}
>
  <SubNav
    label="Gli agenti della catena"
    home={{ href: "/#agenti", label: "Agenti" }}
    items={all.map((a: { id: string; n: string; name: string }) => ({
      href: `/agenti/${a.id}/`,
      label: a.name,
      n: a.n,
    }))}
    current={`/agenti/${slug}/`}
  />

  <Manifesto
    eyebrow={`Agente ${frontmatter.n} · ${frontmatter.role}`}
    headline={frontmatter.headline}
    text={frontmatter.lede}
    stepsLead={frontmatter.stepsLead}
    steps={frontmatter.steps}
    image={heroImage}
  />

  <!-- Il prodotto: titolo grande, azioni, finestra app -->
  <section class="border-t border-dashed border-base-200">
    <Wrapper variant="standard" class="pt-16 pb-4 lg:pt-24">
      <SectionHead
        eyebrow={`Agente ${frontmatter.n} di 04`}
        title={frontmatter.pitch ?? frontmatter.name}
        text={frontmatter.intro}
      >
        <Button isLink size="sm" variant="accent" href={TRIAL_URL}>
          Prova gratis 30 giorni
        </Button>
        <Button isLink size="sm" variant="muted" href="/contatti/">
          Parla con noi
        </Button>
      </SectionHead>
      <div
        class="relative p-5 mt-12 overflow-hidden rounded-xl bg-mist-100 bg-cover bg-center sm:p-10 md:p-14"
        style={`background-image: url('${heroImage}')`}
      >
        <div class="absolute inset-0 bg-mist-100/25" aria-hidden="true"></div>
        <MockupWindow url={appUrl}>
          <Mockup variant="card" />
        </MockupWindow>
      </div>
    </Wrapper>
  </section>

  <!-- Ingresso e uscita: due celle della griglia -->
  <section class="border-t border-dashed border-base-200">
    <Wrapper variant="standard" class="py-0">
      <div class="grid grid-cols-1 md:grid-cols-2">
        {
          ioCells.map((cell, i) => (
            <div
              class:list={[
                "py-10 lg:py-14",
                i === 0
                  ? "md:pr-10 md:border-r md:border-dashed md:border-base-200 max-md:border-b max-md:border-dashed max-md:border-base-200"
                  : "md:pl-10",
              ]}
            >
              <p class="font-mono text-xs font-medium tracking-wider uppercase text-base-500">
                {cell.eyebrow}
              </p>
              <Text
                tag="h2"
                variant="textXL"
                class="mt-3 font-serif font-medium tracking-tight text-base-950"
              >
                {cell.title}
              </Text>
              <ul role="list" class="mt-6">
                {cell.items.map((item: string) => (
                  <li class="py-3.5 text-base border-t border-dashed border-base-200 text-base-600">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Wrapper>
  </section>

  <!-- Come funziona: prosa con link interni + l'output della fase -->
  {
    Astro.slots.has("default") && (
      <section class="border-t border-dashed border-base-200">
        <Wrapper variant="standard" class="py-0">
          <div class="grid grid-cols-1 lg:grid-cols-2">
            <div class="py-12 lg:py-20 lg:pr-10 lg:border-r lg:border-dashed lg:border-base-200">
              <Wrapper
                variant="prose"
                class="max-w-xl [&_h2]:font-serif [&_h2]:font-medium [&_h2]:tracking-tight [&_h2]:text-base-950 [&_h2]:text-3xl lg:[&_h2]:text-5xl lg:[&_h2]:leading-[1.1] [&_h2]:mt-0 [&_h2]:mb-8"
              >
                <slot />
              </Wrapper>
            </div>
            <div class="pb-12 lg:py-20 lg:pl-10">
              <div class="lg:sticky lg:top-24">
                <p class="font-mono text-xs font-medium tracking-wider uppercase text-base-500">
                  Cosa ti porti a casa
                </p>
                <div class="p-6 mt-4 rounded-xl bg-mist-100 sm:p-8">
                  <MockupOutcome variant={frontmatter.mockup} />
                </div>
              </div>
            </div>
          </div>
        </Wrapper>
      </section>
    )
  }

  <!-- Nota: una cella a due colonne, domanda a sinistra e risposta a destra -->
  {
    frontmatter.note && (
      <section class="border-t border-dashed border-base-200">
        <Wrapper variant="standard" class="py-0">
          <div class="grid grid-cols-1 md:grid-cols-2">
            <div class="pt-10 md:py-14 md:pr-10 md:border-r md:border-dashed md:border-base-200">
              <p class="font-mono text-xs font-medium tracking-wider uppercase text-base-500">
                Da sapere
              </p>
              <Text
                tag="h2"
                variant="textXL"
                class="mt-3 font-serif font-medium tracking-tight text-base-950"
              >
                {frontmatter.note.label}
              </Text>
            </div>
            <div class="pt-4 pb-10 md:py-14 md:pl-10">
              <Text tag="p" variant="textBase" class="max-w-md text-base-600">
                {frontmatter.note.text}
              </Text>
            </div>
          </div>
        </Wrapper>
      </section>
    )
  }

  <!-- La catena: precedente e successivo come celle -->
  <section class="border-t border-dashed border-base-200">
    <Wrapper variant="standard" class="py-0">
      <nav
        aria-label="Agente precedente e successivo"
        class="grid grid-cols-1 md:grid-cols-2"
      >
        <a
          href={prev ? "/agenti/" + prev.id + "/" : "/#agenti"}
          rel={prev ? "prev" : undefined}
          class="flex flex-col py-10 gap-2 group md:pr-10 md:border-r md:border-dashed md:border-base-200 max-md:border-b max-md:border-dashed max-md:border-base-200"
        >
          <span class="flex items-center font-mono text-xs font-medium tracking-wider uppercase gap-1 text-base-500">
            <ChevronRight
              size="sm"
              class="rotate-180 duration-300 group-hover:-translate-x-1"
            />
            {prev ? "Agente " + prev.n : "La catena"}
          </span>
          <span class="font-serif text-xl font-medium tracking-tight md:text-2xl text-base-950 transition-colors duration-200 group-hover:text-base-600">
            {prev ? prev.name : "Tutti gli agenti"}
          </span>
          <span class="max-w-sm text-sm text-base-500">
            {
              prev
                ? prev.summary
                : "Dalla keyword all'articolo pronto per il CMS, in un'unica corsa."
            }
          </span>
        </a>
        <a
          href={next ? "/agenti/" + next.id + "/" : "/#agenti"}
          rel={next ? "next" : undefined}
          class="flex flex-col py-10 gap-2 group md:pl-10 md:items-end md:text-right"
        >
          <span class="flex items-center font-mono text-xs font-medium tracking-wider uppercase gap-1 text-base-500">
            {next ? "Agente " + next.n : "La catena"}
            <ChevronRight
              size="sm"
              class="duration-300 group-hover:translate-x-1"
            />
          </span>
          <span class="font-serif text-xl font-medium tracking-tight md:text-2xl text-base-950 transition-colors duration-200 group-hover:text-base-600">
            {next ? next.name : "Tutti gli agenti"}
          </span>
          <span class="max-w-sm text-sm text-base-500">
            {
              next
                ? next.summary
                : "Dalla keyword all'articolo pronto per il CMS, in un'unica corsa."
            }
          </span>
        </a>
      </nav>
    </Wrapper>
  </section>

  <Cta2
    compact
    title="Prova l'intera catena di agenti"
    text="Parti da una keyword: brief, analisi della SERP, articolo ed esportazione in un'unica corsa. Gratis per 30 giorni."
    secondaryText="Parla con noi"
    secondaryHref="/contatti/"
  />
</BaseLayout>
