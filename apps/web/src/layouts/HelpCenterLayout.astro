---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import User from "@/components/fundations/icons/User.astro";
import Shield from "@/components/fundations/icons/Shield.astro";
import Settings from "@/components/fundations/icons/Settings.astro";
import CreditCard from "@/components/fundations/icons/CreditCard.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import InfoCircle from "@/components/fundations/icons/InfoCircle.astro";
const { frontmatter } = Astro.props;
const icons = {
  user: User,
  settings: Settings,
  shield: Shield,
  creditCard: CreditCard,
};
const IconComponent = icons[frontmatter.iconId] || InfoCircle;
// Breadcrumbs Data
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Help center", href: "/help/" },
  { label: frontmatter.page, href: "#" }, // Current page (unstyled)
];

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.label,
    ...(b.href && b.href !== "#"
      ? { item: new URL(b.href, "https://www.verbalist.it").toString() }
      : {}),
  })),
};
---

<BaseLayout
  seo={{ title: frontmatter.page, description: frontmatter.description }}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbLd)}
  />
  <div class="pt-[72px]">
    <Frame n={1} flush tone="soft" class="pt-8 pb-12 lg:pt-10 lg:pb-16 lg:!px-14">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center font-mono text-xs tracking-wider uppercase gap-2 text-base-500">
          {
            breadcrumbs.map((item, index) => (
              <>
                <li>
                  {index < breadcrumbs.length - 1 ? (
                    <a href={item.href} class="hover:text-accent-600">{item.label}</a>
                  ) : (
                    <span class="block truncate max-w-[12rem] sm:max-w-sm text-accent-600">{item.label}</span>
                  )}
                </li>
                {index < breadcrumbs.length - 1 && <li aria-hidden="true">/</li>}
              </>
            ))
          }
        </ol>
      </nav>
      <div class="max-w-3xl mt-10">
        <p class="flex items-center font-mono text-xs tracking-wider uppercase gap-2 text-base-500">
          <IconComponent size="sm" class="text-accent-600" aria-hidden="true" />
          {frontmatter.category && <span>{frontmatter.category}</span>}
          <span aria-hidden="true">·</span>
          <span>
            Aggiornato a
            <time datetime={frontmatter.lastUpdated}>
              {new Date(frontmatter.lastUpdated).toLocaleDateString("it-IT", { year: "numeric", month: "long" })}
            </time>
          </span>
        </p>
        <h1 class="mt-6 text-4xl leading-[1.1] font-normal tracking-[-0.025em] text-base-900 text-balance lg:text-5xl lg:leading-[1.08]">
          {frontmatter.page}
        </h1>
        <p class="max-w-xl mt-6 text-lg font-light leading-snug text-base-600">{frontmatter.description}</p>
      </div>
    </Frame>
    <Frame n={2} class="py-12 lg:py-16 lg:!px-14">
      <Wrapper variant="prose" class="max-w-xl">
        <slot />
      </Wrapper>
    </Frame>
    {
      (frontmatter.faq ?? []).length > 0 && (
        <Frame n={3} class="py-16 lg:py-24 lg:!px-14">
          <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
            <div>
              <Head tag="Domande" title="Su questo argomento" />
              <p class="mt-6 text-base text-base-600">Le risposte rapide.</p>
            </div>
            <dl>
              {frontmatter.faq.map((item) => (
                <div class="py-5 border-t border-dashed border-base-200 last:border-b">
                  <dt class="text-lg text-base-900">{item.question}</dt>
                  <dd class="max-w-2xl mt-2 text-md leading-relaxed text-base-600">{item.answer}</dd>
                </div>
              ))}
            </dl>
          </div>
        </Frame>
      )
    }
  </div>
</BaseLayout>
