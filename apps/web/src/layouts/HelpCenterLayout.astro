---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import User from "@/components/fundations/icons/User.astro";
import Shield from "@/components/fundations/icons/Shield.astro";
import Settings from "@/components/fundations/icons/Settings.astro";
import CreditCard from "@/components/fundations/icons/CreditCard.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import InfoCircle from "@/components/fundations/icons/InfoCircle.astro";
const { frontmatter } = Astro.props;
const icons = {
  user: User,
  settings: Settings,
  shield: Shield,
  creditCard: CreditCard,
};
const IconComponent = icons[frontmatter.iconId] || InfoCircle;
// Breadcrumbs Data
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Help center", href: "/help/" },
  { label: frontmatter.page, href: "#" }, // Current page (unstyled)
];

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.label,
    ...(b.href && b.href !== "#"
      ? { item: new URL(b.href, "https://www.verbalist.it").toString() }
      : {}),
  })),
};
---

<BaseLayout
  seo={{ title: frontmatter.page, description: frontmatter.description }}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbLd)}
  />
  <section>
    <Wrapper variant="standard" class="pt-32 pb-4">
      <div class="max-w-xl mx-auto text-balance">
        <nav
          aria-label="Breadcrumb"
          class="bg-mist-100 p-1.5 rounded-full px-6 w-fit"
        >
          <ol class="flex items-center text-sm gap-x-2 text-base-600">
            {
              breadcrumbs.map((item, index) => (
                <>
                  <li>
                    {index < breadcrumbs.length - 1 ? (
                      <a
                        href={item.href}
                        class="text-xs font-medium hover:text-accent-500 text-base-800"
                      >
                        {item.label}
                      </a>
                    ) : (
                      <span class="block truncate max-w-[10rem] sm:max-w-xs md:max-w-sm text-xs font-medium text-accent-500">
                        {item.label}
                      </span>
                    )}
                  </li>
                  {index < breadcrumbs.length - 1 && (
                    <li class="text-base-400">
                      <ChevronRight size="sm" />
                    </li>
                  )}
                </>
              ))
            }
          </ol>
        </nav>
        <Text
          tag="h1"
          variant="displayMD"
          class="mt-12 font-serif font-medium tracking-tight text-black"
        >
          {frontmatter.page}
        </Text>
        <Text variant="textBase" class="mt-4 text-base-600">
          {frontmatter.description}
        </Text>
      </div>
    </Wrapper>
  </section>
  <section>
    <Wrapper variant="standard" class="py-12 border-t border-dashed">
      <Wrapper variant="prose" class="max-w-xl mx-auto">
        <Text
          variant="textBase"
          class="flex items-center font-medium text-base-500 gap-2"
        >
          <IconComponent size="sm" class="text-accent-500" />
          <span>
            Aggiornato a
            <time datetime="{frontmatter.lastUpdated}">
              {
                new Date(frontmatter.lastUpdated).toLocaleDateString("it-IT", {
                  year: "numeric",
                  month: "long",
                })
              }
            </time>
          </span>
        </Text>
        <slot />
      </Wrapper>
    </Wrapper>
  </section>
  <section class="border-t border-base-200 border-dashed">
    <Wrapper variant="standard" class="py-12">
      <div class="max-w-xl mx-auto">
        <div class="text-center">
          <Text
            tag="h2"
            variant="displaySM"
            class="font-serif font-medium text-black"
          >
            Domande frequenti
          </Text>

          <Text tag="p" variant="textBase" class="mt-4 text-base-500">
            Le risposte rapide su questo argomento
          </Text>
        </div>
        <ul class="mt-12 list-none space-y-4">
          {
            (frontmatter.faq ?? []).map((item) => (
              <li class="flex">
                <div>
                  <Text
                    tag="h3"
                    variant="textBase"
                    class="font-medium text-base-800"
                  >
                    {item.question}
                  </Text>
                  <Text variant="textBase" class="mt-2 text-base-500">
                    {item.answer}
                  </Text>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
