---
// Assets
import { Image } from "astro:assets";

// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Frame from "@/components/section/Frame.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
const { frontmatter } = Astro.props;
// Breadcrumbs Data
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: frontmatter.page, href: "#" },
];

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.label,
    ...(b.href && b.href !== "#"
      ? { item: new URL(b.href, "https://www.verbalist.it").toString() }
      : {}),
  })),
};
---

<BaseLayout
  seo={{
    title: frontmatter.seoTitle ?? frontmatter.page,
    description: frontmatter.description,
    image: frontmatter.image,
    type: "article",
    publishedTime: new Date(frontmatter.pubDate).toISOString(),
  }}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbLd)}
  />
  <div class="pt-[72px]">
    <Frame n={1} flush tone="soft" class="pt-8 pb-12 lg:pt-10 lg:pb-16 lg:!px-14">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center font-mono text-xs tracking-wider uppercase gap-2 text-base-500">
          {
            breadcrumbs.map((item, index) => (
              <>
                <li>
                  {index < breadcrumbs.length - 1 ? (
                    <a href={item.href} class="hover:text-accent-600">{item.label}</a>
                  ) : (
                    <span class="block truncate max-w-[12rem] sm:max-w-sm text-accent-600">{item.label}</span>
                  )}
                </li>
                {index < breadcrumbs.length - 1 && <li aria-hidden="true">/</li>}
              </>
            ))
          }
        </ol>
      </nav>
      <div class="max-w-3xl mt-10">
        <p class="font-mono text-xs tracking-wider uppercase text-base-500">
          Pubblicato il
          <time datetime={new Date(frontmatter.pubDate).toISOString()}>
            {new Date(frontmatter.pubDate).toLocaleDateString("it-IT", { day: "numeric", month: "long", year: "numeric" })}
          </time>
        </p>
        <h1 class="mt-6 text-4xl leading-[1.1] font-normal tracking-[-0.025em] text-base-900 text-balance lg:text-5xl lg:leading-[1.08]">
          {frontmatter.page}
        </h1>
      </div>

    </Frame>
    <Frame n={2} class="py-12 lg:py-16 lg:!px-14">
      <Wrapper variant="prose" class="max-w-xl [&_h2]:font-mono [&_h2]:text-xs [&_h2]:font-normal [&_h2]:uppercase [&_h2]:tracking-wider [&_h2]:text-accent-600 [&_h2]:mt-8 [&_h2]:mb-3">
        <slot />
      </Wrapper>
    </Frame>
  </div>
</BaseLayout>
