---
// Pagina soluzione (/soluzioni/<slug>/): stesso linguaggio delle pagine
// agente (pattern "feature page"): sotto-nav, manifesto, blocco "In breve"
// con titolo grande e brief d'esempio, griglia di celle, prosa + piano,
// casi reali, FAQ. Tutti i contenuti arrivano dal frontmatter della
// collection `solutions`: vedi le regole di prodotto in content.config.ts.
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Check from "@/components/fundations/icons/Check.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
// Blocchi condivisi delle pagine feature
import SubNav from "@/components/featurepage/SubNav.astro";
import Manifesto from "@/components/featurepage/Manifesto.astro";
import SectionHead from "@/components/featurepage/SectionHead.astro";
// Prodotto
import ProductCard from "@/components/featurepage/ProductCard.astro";
import BriefWindow from "@/components/features/agents/BriefWindow.astro";
import ProjectsWindow from "@/components/features/agents/ProjectsWindow.astro";
import ContextWindow from "@/components/features/agents/ContextWindow.astro";
import DocumentsWindow from "@/components/features/agents/DocumentsWindow.astro";
import ProductPageWindow from "@/components/features/agents/ProductPageWindow.astro";
import ChainFragment from "@/components/home/ChainFragment.astro";
import Cta2 from "@/components/ctas/Cta2.astro";
import Frame from "@/components/section/Frame.astro";
import { contactHref } from "@/lib/utils";
import { svgSize } from "@/lib/svgSize";

// slug: id della pagina · all: tutte le soluzioni ({ id, name, doorTitle })
// customers: i clienti citati nella prova, già risolti ({ slug, name, logo, fact })
const { frontmatter, slug, all = [], customers = [] } = Astro.props;
// Posizione della finestra nell'hero a lg: il bordo della card non deve
// tagliare a metà pulsanti ed etichette (misurato per finestra)
const winLg = ({ agenzie: "lg:left-[42%]", pmi: "lg:left-[39%]", ecommerce: "lg:left-[44%]" } as Record<string, string>)[frontmatter.audience] ?? "";

const SITE = "https://www.verbalist.it";
const TRIAL_URL =
  "https://app.verbalist.it/login?registration&code=PROVAGRATUITA26";
const contactUrl = contactHref(frontmatter.audience);
const pageUrl = `${SITE}/soluzioni/${slug}/`;

// CTA: la prova self-service o la chiamata, a seconda del pubblico.
const trial = { text: "Prova gratis", href: TRIAL_URL };
const talk = { text: "Parla con noi", href: contactUrl };
const [primary, secondary] =
  frontmatter.primaryCta === "contatti" ? [talk, trial] : [trial, talk];

const others = all.filter((s: { id: string }) => s.id !== slug);
const multiBrief = frontmatter.briefs.length > 1;

// Il pezzo di prodotto in testa a ogni cella di "Cosa cambia", scelto dalla
// pagina che la cella approfondisce. Per ogni link c'è una lista di schermate
// in ordine di pertinenza: si prende la prima non ancora usata nella pagina,
// così le sei celle mostrano sei schermate diverse. Senza alternative libere
// la cella resta di testo.
type Peek = "brief" | "context" | "serp" | "progress" | "riepilogo" | "write" | "export" | "ottimizza" | "crediti" | "documenti";
const PEEKS: [RegExp, Peek[]][] = [
  [/^help\/creazione-documento/, ["brief", "documenti", "riepilogo"]],
  [/^help\/contesto-e-pdf/, ["context"]],
  [/^agenti\/analisi-competitor/, ["progress", "serp"]],
  [/^help\/url-competitor/, ["progress", "serp"]],
  [/^agenti\/generazione-articolo/, ["write", "progress", "documenti"]],
  [/^changelog\/verbalist-2-0-4/, ["write"]],
  [/^agenti\/esportazione-contenuto/, ["export"]],
  [/^help\/crediti-ed-errori/, ["crediti", "riepilogo"]],
  [/^help\/ottimizzazione-contenuto/, ["ottimizza"]],
  [/^#prezzi/, ["riepilogo", "crediti"]],
];
const used = new Set<Peek>();
const peekFor = (href?: string): Peek | null => {
  const path = (href ?? "").replace(/^\/+/, "");
  const list = PEEKS.find(([re]) => re.test(path))?.[1] ?? [];
  const pick = list.find((p) => !used.has(p)) ?? null;
  if (pick) used.add(pick);
  return pick;
};

// L'illustrazione dell'hero cambia con il pubblico: ognuno vede nell'app la
// cosa che gli serve. Dati d'esempio coerenti con i brief della pagina.
const brief0 = frontmatter.briefs[0];
const val = (label: string) => brief0.fields.find((f: { label: string }) => f.label === label)?.value ?? "";
const market0 = val("Mercato").split("·")[0].trim();
const projects = frontmatter.briefs.map((b: { project?: string }, i: number) => ({
  name: (b.project ?? "Progetto").replace(/^Progetto:\s*/i, ""),
  docs: [12, 9, 6][i] ?? 4,
  updated: ["oggi", "ieri", "3 giorni fa"][i] ?? "questa settimana",
}));
const pmiDocs = [
  { title: `${val("Keyword").charAt(0).toUpperCase() + val("Keyword").slice(1)}: la guida`, type: val("Tipo"), status: "Completato", date: "oggi" },
  { title: "Prezzi e tempi di consegna", type: "Blog/Articolo", status: "Completato", date: "ieri" },
  { title: "Domande frequenti sul servizio", type: "Guida/Tutorial", status: "In elaborazione", date: "ieri" },
  { title: "Chi siamo e come lavoriamo", type: "Landing Page", status: "Completato", date: "3 gg fa" },
] as const;

// Nomi dei progetti per la tabella Documenti della cella: solo quelli
// dichiarati nei brief della pagina (senza progetto la tabella mostra "-").
const projectNames = frontmatter.briefs
  .map((b: { project?: string }) => (b.project ?? "").replace(/^Progetto:\s*/i, "").trim())
  .filter(Boolean);

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
    {
      "@type": "ListItem",
      position: 2,
      name: "Soluzioni",
      item: `${SITE}/soluzioni/`,
    },
    { "@type": "ListItem", position: 3, name: frontmatter.name },
  ],
};
const pageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": pageUrl,
  url: pageUrl,
  name: frontmatter.seoTitle,
  description: frontmatter.seoDescription,
  inLanguage: "it",
  isPartOf: { "@id": `${SITE}/#website` },
  audience: {
    "@type": "BusinessAudience",
    audienceType: frontmatter.audienceType,
  },
  about: {
    "@type": "SoftwareApplication",
    name: "Verbalist",
    url: SITE,
    applicationCategory: "BusinessApplication",
  },
};
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: frontmatter.faq.map(
    (f: { question: string; answer: string }) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })
  ),
};
---

<BaseLayout
  audience={frontmatter.audience}
  seo={{
    title: frontmatter.seoTitle,
    description: frontmatter.seoDescription,
  }}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbLd)}
  />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(pageLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />

  <SubNav
    label="Le soluzioni per pubblico"
    home={{ href: "/soluzioni/", label: "Soluzioni" }}
    items={all.map((s: { id: string; name: string }) => ({
      href: `/soluzioni/${s.id}/`,
      label: s.name,
    }))}
    current={`/soluzioni/${slug}/`}
  />

  <Manifesto
    eyebrow={frontmatter.doorLink}
    headline={frontmatter.headline}
    text={frontmatter.lede}
    stepsLead={frontmatter.stepsLead}
    steps={frontmatter.steps}
  >
    <Fragment slot="card">
      <div class={`absolute overflow-hidden rounded-xl top-6 left-5 vb-window sm:top-10 sm:left-[38%] lg:top-12 ${winLg}`}>
        {frontmatter.audience === "agenzie" && <ProjectsWindow projects={projects} />}
        {frontmatter.audience === "corporate" && <ContextWindow market={market0} language={val("Lingua")} files={[brief0.file, "glossario.pdf"]} />}
        {frontmatter.audience === "pmi" && <DocumentsWindow docs={[...pmiDocs]} />}
        {frontmatter.audience === "ecommerce" && <ProductPageWindow title={val("Keyword").charAt(0).toUpperCase() + val("Keyword").slice(1)} keyword={val("Keyword")} />}
        {frontmatter.audience === "b2b" && <ContextWindow market={market0} language={val("Lingua")} files={[brief0.file, "schede-tecniche.pdf"]} />}
      </div>
    </Fragment>
  </Manifesto>

  <!-- In breve: la risposta secca (citabile), le azioni, il brief d'esempio -->
  <Frame n={2} class="pt-14 pb-14 lg:pt-20 lg:pb-20 lg:!px-14">
      <SectionHead
        eyebrow="In breve"
        title={frontmatter.pitch}
        text={frontmatter.summary}
      >
        <Button isLink size="base" variant="accent" href={primary.href}>
          {primary.text}
        </Button>
        <Button isLink size="base" variant="muted" href={secondary.href}>
          {secondary.text}
        </Button>
      </SectionHead>
      <ProductCard
        tone="foschia"
        label={`La procedura "Nuovo documento" di Verbalist compilata con ${multiBrief ? frontmatter.briefs.length + " brief d'esempio, uno per cliente" : "un brief d'esempio"}: ${frontmatter.briefs.map((b: { fields: { label: string; value: string }[] }) => b.fields.map((f) => f.value).join(", ")).join("; ")}.`}
        class={`mt-12 ${multiBrief ? "h-[20rem] sm:h-[22rem] lg:h-[24rem]" : "h-[20rem] sm:h-[22rem]"} [--vb-zoom:0.62] sm:[--vb-zoom:0.72] lg:[--vb-zoom:0.8]`}
      >
        {
          frontmatter.briefs.map((b: { fields: { label: string; value: string }[]; file?: string; project?: string }, i: number) => (
            <div
              class:list={[
                "absolute overflow-hidden rounded-xl vb-window",
                multiBrief
                  ? ["top-8 left-6", "top-14 left-[36%] hidden md:block", "top-20 left-[64%] hidden lg:block"][i]
                  : "top-8 left-1/2 -translate-x-1/2",
              ]}
            >
              <BriefWindow fields={b.fields} file={b.file} project={b.project} />
            </div>
          ))
        }
      </ProductCard>
  </Frame>

  <!-- Cosa cambia per questo pubblico: celle 3×2, ognuna con un pezzo di prodotto diverso -->
  <Frame n={3} class="pt-14 pb-0 lg:pt-20 lg:!px-14">
      <SectionHead
        eyebrow={frontmatter.needs.eyebrow}
        title={frontmatter.needs.title}
        text={frontmatter.needs.text}
      />
      <div
        class="grid grid-cols-1 mt-12 -mx-4 border-t border-dashed md:grid-cols-2 lg:grid-cols-3 border-base-200 lg:-mx-14"
      >
        {
          frontmatter.needs.items.map(
            (item: {
              title: string;
              text: string;
              href?: string;
              linkLabel?: string;
            }, i: number) => {
              const peek = peekFor(item.href);
              return (
                <div class="flex flex-col border-b border-dashed border-base-200 last:border-b-0 md:max-lg:[&:nth-child(odd)]:border-r md:max-lg:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:not(:nth-child(3n))]:border-r lg:[&:nth-last-child(-n+3)]:border-b-0 [--cell-x:1rem] lg:[--cell-x:2rem] lg:[&:nth-child(3n+1)]:[--cell-x:3.5rem] transition-colors duration-200 hover:bg-base-50">
                  {peek && (
                    <span aria-hidden="true" data-nosnippet class="relative block h-44 overflow-hidden vb-peek [--vb-zoom:0.66]">
                      <span class="absolute block top-6 left-(--cell-x) vb-peek-card">
                        <ChainFragment step={peek} projects={projectNames} />
                      </span>
                    </span>
                  )}
                  <div class:list={["flex flex-col px-(--cell-x) pb-6 grow lg:pb-7", peek ? "pt-2" : "pt-6 lg:pt-7"]}>
                    <h3 class="text-lg text-base-900">{item.title}</h3>
                    <p class="mt-2 text-md leading-relaxed text-base-600">{item.text}</p>
                    {item.href && (
                      <a
                        href={item.href}
                        class="pt-4 mt-auto text-sm w-fit text-base-900 transition-colors duration-200 hover:text-accent-600"
                      >
                        <span class="border-b border-dashed border-base-400">
                          {item.linkLabel ?? "Approfondisci"}
                        </span>
                      </a>
                    )}
                  </div>
                </div>
              );
            }
          )
        }
      </div>
  </Frame>

  <!-- In pratica: prosa con link interni + il piano da cui partire -->
  <Frame n={4} class="!px-0">
      <div class="grid grid-cols-1 px-4 lg:grid-cols-2 lg:px-14">
        <div
          class="py-12 lg:py-16 lg:pr-10 lg:border-r lg:border-dashed lg:border-base-200"
        >
          <Wrapper
            variant="prose"
            class="max-w-xl [&_h2]:font-normal [&_h2]:tracking-tight [&_h2]:text-base-900 [&_h2]:text-2xl lg:[&_h2]:text-3xl lg:[&_h2]:leading-[1.2] [&_h2]:mb-6 [&_h2:first-child]:mt-0"
          >
            <slot />
          </Wrapper>
        </div>
        <div class="pb-12 lg:py-16 lg:pl-10">
          <div class="lg:sticky lg:top-24">
            <div class="p-6 bg-white border rounded-xl border-base-200 sm:p-8">
              <p class="font-mono text-xs tracking-wider uppercase text-accent-600">Il piano da cui partire</p>
              <div class="flex flex-wrap items-baseline justify-between mt-6 gap-2">
                <h2 class="text-display-xs leading-none font-normal tracking-[-0.025em] text-base-900">
                  {frontmatter.plan.name}
                </h2>
                {
                  frontmatter.plan.price && (
                    <p class="text-sm text-base-500">
                      {frontmatter.plan.price}
                    </p>
                  )
                }
              </div>
              <p class="mt-4 text-md leading-relaxed text-base-600">
                {frontmatter.plan.text}
              </p>
              <ul
                role="list"
                class="mt-6 text-sm text-base-800"
              >
                {
                  frontmatter.plan.points.map((point: string) => (
                    <li class="flex items-start py-3 border-t border-dashed gap-3 border-base-200 last:border-b">
                      <span class="mt-2 rounded-full size-1.5 bg-accent-500 shrink-0" />
                      <span>{point}</span>
                    </li>
                  ))
                }
              </ul>
              <div class="flex flex-wrap items-center mt-8 gap-3">
                <Button isLink size="base" variant="accent" href={primary.href}>
                  {primary.text}
                </Button>
                <a
                  href="/#prezzi"
                  class="px-2 text-sm text-base-900 transition-colors duration-200 hover:text-accent-600"
                >
                  <span class="border-b border-dashed border-base-400"
                    >Tutti i piani</span
                  >
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
  </Frame>

  <!-- La prova: casi reali, una riga per cliente -->
  <Frame n={5} class="pt-14 pb-0 lg:pt-20 lg:!px-14">
      <SectionHead
        eyebrow={frontmatter.proof.eyebrow}
        title={frontmatter.proof.title}
        text={frontmatter.proof.text}
      />
      <ul role="list" class="mt-12 -mx-4 lg:-mx-14">
        {
          customers.map(
            (c: {
              slug: string;
              name: string;
              logo: string;
              fact: string;
            }) => (
              <li class="relative grid items-center grid-cols-1 px-4 py-5 border-t border-dashed gap-x-10 gap-y-3 group border-base-200 md:grid-cols-[11rem_1fr_auto] lg:px-14 transition-colors duration-200 hover:bg-base-50">
                <img
                  src={c.logo}
                  alt={c.name}
                  {...svgSize(c.logo, 20)}
                  class="w-auto h-5 max-w-[8rem] object-contain object-left grayscale opacity-70"
                  loading="lazy"
                />
                <div>
                  <p class="font-mono text-xs tracking-wider uppercase text-base-500">
                    {c.name}
                  </p>
                  <p class="mt-1 text-md leading-relaxed text-base-800">
                    {c.fact}
                  </p>
                </div>
                <a
                  href={`/clienti/${c.slug}/`}
                  class="flex items-center text-sm gap-1 text-base-900 group-hover:text-accent-600 after:absolute after:inset-0"
                >
                  <span class="sr-only">{c.name}:</span>
                  Leggi il case study
                  <ChevronRight
                    size="sm"
                    class="duration-300 group-hover:translate-x-1"
                  />
                </a>
              </li>
            )
          )
        }
      </ul>
  </Frame>

  <!-- FAQ: titolo a sinistra, domande a destra, separate da un filo -->
  <Frame n={6} class="!px-0">
      <div class="grid grid-cols-1 px-4 lg:grid-cols-2 lg:px-14">
        <div
          class="pt-12 lg:py-16 lg:pr-10 lg:border-r lg:border-dashed lg:border-base-200"
        >
          <SectionHead
            eyebrow="Prima di iniziare"
            title="Domande frequenti"
          />
        </div>
        <div class="py-8 lg:py-12 lg:pl-10">
          {
            frontmatter.faq.map(
              (faq: { question: string; answer: string }) => (
                <details class="border-b border-dashed cursor-pointer border-base-200 group last:border-b-0">
                  <summary
                    data-gtm="faq-accordion"
                    class="flex items-start justify-between w-full py-5 text-lg text-left select-none gap-4 text-base-900 hover:text-accent-600 [&::-webkit-details-marker]:hidden list-none"
                  >
                    {faq.question}
                    <svg
                      class="mt-1 size-4 shrink-0 duration-300 ease-out text-accent-500 transform group-open:rotate-45"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 6v12m6-6H6"
                      />
                    </svg>
                  </summary>
                  <p class="pb-6 pr-8 text-md leading-relaxed text-base-600">{faq.answer}</p>
                </details>
              )
            )
          }
        </div>
      </div>
  </Frame>

  <!-- Le altre soluzioni: celle -->
  <Frame n={7} class="!px-0">
      <nav
        aria-label="Altre soluzioni"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          others.map(
            (s: { id: string; name: string; doorTitle: string }) => (
              <a
                href={`/soluzioni/${s.id}/`}
                class="flex flex-col px-4 py-8 border-b border-dashed gap-2 group border-base-200 last:border-b-0 sm:max-lg:[&:nth-child(odd)]:border-r sm:max-lg:[&:nth-last-child(-n+2)]:border-b-0 lg:border-b-0 lg:px-8 lg:[&:not(:last-child)]:border-r lg:first:pl-14 lg:last:pr-14 transition-colors duration-200 hover:bg-base-50"
              >
                <span class="flex items-center font-mono text-xs tracking-wider uppercase gap-1 text-accent-600">
                  {s.name}
                  <ChevronRight
                    size="sm"
                    class="duration-300 group-hover:translate-x-1"
                  />
                </span>
                <span class="text-lg font-normal tracking-tight text-base-900">
                  {s.doorTitle}
                </span>
              </a>
            )
          )
        }
      </nav>
  </Frame>

  <Cta2
    compact
    title={frontmatter.cta.title}
    text={frontmatter.cta.text}
    primaryText={primary.text}
    primaryHref={primary.href}
    secondaryText={secondary.text}
    secondaryHref={secondary.href}
  />
</BaseLayout>
