---
// Assets
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import ShareButtons from "@/components/fundations/elements/ShareButtons.astro";
import BlogCard from "@/components/blog/BlogCard.astro";
import Cta2 from "@/components/ctas/Cta2.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
const { frontmatter } = Astro.props;
// Data utilities
import {
  getRelatedPosts,
  getTeamMemberBySlug,
  slugifyTag,
} from "@/lib/data";

// Get the current slug from the URL
const currentSlug = Astro.url.pathname.split("/").filter(Boolean).pop() || "";

// Fetch related posts using the data utility
const relatedPosts = await getRelatedPosts(currentSlug, frontmatter.tags || []);

// Fetch team member if the post has a team reference
let team = null;
if (frontmatter.team) {
  team = await getTeamMemberBySlug(frontmatter.team);
}

// SEO data from frontmatter
const seo = {
  title: frontmatter.seoTitle ?? frontmatter.title,
  description: frontmatter.seoDescription ?? frontmatter.description,
  image: frontmatter.image,
  type: "article" as const,
  publishedTime: frontmatter.pubDate?.toISOString(),
};

const siteUrl = "https://www.verbalist.it";
const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: frontmatter.title,
  description: frontmatter.description,
  image: new URL(frontmatter.image.url, siteUrl).toString(),
  datePublished: new Date(frontmatter.pubDate).toISOString(),
  // Nessun campo di revisione nei post: la modifica coincide con l'uscita
  dateModified: new Date(frontmatter.pubDate).toISOString(),
  inLanguage: "it",
  author: team
    ? {
        "@type": "Person",
        name: team.data.name,
        jobTitle: team.data.role,
        url: new URL(`/team/${team.slug}/`, siteUrl).toString(),
        sameAs: [team.data.socials?.linkedin, team.data.socials?.website].filter(Boolean),
      }
    : { "@type": "Organization", "@id": `${siteUrl}/#organization`, name: "Verbalist" },
  publisher: {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    name: "Verbalist",
    url: siteUrl,
    logo: { "@type": "ImageObject", url: `${siteUrl}/android-chrome-512x512.png` },
  },
  mainEntityOfPage: new URL(Astro.url.pathname, siteUrl).toString(),
};

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog/" },
  { label: frontmatter.title, href: "#" },
];
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.label,
    ...(b.href && b.href !== "#"
      ? { item: new URL(b.href, siteUrl).toString() }
      : {}),
  })),
};
import Unbroken from "@/components/fundations/elements/Unbroken.astro";
---

<BaseLayout seo={seo}>
  <link
    slot="head"
    rel="alternate"
    type="text/markdown"
    href={`${siteUrl}/blog/${currentSlug}.md`}
    title="Versione Markdown per agenti e LLM"
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(articleLd)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbLd)}
  />
  <div class="pt-[72px]">
  <section class="border-b border-dashed border-base-200 bg-base-50">
    <Wrapper variant="standard" class="pt-8 pb-12 lg:pt-10 lg:pb-16 lg:px-14">
      <div class="flex items-center justify-between gap-4">
      <nav aria-label="Breadcrumb" class="min-w-0">
        <ol class="flex flex-wrap items-center font-mono text-xs tracking-wider uppercase gap-2 text-base-500">
          {
            breadcrumbs.map((item, index) => (
              <>
                <li>
                  {index < breadcrumbs.length - 1 ? (
                    <a href={item.href} class="hover:text-accent-600">{item.label}</a>
                  ) : (
                    <span class="block truncate max-w-[12rem] sm:max-w-sm text-accent-600">{item.label}</span>
                  )}
                </li>
                {index < breadcrumbs.length - 1 && <li aria-hidden="true">/</li>}
              </>
            ))
          }
        </ol>
      </nav>
      <!-- Lo stesso articolo in Markdown (route blog/[slug].md.ts), per agenti e LLM -->
      <a
        href={`/blog/${currentSlug}.md`}
        type="text/markdown"
        title="Lo stesso articolo in Markdown, per agenti e LLM"
        class="relative inline-flex items-center h-8 px-3 font-mono text-xs tracking-wider uppercase bg-white border rounded-full tap-target shrink-0 border-base-200 text-base-600 hover:border-base-300 hover:text-base-900"
      >
        Markdown<span class="sr-only"> di questo articolo</span>
      </a>
      </div>
      <div class="max-w-3xl mt-10">
        <h1 class="text-4xl leading-[1.1] font-normal tracking-[-0.025em] text-base-900 text-balance lg:text-5xl lg:leading-[1.08]">
          <Unbroken text={frontmatter.title} />
        </h1>
        <p class="max-w-xl mt-6 text-lg font-light leading-snug text-base-600">
          {frontmatter.description}
        </p>
      </div>

    </Wrapper>
  </section>
  <section>
    <Wrapper variant="standard" class="pt-12 pb-4 border-t border-base-200 border-dashed">
      <div class="max-w-xl mx-auto">
        {
          frontmatter.tldr && frontmatter.tldr.length > 0 && (
            <details open class="mb-10 bg-white border group border-base-200 rounded-xl">
              <summary class="flex items-center justify-between px-5 py-3.5 font-mono text-xs font-medium tracking-wider uppercase select-none cursor-pointer list-none text-base-700 [&::-webkit-details-marker]:hidden">
                Riassunto
                <svg
                  class="size-4 text-base-500 duration-300 transition-transform group-open:rotate-180"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <ul class="flex flex-col px-5 pb-4 gap-2">
                {frontmatter.tldr.map((point: string) => (
                  <li class="flex items-start gap-2 text-sm leading-relaxed text-base-700">
                    <span class="shrink-0 text-base-500">—</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </details>
          )
        }
        <Wrapper variant="prose">
          <slot />
        </Wrapper>
        <div class="w-full pt-8 mt-8 border-t border-base-200 border-dashed">
          {
            team && (
              <div class="flex items-center gap-3 hover:opacity-80 transition ">
                <a href={`/team/${team.slug}/`}>
                  {team?.data?.image?.url && (
                    <Image
                      width={100}
                      height={100}
                      src={team.data.image.url}
                      alt={team.data.image.alt}
                      class="inline-block object-cover object-center rounded-lg size-10 bg-mist-100"
                    />
                  )}
                </a>
                <Text tag="p" variant="textXS" class="text-base-500 ">
                  <span class="">
                    Pubblicato il
                    <span class="font-medium  text-base-500">
                      <time
                        datetime={new Date(frontmatter.pubDate).toISOString()}
                      >
                        {new Date(frontmatter.pubDate).toLocaleDateString(
                          "it-IT",
                          {
                            year: "numeric",
                            month: "long",
                            day: "2-digit",
                          }
                        )}
                      </time>
                    </span>
                  </span>
                  <span class="">
                    da
                    <span class="font-medium text-base-500 ">
                      {team.data.name}
                    </span>
                  </span>
                  <span class="block">
                    {team.data.role}
                    ·
                    {frontmatter.tags.map((tag) => (
                      <>
                        <a href={`/categorie/${slugifyTag(tag)}/`} class="capitalize ">
                          {tag}
                        </a>
                      </>
                    ))}
                  </span>
                </Text>
              </div>
            )
          }
        </div>

        <div class="flex flex-col mt-12 gap-2">
          <Text tag="p" variant="textXS" class="text-base-500">
            Condividi l'articolo:
          </Text>
          <ShareButtons description={frontmatter.description} />
        </div>

      </div>
    </Wrapper>
  </section>
  <Cta2
    title="Provalo sul tuo prossimo articolo"
    text="Verbalist legge la SERP della tua keyword e consegna un contenuto ottimizzato per SEO e GEO, pronto per il CMS."
  />
  {
    relatedPosts.length > 0 && (
      <section class="border-t border-base-200 border-dashed">
        <Wrapper variant="standard" class="py-12">
          <h2 class="text-display-xs font-normal tracking-[-0.025em] text-base-900">
            Articoli correlati
          </h2>
          <div class="grid mt-8 -mx-4 border-t border-dashed border-base-200 md:grid-cols-2 lg:grid-cols-3 md:[&>*:nth-child(2n+1)]:border-r md:[&>*]:border-dashed lg:[&>*:nth-child(2n+1)]:border-r-0 lg:[&>*:not(:nth-child(3n))]:border-r lg:-mx-12">
            {relatedPosts.slice(0, 3).map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        </Wrapper>
      </section>
    )
  }
  </div>
</BaseLayout>
