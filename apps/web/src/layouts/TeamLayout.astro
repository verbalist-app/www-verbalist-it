---
// Assets
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Frame from "@/components/section/Frame.astro";
import Head from "@/components/section/Head.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import BlogCard from "@/components/blog/BlogCard.astro";
import TeamCard from "@/components/team/TeamCard.astro";
import { getAllTeamMembers } from "@/lib/data";
// Load all posts
import { getCollection } from "astro:content";
// Content
const allPosts = await getCollection("posts");
// Get the team slug from the URL
const teamSlug = Astro.url.pathname.split("/").filter(Boolean).pop();
// Filter posts by this team (based on slug)
const relatedPosts = allPosts
  .filter((post) => post.data.team === teamSlug)
  .map((post) => ({ ...post, slug: post.id }));
const { frontmatter } = Astro.props;
// Le altre persone del team, in ordine alfabetico
const others = (await getAllTeamMembers())
  .filter((m) => m.slug !== teamSlug)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const SITE = "https://www.verbalist.it";
const profileLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: frontmatter.name,
    ...(frontmatter.role ? { jobTitle: frontmatter.role } : {}),
    ...(frontmatter.bio ? { description: frontmatter.bio } : {}),
    ...(frontmatter.image?.url
      ? { image: new URL(frontmatter.image.url, SITE).toString() }
      : {}),
    sameAs: [
      frontmatter.socials?.twitter,
      frontmatter.socials?.linkedin,
      frontmatter.socials?.website,
    ].filter(Boolean),
    worksFor: { "@id": "https://www.verbalist.it/#organization" },
  },
};
---

<BaseLayout
  seo={{
    title: frontmatter.role
      ? `${frontmatter.name}, ${frontmatter.role}`
      : `${frontmatter.name} — team Verbalist`,
    description: frontmatter.seoDescription ?? frontmatter.bio?.slice(0, 157),
  }}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(profileLd)}
  />
  <div class="pt-[72px]">
    <Frame n={1} flush tone="soft" class="pt-12 pb-14 lg:pt-20 lg:pb-20 lg:!px-14">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16 lg:items-start">
        <div>
          <p class="font-mono text-xs tracking-wider uppercase text-base-500"><a href="/team/" class="hover:text-accent-600">Team</a></p>
          <h1 class="mt-6 text-4xl leading-[1.1] font-normal tracking-[-0.025em] text-base-900 lg:text-display lg:leading-[1.08]">
            {frontmatter.name}
          </h1>
          {frontmatter.role && <p class="mt-4 text-lg font-light text-base-600">{frontmatter.role}</p>}
          {
            frontmatter.socials && (
              <div class="flex flex-wrap items-center mt-8 gap-4">
              {frontmatter.socials.twitter && (
                <a href={frontmatter.socials.twitter} class="text-sm text-base-900 border-b border-dashed border-base-400 hover:text-accent-600 hover:border-accent-500" aria-label="X">Twitter</a>
              )}
              {frontmatter.socials.linkedin && (
                <a href={frontmatter.socials.linkedin} class="text-sm text-base-900 border-b border-dashed border-base-400 hover:text-accent-600 hover:border-accent-500" aria-label="LinkedIn">LinkedIn</a>
              )}
              {frontmatter.socials.email && (
                <a href={frontmatter.socials.email} class="text-sm text-base-900 border-b border-dashed border-base-400 hover:text-accent-600 hover:border-accent-500" aria-label="Email">Email</a>
              )}
              {frontmatter.socials.website && (
                <a href={frontmatter.socials.website} class="text-sm text-base-900 border-b border-dashed border-base-400 hover:text-accent-600 hover:border-accent-500" aria-label="Website">Sito</a>
              )}
              </div>
            )
          }
          {
            frontmatter.bio && (
              <div class="max-w-lg mt-10 space-y-3 text-base leading-relaxed text-base-700">
                {frontmatter.bio.split("\n").map((paragraph) => <p>{paragraph}</p>)}
              </div>
            )
          }
        </div>
        <Image
          width={1000}
          height={1000}
          alt={frontmatter.image.alt}
          src={frontmatter.image.url}
          class="object-cover w-full max-w-sm border aspect-square rounded-xl border-base-200 bg-base-100 grayscale lg:justify-self-end"
        />
      </div>
    </Frame>
    {
      relatedPosts.length > 0 && (
        <Frame n={2} class="pt-16 lg:pt-24 lg:!px-14">
          <Head tag="Blog" title={`Gli articoli di ${frontmatter.name}`} />
          <div class="grid mt-10 -mx-4 border-t border-dashed border-base-200 md:grid-cols-2 lg:grid-cols-3 md:[&>*:nth-child(2n+1)]:border-r md:[&>*]:border-dashed lg:[&>*:not(:nth-child(3n))]:border-r lg:[&>*:nth-child(3n)]:border-r-0 lg:-mx-14">
            {relatedPosts.map((post) => <BlogCard post={post} />)}
          </div>
        </Frame>
      )
    }
    <Frame n={relatedPosts.length > 0 ? 3 : 2} class="pt-16 lg:pt-24 lg:!px-14">
      <Head
        tag="Team"
        title={`Chi costruisce Verbalist con ${frontmatter.name.split(" ")[0]}`}
        text="Verbalist nasce in NUR, agenzia di digital marketing fondata a Mantova nel 1999, oggi anche a Milano e Los Angeles. L'agenzia lo usa sui clienti che segue: i casi studio di questo sito sono clienti NUR."
      />
      <div class="grid mt-10 -mx-4 border-t border-dashed border-base-200 md:grid-cols-3 md:[&>*:not(:nth-child(3n))]:border-r md:[&>*]:border-dashed lg:-mx-14">
        {others.map((m) => <TeamCard post={m} level="h3" />)}
      </div>
    </Frame>
  </div>
</BaseLayout>
